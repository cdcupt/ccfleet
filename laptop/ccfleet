def canonical_publish_remote(raw: str) -> str:
    # Convert standard origin spellings to one HTTPS destination. Never echo an
    # invalid origin: it may contain a password, token, or terminal controls.
    match = re.fullmatch(r"(?:https://|ssh://git@)(github\.com|gitlab\.com)/([^:?#@\s]+)"
                         r"|git@(github\.com|gitlab\.com):([^:?#@\s]+)", raw)
    if not match or len(raw) > 512:
        raise CliError("use a GitHub.com or GitLab.com repository URL without credentials")
    host = match[1] or match[3]
    parts = (match[2] or match[4]).removesuffix("/").removesuffix(".git").split("/")
    if (len(parts) < 2 or host == "github.com" and len(parts) != 2
            or any(not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", p) for p in parts)):
        raise CliError("invalid publishing repository path")
    return "https://" + host + "/" + "/".join(parts)


def project_origin(access) -> Optional[str]:
    # Only inspect this checkout's own literal config. Git includes, helpers,
    # rewrites and subprocess commands from the project are never evaluated.
    with access.project_fd() as directory:
        try:
            gitdir = os.open(".git", os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
        except (FileNotFoundError, NotADirectoryError):
            return None
        try:
            fd = os.open("config", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=gitdir)
            with os.fdopen(fd, "rb") as f:
                if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
                    return None
                config = f.read(1024 * 1024 + 1)
        except FileNotFoundError:
            return None
        finally:
            os.close(gitdir)
    if len(config) > 1024 * 1024:
        return None
    for key in ("remote.origin.pushurl", "remote.origin.url"):
        reply = subprocess.run(
            ["/usr/bin/git", "config", "--no-includes", "--file", "-", "--null", "--get-all", key],
            input=config, cwd="/", env={"PATH": "/usr/bin:/bin", "GIT_CONFIG_NOSYSTEM": "1",
                                        "GIT_CONFIG_GLOBAL": "/dev/null", "HOME": "/"},
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5,
        )
        if reply.returncode == 1:
            continue
        values = reply.stdout.split(b"\0")
        if reply.returncode or len(values) != 2 or values[-1]:
            return None
        try:
            return canonical_publish_remote(values[0].decode("utf-8"))
        except (UnicodeError, CliError):
            return None
    return None


def gemini_project_access(args: argparse.Namespace) -> int:
    if args.pair or args.slot or args.test or args.test_folder:
        raise CliError("choose project access separately from pairing, a slot or a test runner")
    project = existing_directory(args.project)
    access = project_files().ProjectAccess(project, home().absolute())
    all_projects = access.is_home()
    if all_projects and args.publish_to:
        raise CliError("set a publishing destination in the checkout that you want to publish")
    if args.revoke_full_access:
        if args.publish_to:
            raise CliError("--publish-to is used with --full-access")
        if all_projects:
            access.disable_all()
            print("All-projects access revoked on this Mac. Separate checkout grants still apply.")
        else:
            access.revoke()
            print("Gemini project access revoked on this Mac.")
        return 0
    remote = None
    if all_projects:
        if access.all_enabled():
            print("All-projects access is already enabled on this Mac.")
            return 0
    else:
        with access.project_fd():
            pass  # Validate the selected directory before offering any grant.
        # An unchanged permission is a no-op, even if the checkout's origin has
        # since changed. Only an explicit local destination can change that pin.
        remote = canonical_publish_remote(args.publish_to) if args.publish_to else None
        if access.enabled() and (remote is None or remote == access.remote()):
            print("Gemini project access is already enabled for this folder.")
            return 0
        if remote is None:
            remote = project_origin(access)
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise CliError("enable Gemini project access in a local interactive terminal")
    if all_projects:
        print("Enable Gemini for development projects you open under your home on this Mac. "
              "It can edit files, run builds and make local commits without approval prompts.")
        print("Open a project directly, or start at ~ and select it with /workspace PATH. "
              "The home directory is for navigation. Each command runs in the selected project.")
        print("Commands run offline. Project content and command output may be sent to Gemini. "
              "Publishing uses a destination separately authorized for that checkout.")
        question = "Type ENABLE to trust projects on this Mac: "
    else:
        print("Gemini can run local project commands, edit files and make Git commits without "
              "asking again in " + ascii(str(project)) + ".")
        print("Commands can read this checkout, including secrets stored in project files. "
              "The shell runs offline. Command output may be sent to Gemini.")
        if remote:
            print("You also authorize pushing branches and opening reviews at " + remote + ".")
        else:
            print("Publishing is off. To enable it, add --publish-to with the repository URL.")
        question = "Type ENABLE to trust this checkout on this Mac: "
    try:
        import termios
        termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
        answer = input(question).strip()
    except EOFError:
        answer = ""
    if answer != "ENABLE":
        print("Project access was not changed.")
        return 1
    if all_projects:
        access.enable_all()
        print("All-projects access saved. Open a project in your Gemini client or use "
              "/workspace PATH from a home session. Revoke from ~ with "
              "ccfleet gemini --revoke-full-access.")
    else:
        access.grant(remote)
        print("Project access saved. Open ccfleet gemini --editor or use its T3 provider in this "
              "folder. Revoke with ccfleet gemini --revoke-full-access.")
    return 0


def cmd_gemini(args: argparse.Namespace) -> int:
    acp = getattr(args, "acp", False)
    runner = getattr(args, "test", None)
    test_folder = getattr(args, "test_folder", None)
    native_check = getattr(args, "native_check", False)
    native = getattr(args, "native", False)
    editor = getattr(args, "editor", False)
    access_command = (getattr(args, "full_access", False)
                      or getattr(args, "revoke_full_access", False))
    # An interactive `ccfleet gemini` now runs the native terminal: the model session lives on
    # the paired slot, and this Mac keeps the project, the shell and every permission decision.
    # `--editor` restores the previous default, where this Mac runs the model and the slot only
    # supplies the workspace tools. A local `--test` runner belongs to that editor session, and
    # T3 Code's `--acp` path is unchanged.
    native = native or not (acp or editor or args.preview or native_check or runner)
    review = getattr(args, "review", False)
    if review and (not native or access_command):
        raise CliError("--review is for the native Gemini terminal")
    if getattr(args, "publish_to", None) is not None and not getattr(args, "full_access", False):
        raise CliError("--publish-to requires --full-access")
    if access_command:
        if sys.platform != "darwin":
            raise CliError("Gemini project access currently requires macOS")
        return gemini_project_access(args)
    if acp and args.pair:
        raise CliError("pair this Mac first with ccfleet pair gemini, then reconnect T3")
    if acp and args.project != ".":
        raise CliError("T3 selects its local project when it opens an ACP session")
    if test_folder is not None:
        if not acp or not runner:
            raise CliError("--test-folder requires --acp and a local --test runner")
        if not test_folder or Path(test_folder).is_absolute() or ".." in Path(test_folder).parts:
            raise CliError("--test-folder must be relative to the local project")
    if not acp and not args.preview and not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise CliError("open an interactive terminal to use Gemini")
    if sys.platform != "darwin":
        raise CliError("the Gemini local editor currently requires macOS")
    if native_check and runner:
        raise CliError("--native-check uses a fixed Git command")
    if args.preview and runner:
        raise CliError("--test is available in an interactive Gemini session")
    if not acp:
        project = selected_project(args.project) if args.preview else existing_directory(args.project)
    with gemini_profile() as root:
        if args.pair or not load_config()["devices"]:
            if native_check and not args.pair:
                raise CliError("Pair this client with ccfleet pair gemini before running --native-check")
            if native and not args.pair:
                raise CliError("Pair this client with ccfleet pair gemini before using the terminal")
            if acp:
                raise CliError("this Mac has no Gemini workspace pairing. In a terminal, run "
                               "ccfleet pair gemini, then reconnect T3")
            pair_gemini(replace=args.pair, name="Antigravity workspace")
