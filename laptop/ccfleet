def cmd_workspace(*, install_only: bool = False) -> int:
    """Install the pinned companion without replacing any pre-existing app."""
    if sys.platform != "darwin":
        raise CliError("CCFleet Workspace requires macOS and Ghostty")
    apps = Path.home() / "Applications"
    apps.mkdir(mode=0o755, exist_ok=True)
    app = apps / "CCFleet Workspace.app"

    def verified(bundle, permitted=(WORKSPACE_EXECUTABLE_HASH,)):
        binary = bundle / "Contents" / "MacOS" / "applet"
        if (bundle.is_symlink() or not binary.is_file() or binary.stat().st_size > 4 * 1024**2
                or hashlib.sha256(binary.read_bytes()).hexdigest() not in permitted):
            raise CliError("the existing Workspace app does not match this release")
        subprocess.run(["/usr/bin/codesign", "--verify", "--strict", "--all-architectures", bundle],
                       check=True, stderr=subprocess.DEVNULL, timeout=20)

    previous = False
    if app.exists() or app.is_symlink():
        verified(app, (WORKSPACE_EXECUTABLE_HASH, PREVIOUS_WORKSPACE_HASH))
        previous = hashlib.sha256((app / "Contents/MacOS/applet").read_bytes()).hexdigest() == PREVIOUS_WORKSPACE_HASH
    if previous or not app.exists():
        with tempfile.TemporaryDirectory(prefix=".ccfleet-workspace-", dir=apps) as raw:
            stage = Path(raw)
            url = ("https://github.com/cdcupt/ccfleet/releases/download/"
                   "workspace-mac-v1.0.1/CCFleet-Workspace.zip")
            for suffix, limit in (("", 4 * 1024**2), (".sig", 8192)):
                subprocess.run(["/usr/bin/curl", "--proto", "=https", "--proto-redir", "=https",
                                "--tlsv1.2", "-fsSL", "--max-time", "45",
                                "--max-filesize", str(limit), "-o", stage / ("app.zip" + suffix),
                                url + suffix], check=True, timeout=50)
            archive = stage / "app.zip"
            if hashlib.sha256(archive.read_bytes()).hexdigest() != WORKSPACE_ARCHIVE_HASH:
                raise CliError("workspace download did not match the signed client")
            signers = stage / "signers"
            signers.write_text("ccfleet-workspace " + RELEASE_PUBLIC_KEY + "\n")
            with archive.open("rb") as incoming:
                subprocess.run(["/usr/bin/ssh-keygen", "-Y", "verify", "-f", signers, "-I",
                                "ccfleet-workspace", "-n", "ccfleet-workspace-mac-v1", "-s",
                                stage / "app.zip.sig"], stdin=incoming, stdout=subprocess.DEVNULL,
                               check=True, timeout=15)
            subprocess.run(["/usr/bin/ditto", "-x", "-k", archive, stage], check=True, timeout=30)
            verified(stage / app.name)
            if previous:
                import ctypes
                verified(app, (PREVIOUS_WORKSPACE_HASH,))
                # Swap complete directories atomically. Stage cleanup removes only the old verified app.
                lib = ctypes.CDLL(None, use_errno=True)
                swap = lib.renamex_np
                swap.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
                swap.restype = ctypes.c_int
                if swap(os.fsencode(stage / app.name), os.fsencode(app), 2) != 0:
                    raise OSError(ctypes.get_errno(), "could not replace the previous Workspace app")
            else:
                try:
                    os.rename(stage / app.name, app)
                except FileExistsError:
                    pass
    verified(app)
    if install_only:
        print("CCFleet Workspace is ready in your Applications folder.")
        return 0
    return subprocess.call(["/usr/bin/open", app])


