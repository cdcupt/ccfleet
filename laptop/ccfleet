def gateway_diagnostic_context(slot: str = "") -> Optional[dict[str, Any]]:
    """Return closed, aggregate facts only; never provider/key/device secrets or paths."""
    if load_gateway() is None:
        return None
    config = load_config()
    route = local_route(config, slot, require_ready=False, check_bridge=False)
    profile = route["gateway"]
    if profile is None:
        return None
    answer = route["answer"]
    entries = answer.get("slots", [])
    eligible = sum(1 for entry in entries if entry.get("ready") is True
                   or entry.get("eligible") is True)
    return {"transport": "gateway", "ready": answer.get("ready") is True,
            "routing": profile["mode"],
            "selected_count": 1 if route["slot_id"] else len(profile["slot_ids"]),
            "eligible_count": eligible}


