    delta = helper.changes(helper.manifest(before), helper.manifest(after))
    if not delta:
        print("No file changes.")
        return
    for change in delta:
        path = change["path"]
        print(f"{change['status']:8} {json.dumps(path, ensure_ascii=True)}")
        if not contents:
            continue
        old = base64.b64decode(before[path]["data"]) if path in before else b""
        new = base64.b64decode(after[path]["data"]) if path in after else b""
        if max(len(old), len(new)) > 128 * 1024:
            print(f"  large file: {len(old)} -> {len(new)} bytes; textual diff omitted")
            continue
        try:
            old_text, new_text = old.decode("utf-8"), new.decode("utf-8")
            if "\0" in old_text or "\0" in new_text:
                raise UnicodeError()
        except UnicodeError:
            print(f"  binary: {len(old)} -> {len(new)} bytes")
            continue
        if max(old_text.count("\n"), new_text.count("\n")) > 2000:
            print("  long text: textual diff omitted; review the slot file before applying")
            continue
        lines = list(difflib.unified_diff(old_text.splitlines(), new_text.splitlines(),
                                         fromfile="local", tofile="slot", lineterm=""))
        for line in lines[:200]:
            print(safe_display(line))
        if len(lines) > 200:
            print("  ... diff truncated; --yes explicitly accepts all listed changes")


def remote_snapshot(helper: Any, answer: dict[str, Any]) -> dict[str, Any]:
    files = helper.validate_snapshot(answer.get("files"))
    if helper.manifest(files) != helper.validate_manifest(answer.get("manifest")):
        raise CliError("slot returned an inconsistent project snapshot")
    return files


def merge_project(helper: Any, base: dict[str, Any], local: dict[str, Any],
                  remote: dict[str, Any]) -> dict[str, Any]:
    baseline = helper.validate_manifest(base)
    ours, theirs = helper.manifest(local), helper.manifest(remote)
    merged = dict(local)
    conflicts = []
    for change in helper.changes(baseline, theirs):
        path = change["path"]
        if ours.get(path) not in (baseline.get(path), theirs.get(path)):
            conflicts.append(path)
        elif path in remote:
            merged[path] = remote[path]
        else:
            merged.pop(path, None)
    if conflicts:
        names = ", ".join(json.dumps(p, ensure_ascii=True) for p in conflicts[:10])
        raise CliError("local and slot edits conflict; nothing was applied: " + names)
    return merged


def validate_project_args(args: argparse.Namespace) -> None:
    if args.remote_project and not PROJECT_RE.fullmatch(args.remote_project):
        raise CliError("--remote-project must be the 32-character ID from ccfleet project list")
    if getattr(args, "print_prompt", None) is not None or getattr(args, "fork_session", False):
        raise CliError("the local-agent relay has been retired; use named slot sessions "
                       "with --new --name NAME, then use Claude's own conversation controls")
    if getattr(args, "model", None) is not None and not MODEL_RE.fullmatch(args.model):
        raise CliError("invalid model name")
    for value in (getattr(args, "name", ""), getattr(args, "resume", "")):
        if value and not SESSION_RE.fullmatch(value):
            raise CliError("remote session names use 1-32 letters, digits, underscores or hyphens")
    if getattr(args, "reconnect_for", 0) < 0:
        raise CliError("--reconnect-for cannot be negative")


def validate_project_listing(answer: dict[str, Any]) -> list[dict[str, Any]]:
    projects = answer.get("projects")
    if not isinstance(projects, list) or len(projects) > 1000:
        raise CliError("invalid project listing")
    seen = set()
    for project in projects:
        if (not isinstance(project, dict) or set(project) != {"project", "sessions"}
                or not isinstance(project["project"], str)
                or not PROJECT_RE.fullmatch(project["project"]) or project["project"] in seen):
            raise CliError("invalid project listing")
        seen.add(project["project"])
        sessions = project["sessions"]
        if not isinstance(sessions, list) or len(sessions) > 1000 or any(
                not isinstance(name, str) or not SESSION_RE.fullmatch(name) for name in sessions):
            raise CliError("invalid project session listing")
    return projects


def cmd_project(args: argparse.Namespace) -> int:
    validate_project_args(args)
    helper = project_files()
    device = choose_device(load_config(), args.slot)
    if args.project_action == "list":
        answer = project_rpc(device, "list")
        for project in validate_project_listing(answer):
            identifier = project.get("project", "")
            if not isinstance(identifier, str) or not PROJECT_RE.fullmatch(identifier):
                raise CliError("invalid project listing")
            sessions = project.get("sessions", [])
            if not isinstance(sessions, list) or any(
                    not isinstance(name, str) or not SESSION_RE.fullmatch(name)
                    for name in sessions):
                raise CliError("invalid project session listing")
            print(f"{identifier}  sessions: {', '.join(sessions) or '(none)'}")
        return 0
    root = selected_project(args.project)
    with project_lock():
        key, record = project_record(device, root, args.remote_project)
        local = helper.snapshot(root)
        if args.project_action == "status":
            label = record["id"] if record["shared"] else "not yet shared"
            print(f"Project ID: {label}\nSelected files: {len(local)}")
            print("Hard exclusions include credentials, VCS metadata, symlinks and build outputs.")
            for change in helper.changes(helper.validate_manifest(record["base"]),
                                         helper.manifest(local)):
                print(f"{change['status']:8} {json.dumps(change['path'], ensure_ascii=True)}")
            return 0
        if args.project_action == "push":
            if not local and not record["shared"]:
                raise CliError("no shareable project files were found")
            print(f"Share {len(local)} selected files with slot {device['slot_name']}.")
            for change in helper.changes(helper.validate_manifest(record["base"]),
                                         helper.manifest(local)):
                print(f"{change['status']:8} {json.dumps(change['path'], ensure_ascii=True)}")
            print("Selected file contents may reach Anthropic. No laptop environment is uploaded.")
            confirm_project("Upload this snapshot?", args.yes)
            # Save the opaque destination before sending so a lost response
            # cannot leave an undiscoverable remote project.
            save_project_record(key, record)
            reply = project_rpc(device, "write", project=record["id"],
                                files=local, expected=record["base"])
            remote = remote_snapshot(helper, reply)
            if helper.manifest(remote) != helper.manifest(local):
                raise CliError("slot did not confirm the uploaded snapshot")
            record.update(base=helper.manifest(remote), shared=True)
            save_project_record(key, record)
            print("Uploaded. Claude and all project tools run on the slot.")
            return 0
        remote = remote_snapshot(helper, project_rpc(device, "read", project=record["id"]))
        merged = merge_project(helper, record["base"], local, remote)
        print_project_changes(helper, local, merged, contents=True)
        if args.project_action == "diff":
            return 0
        if helper.manifest(local) != helper.manifest(merged):
            confirm_project("Apply these slot changes to this local project?", args.yes)
            backup = home() / "project-backups" / record["id"] / secrets.token_hex(8)
            helper.apply_snapshot(root, merged, helper.manifest(local), backup)
            print(f"Applied with recoverable backups in {backup}.")
        record.update(base=helper.manifest(remote), shared=True)
        save_project_record(key, record)
    return 0


def project_sessions(device: dict[str, Any], identifier: str) -> list[str]:
    answer = project_rpc(device, "list")
    for project in validate_project_listing(answer):
        if project.get("project") == identifier:
            sessions = project.get("sessions")
            if not isinstance(sessions, list) or any(
                    not isinstance(name, str) or not SESSION_RE.fullmatch(name)
                    for name in sessions):
                raise CliError("invalid project session listing")
            return sessions
    return []


def attach_project(device: dict[str, Any], identifier: str, session: str,
                   args: argparse.Namespace) -> int:
    action = "new" if args.new_session else "open"
    failed_since: Optional[float] = None
    attempt = 0
    while True:
        command = [*ssh_transport_command(device, tty=True), "ccfleet-project-session-v1",
                   identifier, action, session, args.mode, args.model or "opus",
                   args.effort or "max"]
        started = time.monotonic()
        try:
            code = subprocess.call(command, env=project_environment())
        except KeyboardInterrupt:
            return 130
        if code != 255 or args.no_reconnect:
            return code
        now = time.monotonic()
        if failed_since is None or now - started >= 60:
            failed_since, attempt = now, 0
        if now - failed_since >= args.reconnect_for:
            return code
        delay = min(10, 1 + attempt * 2, args.reconnect_for - (now - failed_since))
        print(f"Connection lost; reattaching to the same slot session in {delay}s...",
              file=sys.stderr)
        time.sleep(delay)
        action, attempt = "open", attempt + 1


def cmd_snapshot(args: argparse.Namespace) -> int:
    args.mode = args.mode or "manual"
    validate_project_args(args)
    helper = project_files()
    device = choose_device(load_config(), args.slot)
    root = selected_project(args.project)
    answer = project_rpc(device, "status")
    require_project_readiness(answer)
    if args.check:
        print("Ready: project connector and slot-native Claude access.\n"
              "No project files, laptop environment, or model request were sent.")
        return 0
    with project_lock():
        key, record = project_record(device, root, args.remote_project)
        local = helper.snapshot(root)
        if not record["shared"]:
            if args.remote_project:
                raise CliError("first review and pull this existing project with "
                               "ccfleet project pull --remote-project ID --project PATH")
            if not local:
                raise CliError("no shareable project files were found")
            print(f"First-time sharing: {len(local)} files with slot {device['slot_name']}.")
            for path in sorted(local):
                print("  " + json.dumps(path, ensure_ascii=True))
            print("Credential/VCS/build files are excluded. "
                  "Selected contents may reach Anthropic.\n"
                  "Claude runs only on the slot. Local files are not automatically overwritten.")
            confirm_project("Share this selected project?", args.yes)
            save_project_record(key, record)
            reply = project_rpc(device, "write", project=record["id"],
                                files=local, expected=record["base"])
            remote = remote_snapshot(helper, reply)
            if helper.manifest(remote) != helper.manifest(local):
                raise CliError("slot did not confirm the uploaded snapshot")
            record.update(base=helper.manifest(remote), shared=True)
            save_project_record(key, record)
        elif helper.manifest(local) != helper.validate_manifest(record["base"]):
            if args.resume is None and not args.continue_session:
                raise CliError("local files changed; run ccfleet project push first, "
                               "or use --resume to continue the existing slot workspace")
            print("Local changes are not uploaded; continuing the existing slot workspace.",
                  file=sys.stderr)
        session = args.name or record.get("last_session", "main")
        if args.resume is not None:
            available = project_sessions(device, record["id"])
            if args.resume:
                if args.resume not in available:
                    raise CliError("that project session is not running; use --new --name NAME")
                session = args.resume
            else:
                if not available:
                    raise CliError("no running project sessions; use --new --name NAME")
                for number, name in enumerate(available, 1):
                    print(f"{number}. {name}")
                if not sys.stdin.isatty():
                    raise CliError("choose a session explicitly with --resume NAME")
                selection = input("Session number: ").strip()
                if not selection.isdigit() or not 1 <= int(selection) <= len(available):
                    raise CliError("invalid session selection")
                session = available[int(selection) - 1]
        elif args.new_session and not args.name:
            session = "s-" + secrets.token_hex(4)
        if not isinstance(session, str) or not SESSION_RE.fullmatch(session):
            raise CliError("invalid saved project session")
        record["last_session"] = session
        save_project_record(key, record)
    print(f"Slot project: {record['id']} / session {session}\n"
          "Claude, shell commands and model connections run on the slot.\n"
          "After work: ccfleet project diff, then ccfleet project pull to review/apply changes.",
          file=sys.stderr)
    return attach_project(device, record["id"], session, args)


def live_control(device: dict[str, Any], project: str, action: str = "status", *,
                 _timeout: float = 30) -> dict[str, Any]:
    if not PROJECT_RE.fullmatch(project) or action not in {"status", "stop"}:
        raise CliError("invalid live-folder control")
    command = [*ssh_transport_command(device, tty=False), f"ccfleet-live-{action}-v1", project]
    try:
        result = subprocess.run(command, input=b"", capture_output=True,
                                env=project_environment(), timeout=_timeout)
        import io
        answer = live_client().read_frame(io.BytesIO(result.stdout))
    except (OSError, EOFError, ValueError, subprocess.SubprocessError) as exc:
        raise CliError("live folder connection is unavailable; check pairing and the node upgrade",
                       code="connection") from exc
    if result.returncode != 0 or answer.get("ok") is not True or answer.get("version") != 1:
        error = answer.get("error")
        messages = {"disabled": "live folder access is not enabled on this slot",
                    "account_unavailable": "slot sign-in is unavailable; use your slot page",
                    "stale": "an old folder link needs --reset-link before it can restart",
                    "busy": "the folder link is busy; retry after it stops"}
        raise CliError(messages.get(error, "live folder operation failed safely"),
                       code=error if isinstance(error, str) else "invalid")
    return answer


def live_directory(identifier: str) -> Path:
    if not PROJECT_RE.fullmatch(identifier):
        raise CliError("invalid local live-folder identifier")
    return home() / "live" / identifier


def live_protected(root: Path, *modules: Any) -> list[Path]:
    """Control credentials/code stay outside the remote filesystem authority."""
    result = [home(), Path(__file__), Path(sys.executable),
              Path(sys.prefix), Path(sys.base_prefix)]
    for module in modules:
        result.append(Path(module.__file__))
    for device in load_config()["devices"].values():
        if not isinstance(device, dict):
            raise CliError("invalid saved pairing")
        for field in ("key", "known_hosts"):
            value = device.get(field)
            if not isinstance(value, str) or not value:
                raise CliError("invalid saved pairing paths")
            result.append(Path(value))
    protected = []
    for path in result:
        for candidate in (Path(os.path.abspath(path)), path.resolve()):
            if candidate == root or root.is_relative_to(candidate):
                raise CliError("CC Fleet's own control directory cannot be shared")
            if candidate.is_relative_to(root):
                protected.append(candidate)
    return protected


def live_record(device: dict[str, Any], root: Path) -> tuple[str, dict[str, Any]]:
    key = hashlib.sha256((device["device_id"] + "\0" + str(root)).encode()).hexdigest()
    records = load_config().get("live_folders", {})
    if not isinstance(records, dict):
        raise CliError("invalid live-folder configuration")
    record = records.get(key)
    if record is None:
        record = {"id": secrets.token_hex(16), "root": str(root),
                  "device": device["device_id"], "trusted": False, "last_session": "main"}
    if (not isinstance(record, dict) or not PROJECT_RE.fullmatch(str(record.get("id", "")))
            or record.get("root") != str(root) or record.get("device") != device["device_id"]):
        raise CliError("invalid live-folder record")
    return key, dict(record)


def save_live_record(key: str, record: dict[str, Any]) -> None:
    config = load_config()
    config.setdefault("live_folders", {})[key] = record
    save_config(config)


def stop_local_connector(identifier: str) -> None:
    helper = live_client()
    directory = live_directory(identifier)
    try:
        helper.control(directory, "stop")
    except helper.ControlError:
        # The controller can close while the resident is still tearing down.
        # Neither EOF nor a timeout proves that filesystem access has ended.
        pass
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        if helper.stopped(directory):
            return
        time.sleep(0.2)
    raise CliError("could not confirm the old local folder connector stopped; "
                   "migration is incomplete. Wait a moment and rerun setup")


def cmd_live_serve(args: argparse.Namespace) -> int:
    records = load_config().get("live_folders", {})
    record = next((value for value in records.values()
                   if isinstance(value, dict) and value.get("id") == args.project_id), None)
    if not record or record.get("trusted") is not True:
        raise CliError("folder sharing has not been approved")
    device = choose_device(load_config(), record["device"])
    root = Path(record["root"]).resolve(strict=True)
    if not root.is_dir():
        raise CliError("shared folder is unavailable")
    files, connector = live_files(), live_client()
    instance = secrets.token_hex(16)
    server = files.SFTPServer(root, protected=live_protected(root, files, connector))
    command = [*ssh_transport_command(device, tty=False), "ccfleet-live-v1",
               record["id"], instance]

    def paired() -> bool:
        try:
            return load_config()["devices"].get(device["device_id"]) == device
        except (CliError, OSError):
            return False

    return connector.run(live_directory(record["id"]), instance, server,
                         lambda: subprocess.Popen(command, stdin=subprocess.PIPE,
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             env=project_environment()), check_pairing=paired)


def start_local_connector(identifier: str) -> None:
    helper = live_client()
    directory = live_directory(identifier)
    existing = helper.control(directory, "status")
    child = None
    if not existing:
        child = subprocess.Popen([sys.executable, "-I", str(Path(__file__).resolve()),
                                  "live-serve", "--project-id", identifier],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True,
                                 env=project_environment())
    deadline = time.monotonic() + 60
    while time.monotonic() < deadline:
        state = helper.control(directory, "status")
        if state.get("connected") is True:
            return
        if state.get("error") in {
                "stale", "protocol", "disabled", "account_unavailable", "unavailable"}:
            break
        if child is not None and child.poll() is not None:
            break
        time.sleep(0.25)
    raise CliError("the live folder is not connected. Check your slot/network; "
                   "after a connector crash use --reset-link to end its old slot sessions "
                   "and reconnect. No snapshot fallback was used")


def cmd_live(args: argparse.Namespace) -> int:
    args.mode = args.mode or "bypassPermissions"
    validate_project_args(args)
    if args.remote_project:
        raise CliError("live folders belong to the computer serving them; use snapshot/project "
                       "commands to recover an older remote snapshot")
    device = choose_device(load_config(), args.slot)
    if args.check:
        answer = live_control(device, "0" * 32)
        if answer.get("ready") is not True:
            raise CliError("slot live-filesystem dependencies are not ready")
        print("Ready: live folder access with Claude running on the slot.\n"
              "No local folder was scanned, shared, or mounted; no model request was made.")
        return 0
    root = Path(args.project).expanduser().resolve(strict=not args.disconnect)
    if not args.disconnect and not root.is_dir():
        raise CliError("--project must be an existing directory")
    files, connector = live_files(), live_client()
    live_protected(root, files, connector)
    with project_lock():
        key, record = live_record(device, root)
        identifier = record["id"]
        if args.disconnect or args.reset_link:
            if args.reset_link:
                print("Reset ends this folder's running slot sessions and invalidates open files.")
                confirm_project("Reset this folder link?", args.yes)
            stop_local_connector(identifier)
            live_control(device, identifier, "stop")
            if args.disconnect:
                print("Folder access stopped; its slot sessions ended. "
                      "Local files were not deleted.")
                return 0
        ready = live_control(device, identifier)
        if ready.get("ready") is not True:
            raise CliError("live folder access is not ready on the slot")
        if record.get("trusted") is not True:
            print("Live folder: " + json.dumps(str(root), ensure_ascii=True))
            print("This grants the slot read/write access to files in this folder on demand.\n"
                  "Edits and deletions take effect locally immediately; there is no push/pull.\n"
                  "Hidden files and Git-ignored files are available too. Shared files may contain\n"
                  "credentials or identifying information; relevant content may reach Anthropic.\n"
                  "Slot administrators can inspect this access. CC Fleet's own keys and code\n"
                  "remain protected. Claude runs on the slot, using its Linux tools.\n"
                  "Access stays active after this terminal closes. Stop it with:\n"
                  "  ccfleet claude --disconnect --project " + shlex.quote(str(root)))
            if args.mode == "bypassPermissions":
                print("Bypass-permissions mode lets tools change/delete files without prompts.")
            confirm_project("Trust this folder for live read/write access?", args.yes)
            record["trusted"] = True
            save_live_record(key, record)
        start_local_connector(identifier)
        deadline = time.monotonic() + 15
        while True:
            state = live_control(device, identifier)
            if state.get("mounted") is True and state.get("connected") is True:
                break
            if time.monotonic() >= deadline:
                raise CliError("folder mount did not become ready; no Claude session was started")
            time.sleep(0.25)
        session = args.name or record.get("last_session", "main")
        if args.resume is not None:
            available = state.get("sessions", [])
            if not isinstance(available, list) or any(
                    not isinstance(name, str) or not SESSION_RE.fullmatch(name)
                    for name in available):
                raise CliError("invalid live session listing")
            if args.resume:
                if args.resume not in available:
                    raise CliError("that live session is not running; use --new --name NAME")
                session = args.resume
            else:
                if not available:
                    raise CliError("no running live sessions; use --new --name NAME")
                for number, name in enumerate(available, 1):
                    print(f"{number}. {name}")
                if not sys.stdin.isatty():
                    raise CliError("choose a session explicitly with --resume NAME")
                choice = input("Session number: ").strip()
                if not choice.isdigit() or not 1 <= int(choice) <= len(available):
                    raise CliError("invalid session selection")
                session = available[int(choice) - 1]
        elif args.new_session and not args.name:
            session = "s-" + secrets.token_hex(4)
        if not isinstance(session, str) or not SESSION_RE.fullmatch(session):
            raise CliError("invalid saved live session")
        record["last_session"] = session
        save_live_record(key, record)
    print("Live folder connected. Files stay on this computer; Claude and tools run on the slot.\n"
          "Local edits are visible remotely and slot edits write through immediately.\n"
          "Closing this terminal leaves access active; use ccfleet claude --disconnect to stop.",
          file=sys.stderr)
    action = "new" if args.new_session else "open"
    failed_since: Optional[float] = None
    attempt = 0
    while True:
        command = [*ssh_transport_command(device, tty=True), "ccfleet-live-session-v1",
                   identifier, action, session, args.mode,
                   args.model or "opus", args.effort or "max"]
        started = time.monotonic()
        code = subprocess.call(command, env=project_environment())
        if code != 255 or args.no_reconnect:
            return code
        now = time.monotonic()
        if failed_since is None or now - started >= 60:
            failed_since, attempt = now, 0
        if now - failed_since >= args.reconnect_for:
            return code
        print("Connection interrupted; reattaching to the same live session...", file=sys.stderr)
        time.sleep(min(10, 1 + attempt * 2, args.reconnect_for - (now - failed_since)))
        action, attempt = "open", attempt + 1


def installed_agent(name: str) -> Optional[str]:
    candidate = shutil.which(name)
    if candidate is None:
        fallback = Path.home() / ".local/bin" / name
        if fallback.is_file() and os.access(fallback, os.X_OK):
            candidate = str(fallback)
    return candidate


def find_local_claude() -> str:
    binary = installed_agent("claude")
    if not binary:
        raise CliError("Claude Code is missing; ccfleet claude installs it on launch")
    return binary


def _claude_update_prompt(extra):
    flags = extra[:extra.index("--")] if "--" in extra else extra
    return not any(arg.split("=", 1)[0] in {"-p", "--print", "--input-format",
                                            "--output-format", "--sdk-url"} for arg in flags)


def prepare_agent(name: str, *, slot_command=None, find=None, prompt_updates=True) -> str:
    return client_experience().prepare_agent(name, home(), find or (lambda: installed_agent(name)),
                                             slot_command=slot_command, prompt_updates=prompt_updates)


def inference_command(device: dict[str, Any]) -> list[str]:
    return [*ssh_transport_command(device, tty=False), "ccfleet-inference-v1"]


def check_inference(device: dict[str, Any], *, timeout: float = 25) -> None:
    helper = inference_client()
    try:
        answer = helper.check_status(lambda: inference_command(device), project_environment,
                                     timeout=timeout)
    except helper.RelayError as exc:
        messages = {401: "your slot's Claude sign-in needs renewal; use your slot page",
                    403: "the local Claude relay is not enabled on your slot",
                    409: "slot account transition is pending; retry after it completes"}
        raise CliError(messages.get(exc.status, "could not reach the slot relay; "
                                    "check your connection and pairing"), exc.status,
                       code="connection" if exc.status is None else "relay") from exc
    if (answer.get("ready") is not True or type(answer.get("protocol")) is not int
            or answer["protocol"] != 2):
        raise CliError("the slot relay uses an unsupported protocol")


def confirm_legacy_retirement(yes: bool) -> None:
    if yes:
        return
    message = ("Switching to local Claude ends this computer's old live-folder connections "
               "and their remote Claude sessions. Files and conversation history are kept; "
               "ordinary remote-terminal sessions are not stopped. Continue? [y/N] ")
    try:
        # curl|bash occupies stdin. Read only an actual controlling terminal.
        # Buffered r+ text files require seek(), which a terminal does not
        # support. Use the raw read/write TTY without consuming installer stdin.
        with open("/dev/tty", "r+b", buffering=0) as terminal:
            if not terminal.isatty():
                raise OSError("not a terminal")
            terminal.write(message.encode("utf-8"))
            answer = terminal.readline(64).strip().lower()
    except OSError as exc:
        raise CliError("old live-folder access is still active; finish it and run "
                       "ccfleet claude --disconnect, or explicitly pass --yes to migrate") from exc
    if answer not in (b"y", b"yes"):
        raise CliError("migration cancelled; existing sessions and files were left unchanged")


def retire_live_grants(device: dict[str, Any], *, yes: bool) -> None:
    with project_lock():
        records = load_config().get("live_folders", {})
        if not isinstance(records, dict):
            raise CliError("invalid saved legacy folder configuration")
        matching = [(key, item) for key, item in records.items() if isinstance(item, dict)
                    and item.get("device") == device["device_id"]
                    and item.get("retired") is not True]
        if not matching:
            return
        print("Checking previous live-folder connections before migration...",
              file=sys.stderr, flush=True)
        active = False
        for _key, record in matching:
            identifier = record.get("id")
            if not isinstance(identifier, str) or not PROJECT_RE.fullmatch(identifier):
                raise CliError("invalid saved legacy workspace; no new Claude session was started")
            local = live_client().control(live_directory(identifier), "status")
            remote = live_control(device, identifier)
            if local or remote.get("mounted") or remote.get("connected") or remote.get("sessions"):
                active = True
        if active:
            confirm_legacy_retirement(yes)
        # Do not silently leave a second, broader filesystem access path running.
        for key, record in matching:
            identifier = record["id"]
            stop_local_connector(identifier)
            answer = live_control(device, identifier, "stop")
            if answer.get("stopped") is not True:
                raise CliError("legacy folder cleanup is incomplete; no local Claude was started")
            after = live_control(device, identifier)
            if (live_client().control(live_directory(identifier), "status")
                    or after.get("mounted") or after.get("connected") or after.get("sessions")):
                raise CliError("legacy folder access is still active; migration stopped safely")
            config = load_config()
            saved = config.get("live_folders", {}).get(key)
            if not isinstance(saved, dict) or saved.get("id") != identifier:
                raise CliError("legacy folder configuration changed during migration")
            saved["retired"] = True
            save_config(config)
    print("Old live-folder access stopped. Local files and histories were preserved.",
          file=sys.stderr, flush=True)


def native_extra_args(args: argparse.Namespace) -> list[str]:
    extra = list(getattr(args, "claude_args", []))
    if extra[:1] == ["--"]:
        extra.pop(0)
    forbidden = {"--cloud", "--teleport", "--remote-control", "--environment",
                 "--client-data-url", "--settings"}
    for value in extra:
        if value == "--":
            break
        if value.split("=", 1)[0] in {"--bg", "--background"}:
            raise CliError("native background agents outlive this command's relay; "
                           "use ccfleet jobs start --prompt for a supervised local job")
        if value.split("=", 1)[0] in forbidden:
            raise CliError("this native option replaces CC Fleet's selected-slot route; "
                           "use ordinary Claude directly for a separate service/configuration")
    return extra


def native_settings(env: dict[str, str], base_url: str, secret: str, *,
                    bare: bool, slot_id: str = "") -> dict[str, Any]:
    # Process environment alone loses to saved settings.env in native Claude.
    # The last explicit settings file pins only routing/privacy, leaving tools,
    # permissions, project customizations and native history under user control.
    pinned = {"ANTHROPIC_BASE_URL": canonical_runtime_url(base_url),
              "ANTHROPIC_AUTH_TOKEN": "" if bare else secret,
              "ANTHROPIC_API_KEY": secret if bare else "",
              "CLAUDE_CODE_OAUTH_TOKEN": "",
              "ANTHROPIC_CUSTOM_HEADERS": "X-CCFleet-Slot: " + slot_id if slot_id else "",
              "CLAUDE_CODE_USE_BEDROCK": "0", "CLAUDE_CODE_USE_VERTEX": "0",
              "CLAUDE_CODE_USE_FOUNDRY": "0", "CLAUDE_CODE_USE_ANTHROPIC_AWS": "0",
              "CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD": "0", "CLAUDE_CODE_USE_MANTLE": "0",
              "CLAUDE_CODE_USE_GATEWAY": "0", "CLAUDE_CODE_CLIENT_DATA_URL": "",
              "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
              "DISABLE_TELEMETRY": "1", "DISABLE_ERROR_REPORTING": "1",
              "DISABLE_BUG_COMMAND": "1", "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
              "DISABLE_AUTOUPDATER": "1"}
    env.update(pinned)
    for key in ("ANTHROPIC_MODEL", "CLAUDE_CODE_EFFORT_LEVEL"):
        env.pop(key, None)
    fallback = env.get("no_proxy") or env.get("NO_PROXY", "")
    for name in ("NO_PROXY", "no_proxy"):
        items = [part.strip() for part in (env.get(name) or fallback).split(",") if part.strip()]
        env[name] = ",".join(dict.fromkeys([*items, "127.0.0.1", "localhost"]))
        pinned[name] = env[name]
    return {"env": pinned, "apiKeyHelper": ""}


def openrouter_auth(base: str):
    """An environment override is ephemeral. Remember only a verified, interactively entered key."""
    token = os.environ.get("CCFLEET_OPENROUTER_TOKEN", "")
    saved = None if token else read_private_profile("openrouter.json")
    if saved is not None:
        token = saved.get("token")

    def catalog_for(value):
        if not isinstance(value, str) or not re.fullmatch(r"ccf_or_[A-Za-z0-9_-]{43}", value):
            raise CliError("enter a Fleet OpenRouter key from your CC Fleet account")
        return api_json(base + "/v1/models", value, method="GET")

    if token or saved is not None:
        try:
            return token, catalog_for(token), False
        except CliError as exc:
            if saved is None or exc.status != 401:
                raise
            print("The saved Fleet key was rejected. Enter a current key to replace it.",
                  file=sys.stderr)
    if not sys.stdin.isatty():
        raise CliError("run ccfleet openrouter --check in a terminal to save your Fleet key, "
                       "or set CCFLEET_OPENROUTER_TOKEN for this process")
    token = getpass.getpass("Fleet key from https://ccfleet.io/account/openrouter: ")
    return token, catalog_for(token), True


def cmd_openrouter(args: argparse.Namespace) -> int:
    """Launch native Claude against the account-funded Fleet endpoint, without a slot."""
    if args.forget_key:
        with contextlib.suppress(FileNotFoundError), credential_directory() as directory:
            os.unlink("openrouter.json", dir_fd=directory)
        print("Cleared the saved Fleet OpenRouter key on this computer.")
        return 0
    check_managed_route()
    extra = native_extra_args(args)
    base = DEFAULT_SERVER + "/openrouter"
    token, catalog, remember = openrouter_auth(base)
    rows = catalog.get("data")
    covered = catalog.get("fleet_billing") == "admin_covered"
    price = "OpenRouter · Fleet $0" if covered else "OpenRouter + 5%"
    pattern = r"[A-Za-z0-9~][A-Za-z0-9_.~-]{0,63}/[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}"
    if (not isinstance(rows, list) or not 1 <= len(rows) <= 64
            or any(not isinstance(row, dict) or not isinstance(row.get("id"), str)
                   or not re.fullmatch(pattern, row["id"]) for row in rows)):
        raise CliError("invalid OpenRouter catalog from Fleet")
    if remember:
        write_private_profile("openrouter.json", {"token": token})
        print("Saved your Fleet key for future OpenRouter sessions on this computer.", file=sys.stderr)
    images = args.command == "openrouter-images"
    if images:
        rows = [row for row in rows if isinstance(row.get("input_modalities"), list)
                and "image" in row["input_modalities"]]
        if not rows:
            raise CliError("This Fleet gateway offers no image-enabled models. "
                           "Use ccfleet openrouter for text.")
    models = [row["id"] for row in rows]
    recent = [row["id"] for row in rows if row.get("fleet_recent") is True]
    model = args.model or models[0]
    if model not in models:
        raise CliError("choose an offered OpenRouter model for this input mode: " + ", ".join(models))
    if args.check:
        print("Default: " + models[0])
        if recent:
            print("Recently used: " + ", ".join(recent))
        print("Available (" + price + "): " + ", ".join(models))
        return 0
    claude = prepare_agent("claude", prompt_updates=_claude_update_prompt(extra))
    ensure_home()
    env = dict(os.environ)
    env.pop("CCFLEET_OPENROUTER_TOKEN", None)
    saved_mode = native_proxy_exclusions(env, Path.cwd(), extra)
    settings = native_settings(env, base, token, bare="--bare" in extra)
    native_options = extra[:extra.index("--")] if "--" in extra else extra
    flags = {arg.split("=", 1)[0] for arg in native_options}
    mode_args = []
    if not flags.intersection({"--permission-mode", "--dangerously-skip-permissions"}):
        if args.mode is not None:
            mode_args = ["--permission-mode", args.mode]
        elif not saved_mode and not flags.intersection(
                {"--resume", "-r", "--continue", "-c", "--restricted", "--safe-mode"}
        ):
            settings["permissions"] = {"defaultMode": "bypassPermissions"}
    launch_env = {name: model for name in ("ANTHROPIC_MODEL", "ANTHROPIC_DEFAULT_OPUS_MODEL",
            "ANTHROPIC_DEFAULT_SONNET_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL",
            "ANTHROPIC_DEFAULT_FABLE_MODEL", "ANTHROPIC_SMALL_FAST_MODEL")}
    if images:
        launch_env["ANTHROPIC_CUSTOM_HEADERS"] = "X-CCFleet-Input: images"
        print("Image input enabled, including images in resumed conversation history.", file=sys.stderr)
    else:
        # Absolute gitignore-style rules cover Read calls outside the project too.
        extensions = ("png", "jpg", "jpeg", "gif", "webp", "bmp", "heic", "heif",
                      "tif", "tiff", "avif", "pdf")
        patterns = ["".join(f"[{c}{c.upper()}]" for c in ext) for ext in extensions]
        settings.setdefault("permissions", {})["deny"] = [f"Read(//**/*.{p})" for p in patterns]
        if "--append-system-prompt" not in flags:
            mode_args += ["--append-system-prompt", "Use text tool results on this route. "
                          "Skip image reads and screenshots. Use logs, DOM text or accessibility "
                          "snapshots; ask the user if visual inspection is needed."]
        print("Text-only session. Use ccfleet openrouter-images to enable images.", file=sys.stderr)
    # These two offered DeepSeek models share the same OpenRouter context length.
    # A session-wide override is valid only while every model in its picker matches.
    if set(models) <= {"deepseek/deepseek-v4.1-flash", "deepseek/deepseek-v4-pro"}:
        launch_env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = env.get("CLAUDE_CODE_MAX_CONTEXT_TOKENS", "1048576")
    settings["env"].update(launch_env)
    env.update(launch_env)
    settings["modelPicker"] = {"replaceBuiltInOptions": True, "options": [
        {"model": m, "label": m + (" · Recent" if m in recent else "") + " · " + price}
        for m in models]}
    print("Fleet covers this admin account’s OpenRouter usage." if covered else
          "OpenRouter usage is charged to your Fleet balance at cost + 5%.", file=sys.stderr)
    with tempfile.NamedTemporaryFile(dir=home(), mode="w", suffix=".json") as options:
        json.dump(settings, options)
        options.flush()
        return subprocess.call([claude, "--settings", options.name, "--model", model, *mode_args, *extra],
                               env=env)


def add_api_models(settings: dict[str, Any], route: dict[str, Any]) -> None:
    models = route.get("answer", {}).get("api_models", [])
    if not models:
        return
    names = {"fleet-gpt": "GPT", "fleet-gemini": "Gemini"}
    if (not isinstance(models, list) or len(models) > len(names)
            or any(not isinstance(row, dict) or not isinstance(row.get("id"), str)
                   or row["id"] not in names for row in models)
            or len({row["id"] for row in models}) != len(models)):
        raise CliError("gateway returned an invalid API model catalog")
    base = "Devin" if route["provider"] == "devin" else "Claude"
    options = [{"model": "opus", "label": base + " · subscription"}]
    options.extend({"model": row["id"], "label": names[row["id"]] + " · API"}
                   for row in models)
    settings["modelPicker"] = {"replaceBuiltInOptions": True, "options": options}


def native_proxy_exclusions(env: dict[str, str], project: Path, extra: list[str]) -> bool:
    """Preserve proxy exclusions and report whether loaded settings select a permission mode."""
    saved_mode = False
    sources = {"user", "project", "local"}
    extra = extra[:extra.index("--")] if "--" in extra else extra
    if "--bare" in extra:
        sources = set()
    for index, value in enumerate(extra):
        if value == "--":
            break
        if value == "--setting-sources" and index + 1 < len(extra):
            sources = set(extra[index + 1].split(","))
        elif value.startswith("--setting-sources="):
            sources = set(value.split("=", 1)[1].split(","))
    config = Path(env.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser()
    if not config.is_absolute():
        config = project / config
    files = (("user", config / "settings.json"),
             ("project", project / ".claude/settings.json"),
             ("local", project / ".claude/settings.local.json"))
    for source, path in files:
        if source not in sources:
            continue
        try:
            descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except FileNotFoundError:
            continue
        try:
            with os.fdopen(descriptor, "rb") as stream:
                if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                    raise ValueError("nonregular settings")
                raw = stream.read(1024 * 1024 + 1)
            if len(raw) > 1024 * 1024:
                raise ValueError("oversized settings")
            value = json.loads(raw)
            permissions = value.get("permissions")
            if isinstance(permissions, dict) and (permissions.get("defaultMode")
                    or permissions.get("disableBypassPermissionsMode") == "disable"):
                saved_mode = True
            overrides = value.get("env", {})
            if not isinstance(overrides, dict):
                raise ValueError("invalid settings")
            for name in ("NO_PROXY", "no_proxy"):
                if name in overrides:
                    if not isinstance(overrides[name], str) or "\0" in overrides[name]:
                        raise ValueError("invalid proxy exclusion")
                    env[name] = overrides[name]
        except (OSError, ValueError, AttributeError) as exc:
            raise CliError("could not safely preserve native proxy exclusions; "
                           "check your Claude settings files") from exc
    return saved_mode


def check_managed_route(paths: Optional[list[Path]] = None) -> None:
    if os.environ.get("CLAUDE_CODE_CLIENT_DATA_URL"):
        raise CliError("a managed client configuration selects another route; "
                       "ask its administrator before using CC Fleet")
    if paths is None:
        paths = ([Path("/Library/Application Support/ClaudeCode/managed-settings.json")]
                 if sys.platform == "darwin" else [Path("/etc/claude-code/managed-settings.json")])
        dropins = paths[0].parent / "managed-settings.d"
        if dropins.exists():
            if dropins.is_symlink() or not dropins.is_dir():
                raise CliError("managed Claude settings cannot be safely verified")
            entries = list(dropins.iterdir())
            if len(entries) > 100:
                raise CliError("too many managed policy files to safely verify")
            paths.extend(sorted(path for path in entries if path.suffix == ".json"))
        if sys.platform == "darwin":
            import pwd
            preferences = Path("/Library/Managed Preferences")
            user = pwd.getpwuid(os.getuid()).pw_name
            for folder in (preferences, preferences / user):
                if (folder / "com.anthropic.claudecode.plist").exists():
                    raise CliError("managed macOS Claude preferences need administrator "
                                   "routing review before using CC Fleet")
    reserved = {"ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_API_KEY",
                "CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_CODE_CLIENT_DATA_URL",
                "ANTHROPIC_CUSTOM_HEADERS",
                "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "http_proxy", "https_proxy",
                "all_proxy", "NO_PROXY", "no_proxy"}
    for path in paths:
        if not path.exists():
            continue
        try:
            descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(descriptor, "rb") as stream:
                if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                    raise ValueError("nonregular policy")
                raw = stream.read(1024 * 1024 + 1)
            if len(raw) > 1024 * 1024:
                raise ValueError("oversized policy")
            value = json.loads(raw)
            settings_env = value.get("env", {})
            if not isinstance(settings_env, dict):
                raise ValueError("invalid policy")
            if (value.get("apiKeyHelper") or reserved.intersection(settings_env)
                    or any(key.startswith("CLAUDE_CODE_USE_") and value not in ("0", "", False)
                           for key, value in settings_env.items())):
                raise CliError("managed Claude settings select authentication/routing; "
                               "CC Fleet will not override that policy")
        except (OSError, ValueError, AttributeError) as exc:
            raise CliError("could not safely verify managed Claude routing settings") from exc


def local_claude_command(claude: str, args: argparse.Namespace,
                         settings_path: Path, extra: list[str]) -> list[str]:
    options = extra[:extra.index("--")] if "--" in extra else extra
    supplied = {value.split("=", 1)[0] for value in options}
    resuming = (args.resume is not None or args.continue_session
                or bool(supplied.intersection({"--resume", "-r", "--continue", "-c"})))
    command = [claude]
    for flag, value, default in (("--model", args.model, "opus"),
                                 ("--effort", args.effort, "max")):
        if flag not in supplied and (value is not None or not resuming):
            command.extend([flag, value if value is not None else default])
    if (not supplied.intersection({"--permission-mode", "--dangerously-skip-permissions"})
            and (args.mode is not None or not resuming)):
        mode = args.mode or "bypassPermissions"
        command.extend(["--dangerously-skip-permissions"] if mode == "bypassPermissions"
                       else ["--permission-mode", mode])
    if args.resume is not None:
        command.append("--resume=" + args.resume if args.resume else "--resume")
    elif args.continue_session:
        command.append("--continue")
    if args.fork_session:
        command.append("--fork-session")
    if args.name:
        command.append("--name=" + args.name)
    split = extra.index("--") if "--" in extra else len(extra)
    command += extra[:split] + ["--settings", str(settings_path)] + extra[split:]
    if args.print_prompt is not None and not getattr(args, "_background_job", False):
        command.extend(["--print", "--", args.print_prompt])
    elif getattr(args, "_background_job", False):
        command.append("--print")
    return command


def cmd_local(args: argparse.Namespace) -> int:
    if getattr(args, "background", False):
        if args.print_prompt is None:
            raise CliError("background work needs --print PROMPT; use ccfleet jobs start --prompt")
        return start_local_job(args, args.print_prompt)
    if args.disconnect:
        return cmd_live(args)
    if args.reset_link or args.remote_project:
        raise CliError("live mounts are retired; use --disconnect to close old access, "
                       "then run ccfleet claude for the local Claude CLI")
    if args.fork_session and args.resume is None and not args.continue_session:
        raise CliError("--fork-session needs --resume or --continue")
    for label, value in (("session name", args.name), ("resume value", args.resume)):
        if value is not None and (len(value) > 256 or any(
                ord(c) < 32 or ord(c) == 127 for c in value)):
            raise CliError(f"{label} must be at most 256 characters without control characters")
    if args.model is not None and not MODEL_RE.fullmatch(args.model):
        raise CliError("invalid model name")
    extra = native_extra_args(args)
    options = extra[:extra.index("--")] if "--" in extra else extra
    if args.print_prompt is not None and "--" in extra:
        raise CliError("use --print or a native positional prompt, not both")
    check_managed_route()
    config = load_config()
    transport_mode = getattr(args, "transport", "auto")
    selected_slot = args.slot
    background_job = getattr(args, "_background_job", False)
    if background_job:
        selected_slot = choose_device(config, args.slot)["slot_id"]
        if transport_mode == "auto" and load_gateway() is not None:
            # A supervised job cannot change transports after its admission check.
            transport_mode = "gateway"
    if getattr(args, "reuse_transport", False) and transport_mode != "bridge":
        if load_gateway() is not None:
            raise CliError("--reuse-transport is only for --transport bridge")
    print("Checking the selected model route...", file=sys.stderr, flush=True)
    route = local_route(config, selected_slot, transport_mode, canonical=background_job)
    device, gateway = route["device"], route["gateway"]
    gateway_slot, migration_device = route["slot_id"], route["migration_device"]
    print_local_route(route)
    if args.check:
        find_local_claude()
        print("Ready: original local Claude Code and selected model route.\n"
              "No project was scanned and no model request or Claude session was started.")
        return 0
    project = Path(args.project).expanduser().resolve(strict=True)
    if not project.is_dir():
        raise CliError("--project must be an existing local directory")
    resuming = (args.resume is not None or args.continue_session or any(
        value.split("=", 1)[0] in {"--resume", "-r", "--continue", "-c"} for value in options))
    if not resuming:
        for name, value in client_experience().Preferences(home()).get(project).items():
            if getattr(args, name) is None:
                setattr(args, name, value)
    if migration_device is not None:
        retire_live_grants(migration_device, yes=args.yes)
    claude = prepare_agent("claude", prompt_updates=(not background_job and args.print_prompt is None
                                                    and _claude_update_prompt(extra)))
    helper = inference_client() if gateway is None else None
    transport = None

    def model_command() -> list[str]:
        expected = getattr(args, "_job_generation", None)
        if expected is not None and not _job_authorized(
                {"device_id": device["device_id"], "slot_id": device["slot_id"]},
                {device["device_id"]: expected,
                 "token:" + device["device_id"]: args._job_device_generation}):
            raise helper.RelayError("the background job's account authorization changed")
        return (transport.command(["ccfleet-inference-v1"]) if transport is not None
                else inference_command(device))

    bridge = None
    descriptor = -1
    settings_path = None
    try:
        ensure_home()
        if getattr(args, "reuse_transport", False):
            transport = helper.TransportSession(
                lambda: ssh_transport_command(device, tty=False),
                project_environment, home()).start()
        if gateway is None:
            bridge = helper.Bridge(model_command, project_environment)
        descriptor, filename = tempfile.mkstemp(
            prefix=".inference-settings-", suffix=".json", dir=home())
        settings_path = Path(filename)
        env = dict(os.environ)
        if args.legacy_history:
            history_slot = gateway_slot or device["slot_id"]
            profile = home() / "local" / hashlib.sha256(history_slot.encode()).hexdigest()[:16]
            if not profile.is_dir():
                raise CliError("no earlier local-preview history exists for this slot")
            env["CLAUDE_CONFIG_DIR"] = str(profile)
        native_proxy_exclusions(env, project, extra)
        settings = native_settings(
            env, gateway["base_url"] if gateway else bridge.base_url,
            gateway["secret"] if gateway else bridge.secret, bare="--bare" in options,
            slot_id=gateway_slot if gateway else "")
        add_api_models(settings, route)
        with os.fdopen(descriptor, "w") as stream:
            descriptor = -1
            os.fchmod(stream.fileno(), 0o600)
            json.dump(settings, stream)
        if bridge is not None:
            bridge.start()
        print("Starting original local Claude Code. Files, tools and history stay here.\n"
              + ("Model requests use your HTTPS gateway. " if gateway else
               "Model requests use your assigned slot. ")
              + "Native prompts/tool results can still\n"
              "contain local context; this is not an anonymity guarantee.",
              file=sys.stderr, flush=True)
        command = local_claude_command(claude, args, settings_path, extra)
        if getattr(args, "_background_job", False):
            return subprocess.run(command, cwd=project, env=env,
                                  input=args.print_prompt, text=True, check=False).returncode
        return subprocess.call(command, cwd=project, env=env)
    finally:
        try:
            if bridge is not None:
                bridge.close()
        finally:
            try:
                if transport is not None:
                    transport.close()
            finally:
                if descriptor != -1:
                    os.close(descriptor)
                if settings_path is not None:
                    settings_path.unlink(missing_ok=True)


LAUNCHER_MARKER = "# CC Fleet external Claude launcher"
LAUNCHER_SETTINGS_LIMIT = 1024 * 1024
LAUNCHER_ROUTE_ENV = frozenset({
    "ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_API_KEY",
    "ANTHROPIC_CUSTOM_HEADERS", "CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_CODE_CLIENT_DATA_URL",
    "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "all_proxy",
})
LAUNCHER_AUTH_SETTINGS = frozenset({
    "apiKeyHelper", "awsAuthRefresh", "awsCredentialExport", "forceLoginMethod",
    "forceLoginOrgUUID",
})


def _launcher_directory(name: str, *, create: bool = False) -> Path:
    if not SESSION_RE.fullmatch(name):
        raise CliError("launcher names use 1-32 letters, digits, underscores or hyphens")
    root = home().absolute()
    for directory in (root, root / "launchers"):
        if create:
            directory.mkdir(mode=0o700, parents=directory == root, exist_ok=True)
        info = directory.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
                or info.st_mode & 0o077):
            raise CliError("launcher directories must be private and owned by this user")
    directory = root / "launchers" / name
    if not create or directory.exists() or directory.is_symlink():
        info = directory.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
                or info.st_mode & 0o077):
            raise CliError("launcher profile must be a private user-owned directory")
    return directory


def _launcher_json(value: str, *, private: bool = False) -> dict[str, Any]:
    """Read app settings without following a leaf symlink or echoing their contents."""
    try:
        if not private and value.lstrip().startswith("{"):
            raw = value.encode("utf-8")
        else:
            fd = os.open(Path(value).expanduser(), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(fd, "rb") as source:
                info = os.fstat(source.fileno())
                if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                        or info.st_mode & (0o077 if private else 0o022)):
                    raise ValueError("unsafe settings")
                raw = source.read(LAUNCHER_SETTINGS_LIMIT + 1)
        if len(raw) > LAUNCHER_SETTINGS_LIMIT:
            raise ValueError("oversized settings")

        def unique(pairs):
            result = {}
            for key, item in pairs:
                if key in result:
                    raise ValueError("duplicate setting")
                result[key] = item
            return result

        def nonfinite(_value):
            raise ValueError("nonfinite setting")

        result = json.loads(raw, object_pairs_hook=unique, parse_constant=nonfinite)
        if not isinstance(result, dict):
            raise ValueError("settings must be an object")
        return result
    except (OSError, ValueError, UnicodeError, RecursionError):
        raise CliError("launcher settings must be a bounded JSON object or a safe user-owned "
                       "JSON file; no settings contents were printed") from None


def _launcher_binary(value: str) -> Path:
    path = Path(value).expanduser()
    try:
        if not path.is_absolute() or path.lstat().st_uid not in {0, os.getuid()}:
            raise ValueError("not a fixed executable")
        # Keep the selected installation entrypoint, while allowing its native
        # updater to replace a version symlink. Execute only the checked target.
        path = path.resolve(strict=True)
        info = path.stat()
        if (not stat.S_ISREG(info.st_mode) or info.st_uid not in {0, os.getuid()}
                or info.st_mode & 0o022 or not os.access(path, os.X_OK)
                or path == Path(__file__).resolve()):
            raise ValueError("unsafe executable")
        with path.open("rb") as source:
            prefix = source.read(512)
            if (LAUNCHER_MARKER.encode() in prefix or b"# ccfleet-release-state: " in prefix):
                raise ValueError("recursive launcher")
        return path
    except (OSError, ValueError, RuntimeError):
        raise CliError("the launcher's original Claude executable is unavailable or unsafe; "
                       "choose the real Claude binary with --claude") from None


def _load_launcher(name: str) -> dict[str, Any]:
    directory = _launcher_directory(name)
    value = _launcher_json(str(directory / "profile.json"), private=True)
    if (set(value) != {"version", "slot_id", "server", "provider", "claude"}
            or type(value.get("version")) is not int or value["version"] != 1
            or not isinstance(value.get("slot_id"), str)
            or not re.fullmatch(r"[a-z0-9][a-z0-9_-]{1,63}", value["slot_id"])
            or not isinstance(value.get("provider"), str)
            or value["provider"] not in {"anthropic", "devin"}
            or not isinstance(value.get("claude"), str)):
        raise CliError("launcher profile is invalid; create a new named launcher")
    _gateway_url(value["server"])
    _launcher_candidate(value["claude"])
    return value


def _launcher_candidate(entry: str) -> Optional[str]:
    # Only the standard user installation can be bootstrapped at a known location.
    if Path(entry) == Path.home() / ".local/bin/claude" and not os.path.lexists(entry):
        return None
    return str(_launcher_binary(entry))


def _launcher_client_command() -> list[str]:
    """Managed launchers must follow activation and rollback, not a hidden old bundle."""
    source = Path(__file__).resolve()
    if any(parent.name == ".ccfleet-releases" for parent in source.parents):
        directory = install_directory()
        helper = client_release()
        try:
            installed = helper.status(directory, RELEASE_PUBLIC_KEY)
            expected = directory / helper.ROOT_NAME / installed["current"] / "ccfleet"
            if not installed.get("managed") or expected != source:
                raise ValueError("inactive release")
        except (helper.ReleaseError, KeyError, ValueError):
            raise CliError("create launchers through the active verified Fleet installation") \
                from None
        return [str(directory / "ccfleet")]
    return [sys.executable, "-I", str(source)]


def cmd_launcher_create(args: argparse.Namespace) -> int:
    directory = _launcher_directory(args.name, create=True)
    if directory.exists():
        raise CliError("that launcher already exists; choose a different launcher name")
    selected = args.claude or installed_agent("claude") or Path.home() / ".local/bin/claude"
    try:
        binary = Path(selected).expanduser().absolute()
        _launcher_candidate(str(binary))
    except (OSError, RuntimeError):
        raise CliError("choose an installed original Claude executable with --claude") from None
    route = local_route(load_config(), args.slot, "gateway", require_ready=False)
    gateway = route["gateway"]
    if gateway is None or not route["slot_id"]:
        raise CliError("a launcher needs one explicitly selected existing HTTPS gateway slot")
    value = {"version": 1, "slot_id": route["slot_id"], "server": gateway["base_url"],
             "provider": route["provider"], "claude": str(binary)}
    client_command = _launcher_client_command()
    wrapper = ("#!/bin/sh\n" + LAUNCHER_MARKER + "\n"
               + "export CCFLEET_HOME=" + shlex.quote(str(home().absolute())) + "\n"
               + "exec " + " ".join(shlex.quote(part) for part in (
                   *client_command, "__external-claude", "--launcher", args.name, "--"))
               + ' "$@"\n')
    directory.mkdir(mode=0o700)
    try:
        for name, data, mode in (("profile.json", json.dumps(value, sort_keys=True) + "\n", 0o600),
                                 ("claude", wrapper, 0o700)):
            fd = os.open(directory / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         mode)
            with os.fdopen(fd, "w") as destination:
                destination.write(data)
    except BaseException:
        for name in ("claude", "profile.json"):
            (directory / name).unlink(missing_ok=True)
        directory.rmdir()
        raise
    print(directory / "claude")
    return 0


def _launcher_merge(base: dict[str, Any], extra: dict[str, Any]) -> dict[str, Any]:
    result = dict(base)
    for key, value in extra.items():
        result[key] = (_launcher_merge(result[key], value)
                       if isinstance(result.get(key), dict) and isinstance(value, dict) else value)
    return result


def _launcher_arguments(arguments: list[str]) -> tuple[list[str], dict[str, Any], bool]:
    """Retain native options; merge only app settings, rejecting routing authority."""
    result, settings = [], {}
    bare = False
    if arguments and arguments[0] in {
            "auth", "login", "logout", "setup-token", "install", "update", "upgrade",
            "remote-control", "rc", "web", "cloud", "teleport", "mcp", "plugin", "doctor"}:
        raise CliError("the app launcher supports local Claude conversations and --version/--help, "
                       "not local account management or remote execution")
    forbidden = {"--cloud", "--teleport", "--remote-control", "--environment",
                 "--client-data-url", "--bg", "--background"}
    # Values of these native options can themselves look like an option. They
    # remain opaque, including prompts, schemas and app-owned MCP configuration.
    takes_value = {"--system-prompt", "--append-system-prompt", "--model", "--effort",
                   "--permission-mode", "--input-format", "--output-format", "--tools",
                   "--allowedTools", "--disallowedTools", "--mcp-config", "--agents",
                   "--agent", "--plugin-dir", "--setting-sources", "--settings-sources",
                   "--session-id", "--json-schema", "--max-budget-usd", "--fallback-model",
                   "--name", "--debug-file", "--permission-prompt-tool", "--betas"}
    position = 0
    while position < len(arguments):
        value = arguments[position]
        if value == "--":
            result.extend(arguments[position:])
            break
        name, separator, inline = value.partition("=")
        if name in forbidden:
            raise CliError("this app option leaves the launcher's fixed local Claude route")
        if name == "--settings":
            if not separator:
                position += 1
                if position == len(arguments):
                    raise CliError("--settings requires a JSON object or file")
                inline = arguments[position]
            extra = _launcher_json(inline)
            env = extra.get("env", {})
            if (not isinstance(env, dict)
                    or any(not isinstance(item, str) for item in env.values())
                    or any(key in LAUNCHER_ROUTE_ENV or key.startswith("CLAUDE_CODE_USE_")
                           for key in env)
                    or any(extra.get(key) for key in LAUNCHER_AUTH_SETTINGS)):
                raise CliError("app settings conflict with Fleet routing or authentication; "
                               "keep provider credentials in Fleet")
            settings = _launcher_merge(settings, extra)
        else:
            result.append(value)
            bare = bare or value == "--bare"
            if name in takes_value and not separator and position + 1 < len(arguments):
                position += 1
                result.append(arguments[position])
        position += 1
    return result, settings, bare


class _LauncherCancelled(BaseException):
    def __init__(self, signum: int) -> None:
        self.signum = signum


def cmd_external_claude(args: argparse.Namespace) -> int:
    """A Claude executable adapter: no prompts read, no defaults, no stdout narration."""
    profile = _load_launcher(args.launcher)
    arguments = list(args.claude_args)
    if arguments[:1] == ["--"]:
        arguments.pop(0)
    info_only = len(arguments) == 1 and arguments[0] in {"--version", "-v", "--help", "-h"}
    child = None
    starting_child = False
    settings_path = None
    cancelled = None
    cancelled_at = None
    # A terminal launch keeps native /dev/tty access. Headless SDK launches get
    # an isolated process group so cancelling a request can reap its descendants.
    own_group = not sys.stdin.isatty()
    signals = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT, signal.SIGWINCH)
    old_handlers = {number: signal.getsignal(number) for number in signals}

    def signal_child(number):
        if child is not None:
            with contextlib.suppress(ProcessLookupError):
                (os.killpg if own_group else os.kill)(child.pid, number)

    def forward(number, _frame):
        nonlocal cancelled, cancelled_at
        if number == signal.SIGINT and not own_group and child is not None:
            # Terminal Ctrl-C already reaches native Claude's foreground group.
            # It may cancel one turn and stay open; do not deliver it twice or
            # turn an interactive interrupt into process termination.
            return
        if number == signal.SIGWINCH:
            signal_child(number)
            return
        cancelled, cancelled_at = number, cancelled_at or time.monotonic()
        if child is None:
            if starting_child:
                return  # Publish Popen's child, then deliver the pending cancellation.
            raise _LauncherCancelled(number)
        signal_child(number)

    try:
        for number in signals:
            signal.signal(number, forward)
        env = dict(os.environ)
        if info_only:
            command = [str(_launcher_binary(profile["claude"])), *arguments]
        else:
            forwarded, settings, bare = _launcher_arguments(arguments)
            check_managed_route()
            saved_gateway = load_gateway()
            if (saved_gateway is None or saved_gateway["base_url"] != profile["server"]
                    or saved_gateway.get("provider", "anthropic") != profile["provider"]):
                raise CliError("the launcher needs its original Fleet HTTPS origin and provider")
            route = local_route(load_config(), profile["slot_id"], "gateway", canonical=True)
            gateway = route["gateway"]
            if (gateway is None or gateway["base_url"] != profile["server"]
                    or route["slot_id"] != profile["slot_id"]
                    or route["provider"] != profile["provider"]):
                raise CliError("the launcher no longer matches its selected Fleet origin, "
                               "slot and provider; no Claude process was started")
            env.update(settings.get("env", {}))
            native_choices = {key: env[key] for key in (
                "ANTHROPIC_MODEL", "CLAUDE_CODE_EFFORT_LEVEL") if key in env}
            native_proxy_exclusions(env, Path.cwd(), forwarded)
            pinned = native_settings(env, gateway["base_url"], gateway["secret"],
                                     bare=bare, slot_id=profile["slot_id"])
            add_api_models(pinned, route)
            env.update(native_choices)
            settings = _launcher_merge(settings, pinned)
            fd, filename = tempfile.mkstemp(prefix=".launcher-settings-", suffix=".json",
                                            dir=home())
            settings_path = Path(filename)
            with os.fdopen(fd, "w") as destination:
                os.fchmod(destination.fileno(), 0o600)
                json.dump(settings, destination)
            split = forwarded.index("--") if "--" in forwarded else len(forwarded)
            binary = prepare_agent("claude", find=lambda: _launcher_candidate(profile["claude"]),
                                   prompt_updates=False)
            command = [binary, *forwarded[:split], "--settings", str(settings_path),
                       *forwarded[split:]]
        # Do not interrupt Popen between creating and publishing its child.
        # Blocking signals here would leak a blocked mask into the native child.
        starting_child = True
        try:
            child = subprocess.Popen(command, env=env, start_new_session=own_group)
        finally:
            starting_child = False
        if cancelled is not None:
            signal_child(cancelled)
        while True:
            try:
                code = child.wait(timeout=0.2)
                if cancelled is not None:
                    return 128 + cancelled
                return 128 - code if code < 0 else code
            except subprocess.TimeoutExpired:
                # App SDKs may force-kill their executable after one second.
                # Reap its process group and remove settings before that deadline.
                if cancelled_at is not None and time.monotonic() - cancelled_at >= 0.5:
                    signal_child(signal.SIGKILL)
    except _LauncherCancelled as exc:
        return 128 + exc.signum
    finally:
        if child is not None and (cancelled is not None or child.poll() is None):
            signal_child(signal.SIGKILL)
            child.wait()
        if settings_path is not None:
            settings_path.unlink(missing_ok=True)
        for number, previous in old_handlers.items():
            signal.signal(number, previous)


def print_local_selection(config: dict[str, Any], profile=None, rows=()) -> None:
    selected = local_slot_choice(config)
    if selected:
        name = config["local_slot_choice"]["slot_name"]
        name = next((row["name"] for row in rows
                     if row["id"] == selected and row.get("name")), name)
        print(f"Local route: fixed to {slot_label(name)} (pool routing is overridden).\n"
              "Run ccfleet use --pool to follow the configured pool.")
    elif profile is not None:
        print("Local route: configured slot pool (no single-slot pin).")
    elif config["devices"]:
        device = choose_device(config)
        print(f"Local route: paired slot {slot_label(device.get('slot_name'))}.")


def cmd_list(args: argparse.Namespace) -> int:
    config = load_config()
    selected = local_slot_choice(config)
    if getattr(args, "remote", False):
        device = choose_device(config, getattr(args, "slot", ""))
        slots = own_gateway_slots(device)
        profile, answer = None, None
        same_selection_endpoint = (not selected or _gateway_url(device.get("server"))
            == _gateway_url(config["devices"][config["local_slot_choice"]["device_id"]]
                            .get("server")))
        if not same_selection_endpoint:
            selected = ""
        try:
            saved = load_gateway()
            if saved is not None:
                if _gateway_url(device.get("server")) != saved["base_url"]:
                    print("The saved gateway belongs to another connection; "
                          "its routing was not checked.")
                else:
                    current = gateway_for_launch(config, device, "gateway")
                    answer = check_gateway(current, require_ready=False)
                    profile = current
        except CliError:
            print("Gateway routing is unavailable; current owned slots are listed below.\n"
                  "Run ccfleet gateway setup to configure a working connection.")
        if profile is not None:
            if same_selection_endpoint:
                print_local_selection(config, profile, slots)
            else:
                print("The saved local slot pin belongs to another connection.")
            print_gateway_order(profile, answer.get("slots", []), config,
                                overridden=bool(selected))
        print("Your current slots:")
        for slot in slots:
            markers = []
            if slot["id"] == selected:
                markers.append("fixed local choice")
            if profile is not None and slot["id"] in profile["slot_ids"]:
                markers.append("pool priority " + str(profile["slot_ids"].index(slot["id"]) + 1))
            suffix = " — " + ", ".join(markers) if markers else ""
            print(f"  {slot_label(slot['name'])}{suffix}")
        print("This shows configuration, not the slot currently serving a conversation.")
        return 0
    profile = load_gateway()
    if not config["devices"]:
        print("No slots connected. Run ccfleet login.")
        return 0
    print_local_selection(config, profile)
    if profile is not None:
        print_gateway_order(profile, config=config, overridden=bool(selected))
    print("Saved computer pairings:")
    for device in config["devices"].values():
        print("  " + slot_label(device.get("slot_name")))
    print("Saved information only; run ccfleet list --remote for current names and routing.\n"
          "Pairings authorize this computer; they do not show a conversation's active slot.")
    return 0


def cmd_use(args: argparse.Namespace) -> int:
    config = load_config()
    if getattr(args, "pool", False):
        profile = load_gateway()
        if profile is None:
            raise CliError("run ccfleet gateway setup --slots SLOT before choosing the pool")
        device = choose_device(config, profile["device_id"])
        profile = gateway_for_launch(config, device, "gateway")
        answer = check_gateway(profile, require_ready=False)
        select_gateway_pool(config)
        print("Using the configured slot pool for new local sessions.")
        print_gateway_order(profile, answer.get("slots", []), config)
        return 0
    route = local_route(config, args.slot, require_ready=False, check_bridge=False)
    device = route["migration_device"] or route["device"]
    remember_local_slot(config, device,
                        slot_id=route["slot_id"] or route["device"]["slot_id"],
                        slot_name=route["slot_name"])
    save_config(config)
    print(f"Using {slot_label(route['slot_name'])} for local Claude Code.")
    print_local_route(route)
    return 0


def cmd_logout(args: argparse.Namespace) -> int:
    config = load_config()
    device = choose_device(config, args.slot)
    for record in config.get("live_folders", {}).values():
        if isinstance(record, dict) and record.get("device") == device["device_id"]:
            try:
                stop_local_connector(record["id"])
                live_control(device, record["id"], "stop")
            except (CliError, OSError, ValueError):
                print("Warning: a folder cleanup is pending; device revocation will still proceed.",
                      file=sys.stderr)
    pending_error: Optional[CliError] = None
    try:
        api_json(device["server"] + "/api/cli/revoke", device["device_token"], {})
    except CliError as exc:
        if exc.status != 401:
            pending_error = exc
    # Cut server access before local cleanup, which may need time to drain.
    try:
        local_jobs().stop_device(home() / "jobs", device["device_id"])
    except (CliError, OSError, ValueError):
        print("Local job cleanup needs attention; run ccfleet jobs list.", file=sys.stderr)
    if pending_error is not None:
        if not args.local_only:
            raise CliError("server revocation could not be confirmed; pairing is kept so you "
                           "can retry logout or revoke this device on your slot page")
        print("Server revocation is unconfirmed; only local pairing will be removed.",
              file=sys.stderr)
    for key in ("key", "known_hosts"):
        try:
            Path(device[key]).unlink()
        except FileNotFoundError:
            pass
        except OSError as exc:
            raise CliError(f"could not remove local {key}: {exc}") from exc
    config["devices"].pop(device["device_id"], None)
    config["active"] = next(iter(config["devices"]), "")
    if (isinstance(config.get("local_slot_choice"), dict)
            and config["local_slot_choice"].get("device_id") == device["device_id"]):
        config.pop("local_slot_choice")
    save_config(config)
    print(f"Disconnected {device['slot_name']} from this computer.")
    return 0


def _prepare_local_job(args: argparse.Namespace, prompt: str
                       ) -> tuple[Any, dict[str, Any], dict[str, Any], list[str], float, int]:
    """Validate deterministic launch inputs without retiring or starting work.

    The worker repeats its own guards later. This preflight is not a promise
    that the network, authorization or available job capacity cannot change.
    """
    if not isinstance(prompt, str) or not prompt.strip():
        raise CliError("a background job needs a nonempty prompt")
    if getattr(args, "resume", None) == "":
        raise CliError("a background job needs an explicit --resume ID or name; "
                       "use --continue for the latest conversation")
    if getattr(args, "transport", "auto") != "auto":
        raise CliError("background jobs use the configured default model route; "
                       "explicit --transport is currently a foreground option")
    if getattr(args, "reuse_transport", False):
        raise CliError("transport reuse is currently a foreground option; background jobs "
                       "use ordinary pinned SSH connections")
    if any(getattr(args, name, False) for name in ("disconnect", "reset_link", "remote_project")):
        raise CliError("background work cannot also request legacy workspace cleanup or recovery")
    try:
        project = Path(args.project).expanduser().resolve(strict=True)
    except (OSError, ValueError, RuntimeError) as exc:
        raise CliError("--project must be an existing local directory") from exc
    if not project.is_dir():
        raise CliError("--project must be an existing local directory")
    extra = native_extra_args(args)
    if "--" in extra:
        raise CliError("use the background prompt or a native positional prompt, not both")
    for index, value in enumerate(extra):
        if (value == "--resume=" or value in {"--resume", "-r"}
                and (index + 1 == len(extra) or not extra[index + 1]
                     or extra[index + 1].startswith("-"))):
            raise CliError("a background job needs an explicit --resume ID or name; "
                           "use --continue for the latest conversation")
    values = {key: getattr(args, key, None) for key in (
        "model", "effort", "mode", "name", "resume", "continue_session",
        "fork_session", "legacy_history")}
    values = {key: value for key, value in values.items() if value is not None}
    native_resuming = any(value.split("=", 1)[0] in {
        "--resume", "-r", "--continue", "-c"} for value in extra)
    if not values.get("resume") and not values.get("continue_session") and not native_resuming:
        values = {**client_experience().Preferences(home()).get(project), **values}
    options = _local_options({**values, "claude_args": extra,
                              "project": str(project), "print_prompt": prompt})
    if options.resume is not None and options.continue_session:
        raise CliError("use either --resume or --continue, not both")
    if options.fork_session and options.resume is None and not options.continue_session:
        raise CliError("--fork-session needs --resume or --continue")
    for label, value in (("session name", options.name), ("resume value", options.resume)):
        if value is not None and (not isinstance(value, str) or len(value) > 256 or any(
                ord(c) < 32 or ord(c) == 127 for c in value)):
            raise CliError(f"{label} must be at most 256 characters without control characters")
    if options.model is not None and (not isinstance(options.model, str)
                                     or not MODEL_RE.fullmatch(options.model)):
        raise CliError("invalid model name")
    if options.mode is not None and options.mode not in PERMISSION_MODES:
        raise CliError("invalid Claude permission mode")
    if options.effort is not None and options.effort not in EFFORT_LEVELS:
        raise CliError("invalid Claude effort level")
    helper = local_jobs()
    timeout = helper._number(getattr(args, "timeout", 3600), 1, helper.MAX_TIMEOUT_S, "job timeout")
    max_jobs = getattr(args, "max_jobs", 4)
    if type(max_jobs) is not int or not 1 <= max_jobs <= helper.MAX_CONCURRENT:
        raise CliError("invalid maximum concurrent job count")
    config = load_config()
    try:
        device = local_paired_device(config, args.slot)
    except CliError:
        raise CliError("background jobs need an already paired slot; "
                       "use an interactive local session for an unpaired gateway slot") from None
    values["extra_args"] = extra
    spec = {"device_id": device["device_id"], "slot_id": device["slot_id"],
            "project": str(project), "prompt": prompt, "options": values}
    helper._spec(dict(spec))
    if len(json.dumps(spec, allow_nan=False).encode()) > helper.MAX_SPEC_BYTES:
        raise CliError("local job specification is too large")
    check_managed_route()
    native_env = dict(os.environ)
    if options.legacy_history:
        profile = home() / "local" / hashlib.sha256(device["slot_id"].encode()).hexdigest()[:16]
        if not profile.is_dir():
            raise CliError("no earlier local-preview history exists for this slot")
        native_env["CLAUDE_CONFIG_DIR"] = str(profile)
    native_proxy_exclusions(native_env, project, extra)
    options._background_job = True
    # Construct only: no native process or temporary settings file is created.
    local_claude_command("claude", options, home() / ".inference-settings-preflight", extra)
    command = [sys.executable, "-I", str(Path(__file__).resolve()), "__job-run"]
    return helper, device, spec, command, timeout, max_jobs


def start_local_job(args: argparse.Namespace, prompt: str) -> int:
    helper, device, spec, command, timeout, max_jobs = _prepare_local_job(args, prompt)
    gateway = gateway_for_launch(load_config(), device, getattr(args, "transport", "auto"))
    if gateway is not None:
        # Existing supervised jobs are assignment-bound; preserve their authorization scope.
        if device["slot_id"] not in gateway["slot_ids"]:
            raise CliError("select this background job's slot for the gateway endpoint first")
        check_gateway(gateway, device["slot_id"])
    else:
        check_inference(device)
    # Ask only after inputs pass, while the user's interactive terminal exists.
    # The detached supervisor must not implicitly approve legacy cancellation.
    if sys.stdin.isatty() and sys.stdout.isatty():
        prepare_agent("claude")  # The detached worker cannot ask about an optional update.
    retire_live_grants(device, yes=getattr(args, "yes", False))
    result = helper.start(home() / "jobs", spec, command, timeout_s=timeout, max_jobs=max_jobs)
    print(json.dumps(result, sort_keys=True))
    return 0 if result.get("state") not in {
        "failed", "timed_out", "unresponsive", "interrupted"} else 2


def cmd_jobs(args: argparse.Namespace) -> int:
    helper, root = local_jobs(), home() / "jobs"
    if args.job_action == "start":
        prompt = args.prompt
        if prompt == "-":
            prompt = sys.stdin.read(1024 * 1024 + 1)
        return start_local_job(args, prompt)
    if args.job_action in (None, "list"):
        result = helper.list_jobs(root)
    elif args.job_action == "status":
        result = helper.status(root, args.job_id)
    elif args.job_action == "stop":
        result = helper.stop(root, args.job_id)
    elif args.job_action == "logs":
        sys.stdout.buffer.write(helper.logs(root, args.job_id, stream=args.stream,
                                             max_bytes=args.bytes))
        return 0
    elif args.job_action == "archive":
        result = helper.archive(root, args.job_id,
                                 acknowledge_unconfirmed=args.acknowledge_unconfirmed)
    else:
        raise CliError("unknown job action")
    print(json.dumps(result, sort_keys=True))
    return 0


def _job_authorized(spec: dict[str, Any], generations: Optional[dict[str, str]] = None) -> bool:
    try:
        device = choose_device(load_config(), spec["device_id"])
        if device["slot_id"] != spec["slot_id"]:
            return False
        answer = device_context(device)
        slot = answer.get("slot") or {}
        generation = slot.get("account_generation")
        if not isinstance(generation, str) or not re.fullmatch(r"[0-9a-f]{24}", generation):
            return False
        if slot.get("health") in {"switching", "sign_in_required"}:
            return False
        if generations is not None:
            previous = generations.setdefault(spec["device_id"], generation)
            if previous != generation:
                return False
            token_hash = hashlib.sha256(device["device_token"].encode()).hexdigest()
            credential = generations.setdefault("token:" + spec["device_id"], token_hash)
            if credential != token_hash:
                return False
        return (answer.get("authenticated") is True
                and (answer.get("device") or {}).get("active") is True)
    except (CliError, OSError, ValueError, KeyError, TypeError):
        return False


def cmd_job_run(args: argparse.Namespace) -> int:
    helper = local_jobs()
    generations: dict[str, str] = {}

    def command(spec: dict[str, Any]) -> list[str]:
        if not _job_authorized(spec, generations):
            raise CliError("the background job's device authorization could not be verified")
        return [sys.executable, "-I", str(Path(__file__).resolve()), "__job-exec", args.job_id,
                "--generation", generations[spec["device_id"]], "--device-generation",
                generations["token:" + spec["device_id"]]]

    return helper.run(home() / "jobs", args.job_id,
                      command=command,
                      check_authorization=lambda spec: _job_authorized(spec, generations))


def cmd_job_exec(args: argparse.Namespace) -> int:
    helper = local_jobs()
    with helper.parent_guard():
        spec = helper.read_spec(home() / "jobs", args.job_id)
        device = choose_device(load_config(), spec["device_id"])
        if device["slot_id"] != spec["slot_id"]:
            raise CliError("the background job's assignment changed")
        values = dict(spec["options"])
        values["claude_args"] = values.pop("extra_args", [])
        values.update(slot=spec["device_id"], project=spec["project"],
                      print_prompt=spec["prompt"], background=False, yes=False)
        options = _local_options(values)
        options._background_job = True
        options._job_generation = args.generation
        options._job_device_generation = args.device_generation
        if not _job_authorized(spec, {spec["device_id"]: args.generation,
                                      "token:" + spec["device_id"]: args.device_generation}):
            raise CliError("the background job's account authorization changed")
        return cmd_local(options)


def cmd_benchmark(args: argparse.Namespace) -> int:
    if not 2 <= args.iterations <= 10:
        raise CliError("choose between 2 and 10 readiness samples")
    helper = inference_client()
    device = choose_device(load_config(), args.slot)
    ensure_home()
    cold, reused = [], []
    for _ in range(args.iterations):
        began = time.monotonic()
        check_inference(device)
        cold.append(round((time.monotonic() - began) * 1000, 2))
    session = helper.TransportSession(lambda: ssh_transport_command(device, tty=False),
                                      project_environment, home())
    began = time.monotonic()
    session.start()
    startup = round((time.monotonic() - began) * 1000, 2)
    try:
        for _ in range(args.iterations):
            began = time.monotonic()
            helper.check_status(lambda: session.command(["ccfleet-inference-v1"]),
                                project_environment, timeout=25)
            reused.append(round((time.monotonic() - began) * 1000, 2))
    finally:
        session.close()
    report = {"schema": 1, "model_requests": 0, "method": "readiness_only",
              "samples": args.iterations, "cold_median_ms": statistics.median(cold),
              "reused_median_ms": statistics.median(reused), "master_startup_ms": startup,
              "inference_latency_measured": False}
    print(json.dumps(report, sort_keys=True))
    return 0


