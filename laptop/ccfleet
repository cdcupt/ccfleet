def cmd_mcp(args: argparse.Namespace) -> int:
    """Opt-in read-only management, pinned to one existing local pairing."""
    helper = client_experience()
    selected = choose_device(load_config(), args.slot)
    fields = ("device_id", "slot_id", "device_token", "server")
    if any(not isinstance(selected.get(field), str) or not selected[field] for field in fields):
        raise CliError("MCP needs a complete existing pairing; run ccfleet setup")
    binding = {field: selected[field] for field in fields}
    generation: Optional[str] = None
    invalidated = False

    def read_status() -> dict[str, Any]:
        nonlocal generation, invalidated
        if invalidated:
            raise CliError("MCP authorization changed; restart after checking your pairing")
        try:
            current = choose_device(load_config(), binding["device_id"])
        except (CliError, OSError, ValueError, TypeError, KeyError):
            invalidated = True
            raise CliError("MCP pairing is unavailable; restart after ccfleet setup") from None
        if any(current.get(field) != value for field, value in binding.items()):
            invalidated = True
            raise CliError("MCP pairing changed; restart after checking your pairing")
        try:
            answer = mcp_status_context(current)
        except CliError as exc:
            if exc.status in (401, 403, 404):
                invalidated = True
            raise CliError("MCP status is unavailable; check pairing and connection") from None
        slot = answer.get("slot") if isinstance(answer, dict) else None
        active = answer.get("device") if isinstance(answer, dict) else None
        observed = slot.get("account_generation") if isinstance(slot, dict) else None
        if (not isinstance(answer, dict) or answer.get("authenticated") is not True
                or type(answer.get("protocol")) is not int or answer["protocol"] != 2
                or not isinstance(active, dict) or active.get("active") is not True
                or not isinstance(observed, str) or not re.fullmatch(r"[0-9a-f]{24}", observed)):
            raise CliError("MCP received no valid authenticated status")
        if generation is not None and observed != generation:
            invalidated = True
            raise CliError("MCP account assignment changed; restart after checking your slot")
        generation = observed
        return answer

    return helper.serve_mcp(read_status)


def mcp_status_context(device: dict[str, Any]) -> dict[str, Any]:
    """A hard total read deadline, not merely a resettable socket timeout.

    This POSIX stdio command runs on the main thread. Do not replace another
    owner's active timer; restore the signal handler even on malformed replies.
    """
    if (threading.current_thread() is not threading.main_thread()
            or not hasattr(signal, "setitimer")
            or any(signal.getitimer(signal.ITIMER_REAL))):
        raise CliError("MCP status requires an available main-thread deadline")
    previous = signal.getsignal(signal.SIGALRM)

    def expired(_signum: int, _frame: Any) -> None:
        raise CliError("MCP status read exceeded its deadline")

    try:
        signal.signal(signal.SIGALRM, expired)
        signal.setitimer(signal.ITIMER_REAL, MCP_READ_TIMEOUT)
        return device_context(device)
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


