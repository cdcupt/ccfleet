def slot_component(name, digest, operation, slot_command):
    try:
        return packaged_helper(name, digest)
    except CliError:
        pass
    release = client_release()
    root = home() / ("native-preview" if operation == "helper" else "editor-components")
    directory = release._directory(root, create=True)
    try:
        release._owned(os.fstat(directory), directory=True)
    finally:
        os.close(directory)
    cached = root / (digest + ".py")
    try:
        raw = release._read(cached, 128 * 1024)
    except FileNotFoundError:
        if operation == "native-terminal":
            # Older signed updaters install exactly eight sources. The launcher carries
            # this component so a single update also works against older paired Macs.
            raw = base64.b64decode(NATIVE_TERMINAL_RESOURCE, validate=True)
        else:
            with tempfile.TemporaryDirectory(dir=root) as stage:
                downloaded = Path(stage) / "helper.py"
                try:
                    request = {"op": operation}
                    if operation != "helper":
                        request["sha256"] = digest
                    client_experience().slot_artifact(slot_command, request, downloaded,
                                                      128 * 1024, 20)
                except subprocess.TimeoutExpired as exc:
                    raise CliError("timed out retrieving the Gemini component from the slot") from exc
                except ValueError as exc:
                    if operation == "helper":
                        raise
                    raise CliError("could not retrieve the required Gemini editor component; check "
                                   "the private Mac connection and update its CCFleet slot service") from exc
                raw = downloaded.read_bytes()
        if hashlib.sha256(raw).hexdigest() != digest:
            raise CliError("Gemini component checksum mismatch")
        with tempfile.NamedTemporaryFile(dir=root, delete=False) as temp:
            staging_path = Path(temp.name)
            try:
                temp.write(raw)
                temp.flush()
                os.fsync(temp.fileno())
                os.chmod(staging_path, 0o400)
                os.replace(staging_path, cached)
            finally:
                staging_path.unlink(missing_ok=True)
    if hashlib.sha256(raw).hexdigest() != digest:
        raise CliError("installed Gemini component failed verification")
    spec = importlib.util.spec_from_file_location("_ccfleet_" + name, cached)
    if spec is None:
        raise CliError("Gemini component cannot be loaded")
    module = importlib.util.module_from_spec(spec)
    exec(compile(raw, str(cached), "exec"), module.__dict__)
    return module


