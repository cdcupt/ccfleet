                                     help="archive an inactive record whose cleanup is unconfirmed")
    for name in ("__job-run", "__job-exec"):
        internal = sub.add_parser(name, help=argparse.SUPPRESS)
        internal.add_argument("job_id")
        if name == "__job-exec":
            internal.add_argument("--generation", required=True)
            internal.add_argument("--device-generation", required=True)
    project = sub.add_parser("project", help="review, upload, or apply selected project files")
    project.add_argument("project_action", choices=("status", "push", "diff", "pull", "list"))
    project.add_argument("--slot", default="", help="paired slot id or name")
    project.add_argument("--project", default=".", help="selected local project directory")
    project.add_argument("--remote-project", default="", metavar="ID",
                         help="existing project ID from ccfleet project list")
    project.add_argument("--yes", action="store_true", help="explicitly approve upload/apply")
    listing = sub.add_parser("list",
                             help="list saved pairings, or current owned slots with --remote")
    listing.add_argument("--remote", action="store_true", help="fetch your current owned slots")
    listing.add_argument("--slot", default="", help="saved pairing used to authorize --remote")
    use = sub.add_parser("use", help="choose one local slot or restore configured pool routing")
    selection = use.add_mutually_exclusive_group(required=True)
    selection.add_argument("slot", nargs="?", help="fix new local sessions to one slot")
    selection.add_argument("--pool", action="store_true",
                           help="clear the local slot pin and follow the existing gateway pool")
    logout = sub.add_parser("logout", help="revoke this computer and remove its local key")
    logout.add_argument("--slot", default="", help="slot id or name")
    logout.add_argument("--local-only", action="store_true", help=argparse.SUPPRESS)
    hidden = sub.add_parser("proxy", help=argparse.SUPPRESS)
    hidden.add_argument("--device", required=True)
    hidden.add_argument("--fleet-only", action="store_true", help=argparse.SUPPRESS)
    resident = sub.add_parser("live-serve", help=argparse.SUPPRESS)
    resident.add_argument("--project-id", required=True)
    # argparse otherwise prints suppressed subcommands as '==SUPPRESS=='.
    sub.metavar = "COMMAND"
    internal_commands = {"proxy", "live-serve", "__job-run", "__job-exec", "__external-claude"}
    sub._choices_actions = [action for action in sub._choices_actions
                            if action.dest not in internal_commands]
    return root


def main(argv: Optional[list[str]] = None) -> int:
    args = parser().parse_args(argv)
    try:
        if args.command in (None, "attach", "remote"):
            if args.command is None:
                args.slot, args.session, args.mode = "", "ccfleet", "bypassPermissions"
                args.model, args.effort = "opus", "max"
                args.action, args.no_reconnect, args.reconnect_for = "open", False, 600
            if not SESSION_RE.fullmatch(args.session):
                raise CliError("session names use 1-32 letters, digits, underscores or hyphens")
            if not MODEL_RE.fullmatch(args.model):
                raise CliError("model names use 1-64 letters, digits, dots, underscores or hyphens")
            return cmd_attach(args)
        if args.command in ("new", "restart"):
            if not SESSION_RE.fullmatch(args.session):
                raise CliError("session names use 1-32 letters, digits, underscores or hyphens")
            if not MODEL_RE.fullmatch(args.model):
                raise CliError("model names use 1-64 letters, digits, dots, underscores or hyphens")
            return cmd_attach(args)
        if args.command == "login":
            return cmd_login(args)
        if args.command == "setup":
            return cmd_setup(args)
        if args.command in ("openrouter", "openrouter-images"):
            return cmd_openrouter(args)
        if args.command == "gateway":
            return cmd_gateway(args)
        if args.command == "launcher":
            return cmd_launcher_create(args)
        if args.command == "__external-claude":
            return cmd_external_claude(args)
        if args.command == "pair":
            return cmd_pair_gemini(args)
        if args.command == "gemini":
            return cmd_gemini(args)
        if args.command == "workspace":
            return cmd_workspace(install_only=args.install_only)
        if args.command in ("start", "menu"):
            return cmd_start(args)
        if args.command == "sessions":
            return cmd_local(_local_options({"project": args.project, "slot": args.slot,
                                              "resume": "", "yes": args.yes}))
        if args.command in ("doctor", "status"):
            return cmd_diagnostics(args)
        if args.command == "mcp":
            return cmd_mcp(args)
        if args.command == "preferences":
            return cmd_preferences(args)
        if args.command in ("version", "update", "upgrade"):
            return cmd_release(args)
        if args.command == "benchmark":
            return cmd_benchmark(args)
        if args.command == "jobs":
            return cmd_jobs(args)
        if args.command == "__job-run":
            return cmd_job_run(args)
        if args.command == "__job-exec":
            return cmd_job_exec(args)
        if args.command == "claude":
            return cmd_local(args)
        if args.command == "snapshot":
            if args.disconnect or args.reset_link:
                raise CliError("live link controls are not snapshot operations")
            return cmd_snapshot(args)
        if args.command == "project":
            return cmd_project(args)
        if args.command == "list":
            return cmd_list(args)
        if args.command == "use":
            return cmd_use(args)
        if args.command == "logout":
            return cmd_logout(args)
        if args.command == "proxy":
            device = choose_device(load_config(), args.device)
            if args.fleet_only:
                return proxy(device, fleet_only=True)
            return proxy(device)
        if args.command == "live-serve":
            return cmd_live_serve(args)
        raise CliError("unknown command")
    except KeyboardInterrupt:
        return 130
    except (CliError, OSError, ValueError) as exc:
        print(f"ccfleet: {exc}", file=sys.stderr)
        return 2


