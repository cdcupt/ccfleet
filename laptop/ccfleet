class CliError(RuntimeError):
    def __init__(self, message: str, status: Optional[int] = None, *, code: str = "") -> None:
        super().__init__(message)
        self.status = status
        self.code = code


class FleetArgumentParser(argparse.ArgumentParser):
    def _check_value(self, action: argparse.Action, value: Any) -> None:
        if isinstance(action, argparse._SubParsersAction) and value == "local":
            raise argparse.ArgumentError(action, "use ccfleet claude (formerly ccfleet local)")
        if isinstance(action, argparse._SubParsersAction) and value not in action.choices:
            raise argparse.ArgumentError(
                action, f"unknown command {value!r}; run {self.prog} --help")
        super()._check_value(action, value)


def home() -> Path:
    return Path(os.environ.get("CCFLEET_HOME") or Path.home() / ".config" / "ccfleet")


def config_path() -> Path:
    return home() / "config.json"


def ensure_home() -> None:
    home().mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(home(), 0o700)


def load_config() -> dict[str, Any]:
    try:
        data = json.loads(config_path().read_text())
    except FileNotFoundError:
        return {"version": 1, "active": "", "devices": {}}
    except (OSError, json.JSONDecodeError) as exc:
        raise CliError(f"cannot read {config_path()}: {exc}") from exc
    if not isinstance(data, dict) or not isinstance(data.get("devices"), dict):
        raise CliError(f"{config_path()} is not a ccfleet configuration")
    return data


def save_config(config: dict[str, Any]) -> None:
    ensure_home()
    fd, temporary = tempfile.mkstemp(prefix=".config.", dir=home())
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as stream:
            json.dump(config, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, config_path())
        os.chmod(config_path(), 0o600)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        # A pairing/device secret belongs only to its configured endpoint.
        # urllib otherwise preserves Authorization when following redirects.
        return None


def canonical_runtime_url(value: str) -> str:
    """Resolve one approved service alias only when sending, never in storage.

    This signed client knows both service names. It does not discover a new
    credential destination from redirects, DNS, response JSON or saved metadata.
    Other origins and loopback transports keep their existing addresses.
    """
    if (not isinstance(value, str) or not value or len(value) > 8192
            or any(ord(char) <= 32 or ord(char) == 127 for char in value)
            or "\\" in value):
        raise CliError("service endpoint URL is invalid")
    try:
        parsed = urllib.parse.urlsplit(value)
        if (parsed.username is not None or parsed.password is not None or parsed.fragment):
            raise ValueError("credential or fragment in endpoint")
        # Accessing port rejects malformed/out-of-range authorities before I/O.
        _port = parsed.port
    except ValueError as exc:
        raise CliError("service endpoint URL is invalid") from exc
    if (parsed.scheme in {"https", "wss"}
            and parsed.netloc in {"ccfleet.daichenlab.com", "ccfleet.daichenlab.com:443"}):
        prefix = parsed.scheme + "://" + parsed.netloc
        if value.startswith(prefix):
            # Keep the path/query byte-for-byte, including empty query markers.
            return parsed.scheme + "://ccfleet.io" + value[len(prefix):]
    return value


def api_json(url: str, token: str, payload: Optional[dict[str, Any]] = None,
             method: str = "POST", *, timeout: float = 20, fleet_only: bool = False) -> dict[str, Any]:
    url = canonical_runtime_url(url)
    if fleet_only and url not in (DEFAULT_SERVER + "/api/cli/register",
                                  DEFAULT_SERVER + "/api/cli/revoke"):
        raise CliError("workspace pairing requires the ccfleet.io origin")
    handlers = [urllib.request.ProxyHandler({}), _NoRedirect()] if fleet_only else [_NoRedirect()]
    body = json.dumps(payload).encode() if payload is not None else b""
    request = urllib.request.Request(
        url, data=body, method=method,
        headers={"Authorization": f"Bearer {token}",
                 "Content-Type": "application/json", "Accept": "application/json"})
    try:
        with urllib.request.build_opener(*handlers).open(request, timeout=timeout) as response:
            result = json.loads(response.read(256 * 1024).decode())
    except urllib.error.HTTPError as exc:
        try:
            why = json.loads(exc.read(64 * 1024).decode()).get("error")
        except (ValueError, UnicodeError):
            why = None
        raise CliError(str(why or f"server returned HTTP {exc.code}"), exc.code) from exc
    except (CliError, OSError, ValueError) as exc:
        raise CliError(f"could not reach ccfleet: {exc}") from exc
    if not isinstance(result, dict):
        raise CliError("ccfleet returned an invalid response")
    return result



def _gateway_url(value: Any) -> str:
    """A credential may be sent only to a clean HTTPS endpoint (loopback in tests)."""
    if not isinstance(value, str) or not value or len(value) > 2048:
        raise CliError("gateway Base URL is invalid")
    try:
        parsed = urllib.parse.urlsplit(value)
    except ValueError as exc:
        raise CliError("gateway Base URL is invalid") from exc
    local = parsed.scheme == "http" and parsed.hostname in {"localhost", "127.0.0.1", "::1"}
    if (parsed.scheme != "https" and not local or not parsed.hostname
            or parsed.username is not None or parsed.password is not None
            or parsed.query or parsed.fragment or parsed.path not in ("", "/")
            or any(ord(c) < 33 or ord(c) == 127 for c in value)):
        raise CliError("gateway Base URL must be an HTTPS origin without credentials or a path")
    try:
        _port = parsed.port
    except ValueError as exc:
        raise CliError("gateway Base URL port is invalid") from exc
    return canonical_runtime_url(value.rstrip("/"))


def _gateway_profile(value: Any) -> dict[str, Any]:
    if (not isinstance(value, dict) or type(value.get("version")) is not int
            or value["version"] != 1
            or not isinstance(value.get("secret"), str)
            or not re.fullmatch(r"ccf_api_[A-Za-z0-9_-]{43}", value["secret"])
            or not isinstance(value.get("key_id"), str) or not value["key_id"]
            or not isinstance(value.get("mode"), str)
            or value["mode"] not in {"sticky", "priority"}
            or not isinstance(value.get("slot_ids"), list) or not value["slot_ids"]
            or len(value["slot_ids"]) > 100
            or any(not isinstance(s, str) or not re.fullmatch(r"[a-z0-9][a-z0-9_-]{1,63}", s)
                   for s in value["slot_ids"])
            or len(set(value["slot_ids"])) != len(value["slot_ids"])
            or ("provider" in value and (not isinstance(value["provider"], str)
                                         or value["provider"] not in {"anthropic", "devin"}))
            or ("slot_names" in value and (
                not isinstance(value["slot_names"], dict) or len(value["slot_names"]) > 100
                or any(not isinstance(identifier, str)
                       or not re.fullmatch(r"[a-z0-9][a-z0-9_-]{1,63}", identifier)
                       or identifier not in value["slot_ids"]
                       or not isinstance(name, str) or not name or len(name) > 200
                       or any(ord(char) < 32 or ord(char) == 127 for char in name)
                       for identifier, name in value["slot_names"].items())))
            or not isinstance(value.get("device_id"), str) or not value["device_id"]):
        raise CliError("saved gateway configuration is invalid; rerun ccfleet gateway setup")
    result = dict(value)
    result["base_url"] = _gateway_url(value.get("base_url"))
    return result


def slot_label(name: Any) -> str:
    """Display names are separate from the internal identifiers used for routing."""
    if (not isinstance(name, str) or not name or len(name) > 200
            or any(ord(char) < 32 or ord(char) == 127 for char in name)
            or re.fullmatch(r"pool-[0-9]+", name)):
        return "Name unavailable"
    return name


def gateway_slot_labels(profile: dict[str, Any], rows=(), config=None) -> list[str]:
    names = {}
    if config is not None:
        def same_endpoint(device):
            if not isinstance(device, dict):
                return False
            try:
                return _gateway_url(device.get("server")) == _gateway_url(profile["base_url"])
            except CliError:
                return False
        names.update({device.get("slot_id"): device.get("slot_name")
                      for device in config["devices"].values() if same_endpoint(device)})
        choice = config.get("local_slot_choice")
        if (isinstance(choice, dict)
                and same_endpoint(config["devices"].get(choice.get("device_id")))):
            names[choice.get("slot_id")] = choice.get("slot_name")
    names.update(profile.get("slot_names", {}))
    names.update({row["id"]: row["name"] for row in rows if row.get("name")})
    return [slot_label(names.get(identifier)) for identifier in profile["slot_ids"]]


def print_gateway_order(profile: dict[str, Any], rows=(), config=None, *, stream=None,
                        overridden=False) -> None:
    routing = ("Configured gateway routing: " + profile["mode"]
               + " (overridden by fixed slot)" if overridden else "Routing: " + profile["mode"])
    order = "Configured gateway slot order: " if overridden else "Slot order: "
    print(routing, file=stream)
    print(order + " → ".join(gateway_slot_labels(profile, rows, config)), file=stream)


def select_gateway_pool(config: dict[str, Any]) -> None:
    """Keep pairing authority and endpoint secrets; remove only the local override."""
    if "local_slot_choice" in config:
        config.pop("local_slot_choice")
        save_config(config)


def finish_gateway_setup(args, profile, slots) -> None:
    config = load_config()
    if getattr(args, "slots", None):
        # An explicit ordered selection is also the user's requested local route.
        # Wait until enrollment/readiness succeeds before replacing a fixed choice.
        select_gateway_pool(config)
        print("Local route: configured slot pool. Any previous single-slot pin was cleared.")
    elif local_slot_choice(config):
        name = slot_label(config["local_slot_choice"]["slot_name"])
        print(f"Local route remains fixed to {name}; gateway pool routing is overridden.\n"
              "Run ccfleet use --pool to follow the configured pool.")
    print_gateway_order(profile, slots, config, overridden=bool(local_slot_choice(config)))


def own_gateway_slots(device: dict[str, Any]) -> list[dict[str, Any]]:
    """Discover current ownership using a previously authorized device only."""
    server = _gateway_url(device.get("server"))
    options = api_json(server + "/api/cli/gateway/options", device["device_token"], method="GET")
    if options.get("available") is not True or _gateway_url(options.get("base_url")) != server:
        raise CliError("direct HTTPS API access is not enabled on this server")
    slots = options.get("slots")
    providers = options.get("providers", ["anthropic"])
    if (not isinstance(providers, list) or not providers or len(providers) > 2
            or any(not isinstance(provider, str) or provider not in {"anthropic", "devin"}
                   for provider in providers)
            or not isinstance(slots, list) or len(slots) > 100
            or any(not isinstance(slot, dict)
                   or not isinstance(slot.get("id"), str)
                   or not re.fullmatch(r"[a-z0-9][a-z0-9_-]{1,63}", slot["id"])
                   or not isinstance(slot.get("name"), str)
                   or not slot["name"] or len(slot["name"]) > 200
                   or any(ord(char) < 32 or ord(char) == 127 for char in slot["name"])
                   or ("providers" in slot and (not isinstance(slot["providers"], list)
                       or any(not isinstance(provider, str)
                              or provider not in providers
                              for provider in slot["providers"])))
                   for slot in slots)
            or len({slot["id"] for slot in slots}) != len(slots)):
        raise CliError("server returned invalid own-slot choices")
    return slots


@contextlib.contextmanager
def credential_directory(*, create: bool = False):
    if create:
        home().mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        fd = os.open(home(), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except FileNotFoundError:
        raise
    except OSError as exc:
        raise CliError("Fleet credential directory could not be opened safely") from exc
    try:
        info = os.fstat(fd)
        if info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise CliError("Fleet credential directory must be private and owned by this user")
        yield fd
    finally:
        os.close(fd)


def read_private_profile(name: str) -> Optional[dict[str, Any]]:
    try:
        with credential_directory() as directory:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
            with os.fdopen(fd, "rb") as stream:
                info = os.fstat(stream.fileno())
                if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                        or info.st_mode & 0o077 or info.st_nlink != 1):
                    raise CliError("Fleet credential must be a private user-owned file")
                raw = stream.read(32769)
            if len(raw) > 32768:
                raise CliError("Fleet credential file is too large")
            profile = json.loads(raw)
            if not isinstance(profile, dict):
                raise CliError("invalid Fleet credential file")
            return profile
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as exc:
        raise CliError("Fleet credential could not be read safely") from exc


def write_private_profile(name: str, profile: dict[str, Any]) -> None:
    with credential_directory(create=True) as directory:
        temporary = ".credential-" + secrets.token_hex(16)
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                     0o600, dir_fd=directory)
        try:
            with os.fdopen(fd, "w") as stream:
                json.dump(profile, stream, sort_keys=True)
                stream.write("\n")
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
        finally:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(temporary, dir_fd=directory)


def load_gateway() -> Optional[dict[str, Any]]:
    profile = read_private_profile("gateway.json")
    return None if profile is None else _gateway_profile(profile)


def save_gateway(value: dict[str, Any]) -> None:
    write_private_profile("gateway.json", _gateway_profile(value))


def check_gateway(profile: dict[str, Any], slot_id: str = "", *,
                  timeout: Optional[float] = None, require_ready: bool = True) -> dict[str, Any]:
    suffix = "?slot=" + urllib.parse.quote(slot_id, safe="") if slot_id else ""
    try:
        options = {"timeout": timeout} if timeout is not None else {}
        answer = api_json(profile["base_url"] + "/api/gateway/status" + suffix,
                          profile["secret"], method="GET", **options)
    except CliError as exc:
        raise CliError("gateway readiness check failed; check Your slots and API endpoints. "
                       "No model request was sent and no bridge fallback was started",
                       status=exc.status,
                       code="connection" if exc.status is None or exc.status >= 500
                       or exc.status == 429 else "gateway_denied") from None
    current = answer.get("key")
    updated_profile = dict(profile)
    if isinstance(current, dict):
        refreshed = {**profile, "slot_ids": current.get("slot_ids"), "mode": current.get("mode")}
        if "slot_names" in profile and isinstance(refreshed["slot_ids"], list):
            refreshed["slot_names"] = {identifier: name for identifier, name in
                                       profile["slot_names"].items()
                                       if identifier in refreshed["slot_ids"]}
        refreshed = _gateway_profile(refreshed)
        if current.get("id") != profile["key_id"]:
            raise CliError("gateway returned a different endpoint identity")
        updated_profile.update(refreshed)
    has_provider = "provider" in answer or isinstance(current, dict) and "provider" in current
    provider = answer.get("provider", (current.get("provider")
                                       if isinstance(current, dict) else None))
    if has_provider:
        if not isinstance(provider, str) or provider not in {"anthropic", "devin"}:
            raise CliError("gateway returned an invalid model provider")
        updated_profile["provider"] = provider
    slots = answer.get("slots", [])
    if (not isinstance(slots, list) or len(slots) > 100
            or any(not isinstance(slot, dict)
                   or not isinstance(slot.get("id"), str)
                   or slot["id"] not in updated_profile["slot_ids"]
                   or ("name" in slot and (not isinstance(slot["name"], str)
                       or not slot["name"] or len(slot["name"]) > 200
                       or any(ord(char) < 32 or ord(char) == 127 for char in slot["name"])))
                   for slot in slots)
            or len({slot["id"] for slot in slots}) != len(slots)):
        raise CliError("gateway returned an invalid selected-slot list")
    profile.update(updated_profile)
    if require_ready and answer.get("ready") is not True:
        raise CliError("no selected gateway slot is ready; check Your slots. "
                       "No model request or bridge fallback was started", code="gateway_pending")
    return answer


def wait_for_gateway_setup(profile: dict[str, Any]) -> None:
    """Wait only for read-only readiness; enrollment and model requests are never retried."""
    deadline = time.monotonic() + SETUP_WAIT_SECONDS
    waiting = False
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise CliError("gateway configuration is saved, but readiness is not yet confirmed. "
                           "Rerun ccfleet gateway setup with the same slot selection; "
                           "no new key, model request or bridge fallback is needed")
        try:
            check_gateway(profile, timeout=min(20, remaining))
            return
        except CliError as exc:
            if exc.code not in {"connection", "gateway_pending"}:
                raise CliError("gateway configuration is saved, "
                               "but its readiness check was denied. "
                               "Check API endpoints on Your slots; no model request was sent",
                               status=exc.status) from None
        remaining = deadline - time.monotonic()
        if remaining > 0:
            if not waiting:
                print("Gateway configured. Waiting for selected slots to accept the connection...",
                      file=sys.stderr, flush=True)
                waiting = True
            time.sleep(min(5, remaining))


def gateway_for_launch(config: dict[str, Any], device: dict[str, Any],
                       transport: str = "auto") -> Optional[dict[str, Any]]:
    if transport == "bridge":
        return None
    profile = load_gateway()
    if profile is None:
        if transport == "gateway":
            raise CliError("run ccfleet gateway setup to configure direct HTTPS API access")
        return None
    pairing = config.get("devices", {}).get(profile["device_id"])
    if (not isinstance(pairing, dict) or not isinstance(pairing.get("server"), str)
            or _gateway_url(pairing["server"]) != profile["base_url"]
            or _gateway_url(device.get("server")) != profile["base_url"]):
        raise CliError("gateway endpoint does not match the selected pairing; "
                       "rerun ccfleet gateway setup or choose --transport bridge")
    return profile


def cmd_gateway(args: argparse.Namespace) -> int:
    config = load_config()
    device = choose_device(config, args.slot)
    if args.gateway_action in (None, "status"):
        profile = gateway_for_launch(config, device, "gateway")
        answer = check_gateway(profile)
        print("Direct HTTPS gateway ready.\nBase URL: " + profile["base_url"])
        print_gateway_order(profile, answer.get("slots", []), config,
                            overridden=bool(local_slot_choice(config)))
        print_local_selection(config, profile, answer.get("slots", []))
        return 0
    if args.gateway_action == "remove":
        profile = load_gateway()
        if profile is not None:
            profile = gateway_for_launch(config, device, "gateway")
            # Revocation happens first: losing a reply must never silently leave a live key.
            api_json(profile["base_url"] + "/api/cli/gateway/revoke",
                     device["device_token"], {"key_id": profile["key_id"]})
            (home() / "gateway.json").unlink()
        print("Gateway key revoked and local gateway configuration removed.")
        return 0
    server = _gateway_url(device.get("server"))
    slots = own_gateway_slots(device)
    selected = []
    for choice in args.slots or [device["slot_id"]]:
        matches = [s["id"] for s in slots if choice in (s["id"], s["name"])]
        if len(matches) != 1 or matches[0] in selected:
            raise CliError("choose each of your own slots once, using its name or id")
        selected.append(matches[0])
    previous = load_gateway()
    requested_provider = getattr(args, "provider", None)
    same_previous = bool(previous is not None and previous["base_url"] == server
                         and previous["device_id"] == device["device_id"])
    if same_previous and not getattr(args, "replace", False):
        # Website edits are authoritative even when no selected slot is ready.
        check_gateway(previous, require_ready=False)
    if (not getattr(args, "replace", False) and previous is not None
            and same_previous
            and previous["slot_ids"] == selected and previous["mode"] == args.routing
            and (requested_provider is None
                 or requested_provider == previous.get("provider", "anthropic"))):
        wait_for_gateway_setup(previous)
        if (previous["slot_ids"] == selected and previous["mode"] == args.routing
                and (requested_provider is None
                     or requested_provider == previous.get("provider", "anthropic"))):
            print("Existing gateway configuration kept. Base URL: " + server
                  + "\nRun ccfleet claude.")
            finish_gateway_setup(args, previous, slots)
            return 0
    provider = requested_provider or (
        previous.get("provider", "anthropic") if same_previous else "anthropic")
    if provider == "devin" and (len(selected) != 1 or not any(
            slot["id"] == selected[0] and "devin" in slot.get("providers", []) for slot in slots)):
        raise CliError("Devin requires exactly one of your verified ready slots")
    answer = api_json(server + "/api/cli/gateway", device["device_token"],
                      {"name": args.name or "This computer", "slot_ids": selected,
                       "mode": args.routing, "provider": provider})
    key = answer.get("key")
    if not isinstance(key, dict):
        raise CliError("server returned incomplete gateway configuration")
    profile = _gateway_profile({"version": 1, "base_url": answer.get("base_url"),
                                "secret": answer.get("secret"), "key_id": key.get("id"),
                                "mode": key.get("mode"), "slot_ids": key.get("slot_ids"),
                                "provider": key.get("provider", "anthropic"),
                                "slot_names": {row["id"]: row["name"] for row in slots
                                               if row["id"] in selected},
                                "device_id": device["device_id"]})
    if (profile["base_url"] != server or profile["slot_ids"] != selected
            or profile["provider"] != provider):
        raise CliError("server returned a different endpoint or slot selection")
    try:
        save_gateway(profile)
    except (CliError, OSError, ValueError):
        with contextlib.suppress(CliError):
            api_json(server + "/api/cli/gateway/revoke", device["device_token"],
                     {"key_id": profile["key_id"]})
        raise CliError("gateway key could not be saved safely; "
                       "check API endpoints before retrying") from None
    wait_for_gateway_setup(profile)
    if previous is not None and previous["base_url"] == server:
        print("The previous endpoint key was kept so existing launches can finish. "
              "Revoke older keys in API endpoints when they are no longer used.", file=sys.stderr)
    print("Gateway configured. Your private endpoint key was saved without displaying it.\n"
          "Base URL: " + profile["base_url"] + "\nRun ccfleet claude. "
          "Model requests use HTTPS directly; no local HTTP listener or laptop SSH is needed.\n"
          "Manage routing and revoke keys on " + server + "/account#gateway")
    finish_gateway_setup(args, profile, slots)
    return 0

def generate_key() -> tuple[Path, str]:
    if shutil.which("ssh-keygen") is None:
        raise CliError("OpenSSH is required (missing ssh-keygen)")
    ensure_home()
    path = home() / (".pairing-" + secrets.token_hex(8))
    proc = subprocess.run(
        ["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "ccfleet", "-f", str(path)],
        capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        raise CliError(proc.stderr.strip() or "ssh-keygen failed")
    os.chmod(path, 0o600)
    return path, path.with_suffix(".pub").read_text().strip()


def prompt_pairing_code(prompt: str = "Pairing code from your slot page: ") -> str:
    message = "Run setup in an interactive terminal to enter a hidden pairing code."
    try:
        # stdin is the installation script when invoked with curl | bash.
        # Probe the controlling terminal, not stdin, and forbid getpass fallback.
        descriptor = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
        try:
            if not os.isatty(descriptor):
                raise CliError(message)
        finally:
            os.close(descriptor)
        with warnings.catch_warnings():
            warnings.simplefilter("error", getpass.GetPassWarning)
            return getpass.getpass(prompt).strip()
    except (OSError, EOFError, getpass.GetPassWarning) as exc:
        raise CliError(message) from exc


def cmd_login(args: argparse.Namespace) -> int:
    server = args.server.rstrip("/")
    direct = {"fleet_only": True} if getattr(args, "fleet_only", False) else {}
    if direct and server != DEFAULT_SERVER:
        raise CliError("workspace pairing requires ccfleet.io")
    parsed_server = urllib.parse.urlsplit(server)
    local_http = (parsed_server.scheme == "http"
                  and parsed_server.hostname in ("127.0.0.1", "::1", "localhost"))
    if parsed_server.scheme != "https" and not local_http:
        raise CliError("--server must use https:// (http:// is allowed only on localhost)")
    pairing = args.code or prompt_pairing_code()
    workspace_pairing = bool(getattr(args, "workspace_pairing", False))
    prefixes = ("ccf_pair_", "ccf_enroll_") if direct and workspace_pairing else ("ccf_pair_",)
    if not pairing.startswith(prefixes):
        raise CliError("that does not look like a ccfleet pairing code")
    key_path, public_key = generate_key()
    public_path = key_path.with_suffix(".pub")
    answer: Optional[dict[str, Any]] = None
    final_key: Optional[Path] = None
    known_hosts: Optional[Path] = None
    old_profiles: list[dict[str, Any]] = []
    try:
        answer = api_json(
            server + "/api/cli/register", pairing,
            {"public_key": public_key,
             "device_name": args.name or "computer",
             **({"purpose": "antigravity-workspace"}
                if getattr(args, "workspace_pairing", False) else {})}, **direct)
        if bool(answer.get("workspace_only")) != bool(getattr(args, "workspace_pairing", False)):
            raise CliError("pairing is for a different client")
        needed = ("device_id", "device_token", "endpoint", "slot_id", "slot_name",
                  "user", "host_key")
        if any(not isinstance(answer.get(key), str) or not answer[key] for key in needed):
            raise CliError("ccfleet returned an incomplete device configuration")
        if direct and answer["endpoint"] != "wss://ccfleet.io/api/cli/connect":
            raise CliError("workspace pairing returned a different connection origin")
        device_id = answer["device_id"]
        final_key = home() / f"id_{device_id}"
        known_hosts = home() / f"known_hosts_{device_id}"
        alias = "ccfleet-" + answer["slot_id"]
        os.replace(key_path, final_key)
        os.chmod(final_key, 0o600)
        public_path.unlink(missing_ok=True)
        known_hosts.write_text(f"{alias} {answer['host_key']}\n")
        os.chmod(known_hosts, 0o600)

        config = load_config()
        # One active local installation per slot. Re-pairing this computer
        # replaces its local profile and best-effort revokes the superseded
        # device after the new profile is safely on disk.
        for old_id, old in list(config["devices"].items()):
            if old.get("slot_id") == answer["slot_id"]:
                if isinstance(old, dict):
                    old_profiles.append(old)
                config["devices"].pop(old_id)
        config["devices"][device_id] = {
            "device_id": device_id,
            "device_token": answer["device_token"],
            "endpoint": answer["endpoint"],
            "slot_id": answer["slot_id"],
            "slot_name": answer["slot_name"],
            "user": answer["user"],
            "key": str(final_key),
            "known_hosts": str(known_hosts),
            "host_alias": alias,
            "server": server,
        }
        if answer.get("gateway_available") is True:
            config["devices"][device_id]["gateway_available"] = True
        config["active"] = device_id
        save_config(config)
    except BaseException:
        if answer is not None:
            try:
                api_json(server + "/api/cli/revoke", answer.get("device_token", ""), {}, **direct)
            except (CliError, TypeError):
                pass
        for path in (key_path, public_path, final_key, known_hosts):
            if path is not None:
                path.unlink(missing_ok=True)
        raise
    for old in old_profiles:
        try:
            api_json(str(old.get("server") or server) + "/api/cli/revoke",
                     str(old.get("device_token") or ""), {}, **direct)
        except CliError:
            pass
        for field in ("key", "known_hosts"):
            raw_path = str(old.get(field) or "")
            if not raw_path:
                continue
            old_path = Path(raw_path)
            if old_path not in (final_key, known_hosts):
                try:
                    old_path.unlink(missing_ok=True)
                except OSError as exc:
                    print(f"Warning: could not remove old {field}: {exc}", file=sys.stderr)
    if getattr(args, "workspace_pairing", False):
        print(f"Connected to {answer['slot_name']} for Antigravity.")
    else:
        print(f"Connected to {answer['slot_name']}. Run ccfleet claude to open local Claude Code.")
    return 0


def choose_device(config: dict[str, Any], wanted: str = "") -> dict[str, Any]:
    devices = config["devices"]
    device_id = wanted or config.get("active") or ""
    if wanted and wanted not in devices:
        matches = [key for key, value in devices.items()
                   if wanted in (value.get("slot_id"), value.get("slot_name"))]
        device_id = matches[0] if len(matches) == 1 else ""
    device = devices.get(device_id)
    if not isinstance(device, dict):
        raise CliError("not connected; run ccfleet login with a code from your slot page")
    return device


def local_slot_choice(config: dict[str, Any], wanted: str = "") -> str:
    """A new explicit local choice is independent of the website's endpoint pool."""
    if wanted:
        return wanted
    choice = config.get("local_slot_choice")
    if choice is None:
        return ""
    if (not isinstance(choice, dict) or set(choice) != {"device_id", "slot_id", "slot_name"}
            or any(not isinstance(choice.get(name), str) or not choice[name]
                   for name in ("device_id", "slot_id", "slot_name"))
            or not re.fullmatch(r"[a-z0-9][a-z0-9_-]{1,63}", choice["slot_id"])
            or len(choice["slot_name"]) > 200
            or any(ord(char) < 32 or ord(char) == 127 for char in choice["slot_name"])):
        raise CliError("saved local slot choice is invalid; run ccfleet use SLOT")
    device = config["devices"].get(choice["device_id"])
    if not isinstance(device, dict):
        raise CliError("the selected local slot's authorization is no longer paired; "
                       "run ccfleet use SLOT")
    return choice["slot_id"]


def remember_local_slot(config: dict[str, Any], device: dict[str, Any], *,
                        slot_id: str = "", slot_name: str = "") -> None:
    config["active"] = device["device_id"]
    config["local_slot_choice"] = {"device_id": device["device_id"],
                                   "slot_id": slot_id or device["slot_id"],
                                   "slot_name": slot_name or device["slot_name"]}


def paired_slot_device(config: dict[str, Any], slot_id: str) -> Optional[dict[str, Any]]:
    """An endpoint slot ID cannot borrow a retired pairing's matching display name."""
    matches = [device for device in config["devices"].values()
               if isinstance(device, dict) and device.get("slot_id") == slot_id]
    if len(matches) > 1:
        raise CliError("that slot has ambiguous saved pairings; check Connected devices")
    return matches[0] if matches else None


def local_paired_device(config: dict[str, Any], wanted: str = "") -> dict[str, Any]:
    selected = local_slot_choice(config, wanted)
    if not wanted and "local_slot_choice" in config:
        device = paired_slot_device(config, selected)
        if device is None:
            raise CliError("the selected gateway slot has no paired Claude bridge")
        anchor = config["devices"][config["local_slot_choice"]["device_id"]]
        if _gateway_url(device.get("server")) != _gateway_url(anchor.get("server")):
            raise CliError("the saved local slot belongs to a different endpoint; "
                           "run ccfleet use SLOT to choose again")
        return device
    return choose_device(config, selected)


def local_route(config: dict[str, Any], wanted: str = "", transport: str = "auto", *,
                require_ready: bool = True, check_bridge: bool = True,
                canonical: bool = False) -> dict[str, Any]:
    """Choose a route before sending; errors never trigger a transport fallback."""
    selected = local_slot_choice(config, wanted)
    canonical = canonical or bool(not wanted and "local_slot_choice" in config)
    saved = load_gateway() if transport != "bridge" else None
    if saved:
        device = choose_device(config, saved["device_id"])
    elif canonical:
        device = paired_slot_device(config, selected)
        if device is None:
            raise CliError("the selected slot needs its existing HTTPS gateway; "
                           "it has no paired Claude bridge")
    else:
        device = choose_device(config, selected)
    if not wanted and "local_slot_choice" in config:
        anchor = config["devices"][config["local_slot_choice"]["device_id"]]
        if _gateway_url(device.get("server")) != _gateway_url(anchor.get("server")):
            raise CliError("the saved local slot belongs to a different endpoint; "
                           "run ccfleet use SLOT to choose again")
    profile = gateway_for_launch(config, device, transport)
    pinned = ""
    migration = device
    answer: dict[str, Any] = {}
    name = device.get("slot_name") or device["slot_id"]
    if profile is not None and selected:
        # Fresh endpoint names take precedence over a retired pairing's old name.
        answer = check_gateway(profile, require_ready=False)
        rows = answer.get("slots", [])
        matches = [row for row in rows if row.get("id") == selected]
        if not matches and not canonical:
            matches = [row for row in rows if row.get("name") == selected]
        if len(matches) > 1:
            raise CliError("that slot name is ambiguous; use its current slot ID")
        paired = None
        if matches:
            pinned = matches[0]["id"]
            name = matches[0].get("name") or pinned
            paired = paired_slot_device(config, pinned)
            migration = paired
        else:
            try:
                paired = (paired_slot_device(config, selected) if canonical
                          else choose_device(config, selected))
                if paired is None:
                    raise CliError("slot is not paired")
            except CliError:
                raise CliError("choose one of your endpoint's selected slots or an already "
                               "paired slot by its current name or ID") from None
            pinned = paired["slot_id"]
            name = paired.get("slot_name") or pinned
        if paired is not None:
            if _gateway_url(paired.get("server")) != profile["base_url"]:
                raise CliError("this slot belongs to a different endpoint")
            migration = paired
        if pinned not in profile["slot_ids"]:
            if not isinstance(answer.get("key"), dict):
                raise CliError("the gateway did not confirm its current slot selection; "
                               "no bridge route was started")
            if transport == "gateway":
                raise CliError("this slot is not selected for your gateway endpoint; "
                               "choose --transport auto for its paired Claude bridge")
            # This is an initial, authorized route choice, not recovery from an error.
            # A paired bridge always uses Claude; it cannot stand in for a Devin key.
            device, profile, pinned = paired, None, ""
    if profile is not None:
        answer = check_gateway(profile, pinned, require_ready=require_ready)
        if pinned and pinned not in profile["slot_ids"]:
            raise CliError("this slot is not selected for your gateway endpoint")
        if not pinned:
            rows = answer.get("slots", [])
            if len(profile["slot_ids"]) == 1:
                identifier = profile["slot_ids"][0]
                name = next((row.get("name") or identifier for row in rows
                             if row.get("id") == identifier), identifier)
            else:
                name = "configured slot pool"
    elif check_bridge:
        check_inference(device)
    return {"device": device, "gateway": profile, "slot_id": pinned,
            "migration_device": migration, "slot_name": name, "answer": answer,
            "provider": profile.get("provider", "anthropic") if profile else "anthropic",
            "transport": "gateway" if profile else "bridge"}


def print_local_route(route: dict[str, Any]) -> None:
    provider = "Devin" if route["provider"] == "devin" else "Claude / Anthropic"
    transport = "HTTPS gateway" if route["gateway"] is not None else "paired slot bridge"
    print(f"Selected route: {slot_label(route['slot_name'])} · {provider} · {transport}.",
          file=sys.stderr, flush=True)
    gateway = route["gateway"]
    if gateway is None:
        return
    if route["slot_id"]:
        print("Model route: one fixed selected account; automatic switching is disabled.\n"
              "This local slot pin overrides gateway pool routing. "
              "Run ccfleet use --pool to restore the pool.", file=sys.stderr, flush=True)
    elif len(gateway["slot_ids"]) == 1:
        print("Model route: one fixed selected account; automatic switching is disabled.",
              file=sys.stderr, flush=True)
    elif gateway["mode"] == "sticky":
        print("Model route: sticky. New conversations start with the first eligible slot; "
              "conversations keep the account that last succeeded when the client supplies "
