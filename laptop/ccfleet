              file=sys.stderr, flush=True)
    else:
        print("Model route: priority order for each request. "
              "Eligible failures can use the next slot.", file=sys.stderr, flush=True)
    print_gateway_order(gateway, route.get("answer", {}).get("slots", []),
                        {"devices": {"device": route["device"]}}, stream=sys.stderr,
                        overridden=bool(route["slot_id"]))


def frame(payload: bytes, opcode: int = 2) -> bytes:
    mask = os.urandom(4)
    body = bytearray(payload)
    for index in range(len(body)):
        body[index] ^= mask[index & 3]
    length = len(body)
    if length < 126:
        size = bytes((0x80 | length,))
    elif length <= 0xFFFF:
        size = bytes((0x80 | 126,)) + struct.pack(">H", length)
    else:
        size = bytes((0x80 | 127,)) + struct.pack(">Q", length)
    return bytes((0x80 | opcode,)) + size + mask + bytes(body)


class FrameReader:
    def __init__(self, sock: socket.socket, initial: bytes = b"") -> None:
        self.sock, self.buffer = sock, bytearray(initial)

    def take(self, size: int) -> bytes:
        while len(self.buffer) < size:
            data = self.sock.recv(max(64 * 1024, size - len(self.buffer)))
            if not data:
                raise EOFError
            self.buffer.extend(data)
        answer = bytes(self.buffer[:size])
        del self.buffer[:size]
        return answer

    def read(self) -> tuple[int, bytes]:
        first, second = self.take(2)
        if not first & 0x80 or first & 0x70 or second & 0x80:
            raise CliError("broker sent an invalid WebSocket frame")
        opcode, length = first & 0x0F, second & 0x7F
        if length == 126:
            length = struct.unpack(">H", self.take(2))[0]
        elif length == 127:
            length = struct.unpack(">Q", self.take(8))[0]
        if length > MAX_FRAME or (opcode >= 8 and length > 125):
            raise CliError("broker sent an oversized WebSocket frame")
        return opcode, self.take(length)


def open_websocket(endpoint: str, token: str) -> tuple[socket.socket, bytes]:
    endpoint = canonical_runtime_url(endpoint)
    parsed = urllib.parse.urlsplit(endpoint)
    local_ws = (parsed.scheme == "ws"
                and parsed.hostname in ("127.0.0.1", "::1", "localhost"))
    if (parsed.scheme != "wss" and not local_ws) or not parsed.hostname:
        raise CliError("saved broker endpoint is invalid")
    sock: Optional[socket.socket] = None
    deadline = time.monotonic() + 15

    def remaining() -> float:
        seconds = deadline - time.monotonic()
        if seconds <= 0:
            raise CliError("broker connection handshake timed out")
        return seconds

    try:
        port = parsed.port or (443 if parsed.scheme == "wss" else 80)
        raw = socket.create_connection((parsed.hostname, port), timeout=remaining())
        sock = raw
        if parsed.scheme == "wss":
            raw.settimeout(remaining())
            sock = ssl.create_default_context().wrap_socket(raw, server_hostname=parsed.hostname)
        # One deadline covers connection, TLS and HTTP Upgrade, including peers
        # that trickle headers slowly enough to avoid an inactivity timeout.
        key = base64.b64encode(os.urandom(16)).decode()
        path = urllib.parse.urlunsplit(("", "", parsed.path or "/", parsed.query, ""))
        host_name = f"[{parsed.hostname}]" if ":" in parsed.hostname else parsed.hostname
        host = host_name if parsed.port is None else f"{host_name}:{parsed.port}"
        request = (f"GET {path} HTTP/1.1\r\nHost: {host}\r\nUpgrade: websocket\r\n"
                   f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                   f"Sec-WebSocket-Version: 13\r\nAuthorization: Bearer {token}\r\n\r\n")
        sock.settimeout(remaining())
        sock.sendall(request.encode("ascii"))
        response = bytearray()
        while b"\r\n\r\n" not in response:
            sock.settimeout(remaining())
            chunk = sock.recv(4096)
            if not chunk:
                raise CliError("broker closed during WebSocket handshake")
            response.extend(chunk)
            if len(response) > 64 * 1024:
                raise CliError("broker sent an oversized WebSocket handshake")
        remaining()
        header, initial = bytes(response).split(b"\r\n\r\n", 1)
        lines = header.decode("iso-8859-1").split("\r\n")
        if not lines[0].startswith("HTTP/1.1 101 "):
            status = re.match(r"HTTP/1\.[01] ([1-5][0-9]{2})(?: |$)", lines[0])
            detail = " (HTTP " + status.group(1) + ")" if status else ""
            raise CliError("broker refused the WebSocket connection" + detail)
        headers: dict[str, str] = {}
        critical = {"upgrade", "connection", "sec-websocket-accept"}
        for line in lines[1:]:
            name, separator, value = line.partition(":")
            if not separator or not re.fullmatch(r"[!#$%&'*+.^_`|~0-9A-Za-z-]+", name):
                raise CliError("broker sent an invalid WebSocket handshake header")
            name = name.lower()
            if name in critical and name in headers:
                raise CliError("broker sent duplicate WebSocket handshake headers")
            headers[name] = value.strip()
        if (headers.get("upgrade", "").lower() != "websocket"
                or "upgrade" not in {part.strip().lower()
                                     for part in headers.get("connection", "").split(",")}
                or "sec-websocket-extensions" in headers or "sec-websocket-protocol" in headers):
            raise CliError("broker did not accept the requested WebSocket transport")
        expected = base64.b64encode(hashlib.sha1(key.encode() + WS_GUID).digest()).decode()
        if headers.get("sec-websocket-accept") != expected:
            raise CliError("broker WebSocket identity check failed")
        sock.settimeout(None)
        return sock, initial
    except CliError:
        if sock is not None:
            sock.close()
        raise
    except (OSError, UnicodeError, ValueError) as exc:
        if sock is not None:
            sock.close()
        raise CliError(f"could not open the broker connection: {exc}") from exc


def _proxy_frame(buffer: bytearray) -> Optional[tuple[int, int, int]]:
    """Inspect one bounded server frame without consuming a partial header."""
    if len(buffer) < 2:
        return None
    first, second = buffer[:2]
    if not first & 0x80 or first & 0x70 or second & 0x80:
        raise CliError("broker sent an invalid WebSocket frame")
    opcode, length, width = first & 0x0F, second & 0x7F, 2
    if length in (126, 127):
        width = 4 if length == 126 else 10
        if len(buffer) < width:
            return None
        length = struct.unpack("!H" if width == 4 else "!Q", buffer[2:width])[0]
    if length > MAX_FRAME or (opcode >= 8 and length > 125):
        raise CliError("broker sent an oversized WebSocket frame")
    if opcode not in (2, 8, 9, 10) or (opcode == 8 and length == 1):
        raise CliError("broker sent non-binary or invalid control data")
    return (opcode, width, length) if len(buffer) >= width + length else None


def _proxy_stream(sock: socket.socket, initial: bytes = b"", *,
                  input_fd: int = 0, output_fd: int = 1) -> int:
    """Own every TLS operation; bound both directions and preserve pipe backpressure.

    OpenSSH keeps the input pipe open until the transport ends. Its HUP is
    cancellation, including while queued bytes cannot be sent. poll observes
    that HUP without draining or forwarding a cancelled upload.
    """
    blocking: dict[int, bool] = {}
    outgoing: deque[bytes] = deque()
    queued = offset = 0
    received, output = bytearray(initial), bytearray()
    peer_closed = False
    read_wait, write_wait = select.POLLIN, select.POLLOUT
    retry_read = retry_write = False
    receive_limit = MAX_FRAME + 14

    def enqueue(payload: bytes, opcode: int = 2) -> None:
        nonlocal queued
        wire = frame(payload, opcode)
        limit = PROXY_OUTBOUND_LIMIT + (PROXY_CONTROL_RESERVE if opcode != 2 else 0)
        if queued + len(wire) > limit:
            raise CliError("broker control traffic exceeded the transport buffer limit")
        outgoing.append(wire)
        queued += len(wire)

    try:
        if len(received) > receive_limit:
            raise CliError("broker exceeded the transport buffer limit")
        socket_fd = sock.fileno()
        if input_fd == output_fd or socket_fd in (input_fd, output_fd):
            raise CliError("invalid broker transport descriptors")
        for descriptor in (input_fd, output_fd):
            blocking[descriptor] = os.get_blocking(descriptor)
            os.set_blocking(descriptor, False)
        sock.setblocking(False)
        output_watch = select.poll()
        output_watch.register(output_fd, select.POLLOUT)
        while True:
            # A completed frame can wait here while the SSH output pipe drains.
            output_blocked = False
            while received and not peer_closed:
                parsed = _proxy_frame(received)
                if parsed is None:
                    break
                opcode, width, length = parsed
                if opcode == 2 and len(output) + length > MAX_FRAME:
                    output_blocked = True
                    break
                payload = bytes(received[width:width + length])
                del received[:width + length]
                if opcode == 2:
                    output.extend(payload)
                elif opcode == 8:
                    peer_closed = True
                    received.clear()
                    outgoing.clear()
                    queued = offset = 0
                elif opcode == 9:
                    enqueue(payload, 10)
            if peer_closed and not output:
                return 0
            if not output:
                # macOS reports a lost pipe reader only when POLLOUT was
                # requested. Check without making an idle writable pipe spin
                # the main poller; its normal wait remains bounded below.
                output_state = dict(output_watch.poll(0)).get(output_fd, 0)
                if output_state & (select.POLLERR | select.POLLHUP | select.POLLNVAL):
                    raise CliError("SSH input closed during the broker stream")
            can_read = (not peer_closed and len(received) < receive_limit
                        and len(output) < MAX_FRAME and not output_blocked)
            can_input = (not peer_closed
                         and queued + PROXY_CHUNK_SIZE + 14 <= PROXY_OUTBOUND_LIMIT)
            poller = select.poll()
            poller.register(input_fd, select.POLLIN if can_input else 0)
            poller.register(output_fd, select.POLLOUT if output else 0)
            socket_events = (read_wait if can_read else 0) | (write_wait if outgoing else 0)
            if socket_events:
                poller.register(socket_fd, socket_events)
            # SSL may already hold decrypted bytes invisible to the OS poller.
            pending = can_read and read_wait == select.POLLIN and getattr(
                sock, "pending", lambda: 0)() > 0
            immediate = pending or (can_read and retry_read) or (outgoing and retry_write)
            ready = dict(poller.poll(0 if immediate else 250))
            if ready.get(input_fd, 0) & select.POLLHUP:
                return 0
            bad = select.POLLERR | select.POLLNVAL
            if ready.get(input_fd, 0) & bad:
                raise CliError("SSH output closed during the broker stream")
            if ready.get(output_fd, 0) & (bad | select.POLLHUP):
                raise CliError("SSH input closed during the broker stream")
            if ready.get(socket_fd, 0) & bad:
                raise CliError("broker transport closed unexpectedly")
            progressed = False
            if output and ready.get(output_fd, 0) & select.POLLOUT:
                try:
                    written = os.write(output_fd, output[:PROXY_CHUNK_SIZE])
                except (BlockingIOError, InterruptedError):
                    written = None
                if written is not None:
                    if written <= 0:
                        raise CliError("SSH input closed during the broker stream")
                    del output[:written]
                    progressed = True
            if can_input and ready.get(input_fd, 0) & select.POLLIN:
                try:
                    data = os.read(input_fd, PROXY_CHUNK_SIZE)
                except (BlockingIOError, InterruptedError):
                    data = None
                if data == b"":
                    return 0
                if data:
                    enqueue(data)
                    progressed = True
            socket_ready = ready.get(socket_fd, 0)
            if outgoing and (socket_ready & write_wait or retry_write):
                retry_write = False
                try:
                    sent = sock.send(memoryview(outgoing[0])[offset:])
                except ssl.SSLWantReadError:
                    write_wait = select.POLLIN
                except (ssl.SSLWantWriteError, BlockingIOError, InterruptedError):
                    write_wait = select.POLLOUT
                else:
                    if sent <= 0:
                        raise CliError("broker transport made no write progress")
                    offset += sent
                    if offset == len(outgoing[0]):
                        queued -= len(outgoing.popleft())
                        offset = 0
                    write_wait = select.POLLOUT
                    retry_read = read_wait == select.POLLOUT
                    progressed = True
            if can_read and (socket_ready & (read_wait | select.POLLHUP)
                             or pending or retry_read):
                retry_read = False
                try:
                    data = sock.recv(min(PROXY_CHUNK_SIZE, receive_limit - len(received)))
                except ssl.SSLWantWriteError:
                    read_wait = select.POLLOUT
                except (ssl.SSLWantReadError, BlockingIOError, InterruptedError):
                    read_wait = select.POLLIN
                else:
                    if not data:
                        if received:
                            raise CliError("broker closed during a WebSocket frame")
                        peer_closed = True
                        outgoing.clear()
                        queued = offset = 0
                    else:
                        received.extend(data)
                    read_wait = select.POLLIN
                    retry_write = write_wait == select.POLLIN
                    progressed = True
            if ready and not progressed:
                # A TLS want can outlast an OS readiness indication. Keep that
                # state without spinning while the opposite pipe is blocked.
                time.sleep(0.01)
    except (OSError, ValueError) as exc:
        raise CliError("broker transport failed; no connection was retried") from exc
    finally:
        for descriptor, original in blocking.items():
            with contextlib.suppress(OSError):
                os.set_blocking(descriptor, original)
        with contextlib.suppress(OSError):
            sock.close()


