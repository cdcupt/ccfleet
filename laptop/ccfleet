class CliError(RuntimeError):
    def __init__(self, message: str, status: Optional[int] = None, *, code: str = "") -> None:
        super().__init__(message)
        self.status = status
        self.code = code


def home() -> Path:
    return Path(os.environ.get("CCFLEET_HOME") or Path.home() / ".config" / "ccfleet")


def config_path() -> Path:
    return home() / "config.json"


def ensure_home() -> None:
    home().mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(home(), 0o700)


def load_config() -> dict[str, Any]:
    try:
        data = json.loads(config_path().read_text())
    except FileNotFoundError:
        return {"version": 1, "active": "", "devices": {}}
    except (OSError, json.JSONDecodeError) as exc:
        raise CliError(f"cannot read {config_path()}: {exc}") from exc
    if not isinstance(data, dict) or not isinstance(data.get("devices"), dict):
        raise CliError(f"{config_path()} is not a ccfleet configuration")
    return data


def save_config(config: dict[str, Any]) -> None:
    ensure_home()
    fd, temporary = tempfile.mkstemp(prefix=".config.", dir=home())
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as stream:
            json.dump(config, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, config_path())
        os.chmod(config_path(), 0o600)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        # A pairing/device secret belongs only to its configured endpoint.
        # urllib otherwise preserves Authorization when following redirects.
        return None


def api_json(url: str, token: str, payload: Optional[dict[str, Any]] = None,
             method: str = "POST") -> dict[str, Any]:
    body = json.dumps(payload).encode() if payload is not None else b""
    request = urllib.request.Request(
        url, data=body, method=method,
        headers={"Authorization": f"Bearer {token}",
                 "Content-Type": "application/json", "Accept": "application/json"})
    try:
        with urllib.request.build_opener(_NoRedirect()).open(request, timeout=20) as response:
            result = json.loads(response.read(256 * 1024).decode())
    except urllib.error.HTTPError as exc:
        try:
            why = json.loads(exc.read(64 * 1024).decode()).get("error")
        except (ValueError, UnicodeError):
            why = None
        raise CliError(str(why or f"server returned HTTP {exc.code}"), exc.code) from exc
    except (OSError, ValueError) as exc:
        raise CliError(f"could not reach ccfleet: {exc}") from exc
    if not isinstance(result, dict):
        raise CliError("ccfleet returned an invalid response")
    return result


def generate_key() -> tuple[Path, str]:
    if shutil.which("ssh-keygen") is None:
        raise CliError("OpenSSH is required (missing ssh-keygen)")
    ensure_home()
    path = home() / (".pairing-" + secrets.token_hex(8))
    proc = subprocess.run(
        ["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "ccfleet", "-f", str(path)],
        capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        raise CliError(proc.stderr.strip() or "ssh-keygen failed")
    os.chmod(path, 0o600)
    return path, path.with_suffix(".pub").read_text().strip()


def prompt_pairing_code() -> str:
    message = "Run setup in an interactive terminal to enter a hidden pairing code."
    try:
        # stdin is the installation script when invoked with curl | bash.
        # Probe the controlling terminal, not stdin, and forbid getpass fallback.
        descriptor = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
        try:
            if not os.isatty(descriptor):
                raise CliError(message)
        finally:
            os.close(descriptor)
        with warnings.catch_warnings():
            warnings.simplefilter("error", getpass.GetPassWarning)
            return getpass.getpass("Pairing code from your slot page: ").strip()
    except (OSError, EOFError, getpass.GetPassWarning) as exc:
        raise CliError(message) from exc


def cmd_login(args: argparse.Namespace) -> int:
    server = args.server.rstrip("/")
    parsed_server = urllib.parse.urlsplit(server)
    local_http = (parsed_server.scheme == "http"
                  and parsed_server.hostname in ("127.0.0.1", "::1", "localhost"))
    if parsed_server.scheme != "https" and not local_http:
        raise CliError("--server must use https:// (http:// is allowed only on localhost)")
    pairing = args.code or prompt_pairing_code()
    if not pairing.startswith("ccf_pair_"):
        raise CliError("that does not look like a ccfleet pairing code")
    key_path, public_key = generate_key()
    public_path = key_path.with_suffix(".pub")
    answer: Optional[dict[str, Any]] = None
    final_key: Optional[Path] = None
    known_hosts: Optional[Path] = None
    old_profiles: list[dict[str, Any]] = []
    try:
        answer = api_json(
            server + "/api/cli/register", pairing,
            {"public_key": public_key,
             "device_name": args.name or "computer"})
        needed = ("device_id", "device_token", "endpoint", "slot_id", "slot_name",
                  "user", "host_key")
        if any(not isinstance(answer.get(key), str) or not answer[key] for key in needed):
            raise CliError("ccfleet returned an incomplete device configuration")
        device_id = answer["device_id"]
        final_key = home() / f"id_{device_id}"
        known_hosts = home() / f"known_hosts_{device_id}"
        alias = "ccfleet-" + answer["slot_id"]
        os.replace(key_path, final_key)
        os.chmod(final_key, 0o600)
        public_path.unlink(missing_ok=True)
        known_hosts.write_text(f"{alias} {answer['host_key']}\n")
        os.chmod(known_hosts, 0o600)

        config = load_config()
        # One active local installation per slot. Re-pairing this computer
        # replaces its local profile and best-effort revokes the superseded
        # device after the new profile is safely on disk.
        for old_id, old in list(config["devices"].items()):
            if old.get("slot_id") == answer["slot_id"]:
                if isinstance(old, dict):
                    old_profiles.append(old)
                config["devices"].pop(old_id)
        config["devices"][device_id] = {
            "device_id": device_id,
            "device_token": answer["device_token"],
            "endpoint": answer["endpoint"],
            "slot_id": answer["slot_id"],
            "slot_name": answer["slot_name"],
            "user": answer["user"],
            "key": str(final_key),
            "known_hosts": str(known_hosts),
            "host_alias": alias,
            "server": server,
        }
        config["active"] = device_id
        save_config(config)
    except BaseException:
        if answer is not None:
            try:
                api_json(server + "/api/cli/revoke", answer.get("device_token", ""), {})
            except (CliError, TypeError):
                pass
        for path in (key_path, public_path, final_key, known_hosts):
            if path is not None:
                path.unlink(missing_ok=True)
        raise
    for old in old_profiles:
        try:
            api_json(str(old.get("server") or server) + "/api/cli/revoke",
                     str(old.get("device_token") or ""), {})
        except CliError:
            pass
        for field in ("key", "known_hosts"):
            raw_path = str(old.get(field) or "")
            if not raw_path:
                continue
            old_path = Path(raw_path)
            if old_path not in (final_key, known_hosts):
                try:
                    old_path.unlink(missing_ok=True)
                except OSError as exc:
                    print(f"Warning: could not remove old {field}: {exc}", file=sys.stderr)
    print(f"Connected to {answer['slot_name']}. Run ccfleet to open Claude Code.")
    return 0


def choose_device(config: dict[str, Any], wanted: str = "") -> dict[str, Any]:
    devices = config["devices"]
    device_id = wanted or config.get("active") or ""
    if wanted and wanted not in devices:
        matches = [key for key, value in devices.items()
                   if wanted in (value.get("slot_id"), value.get("slot_name"))]
        device_id = matches[0] if len(matches) == 1 else ""
    device = devices.get(device_id)
    if not isinstance(device, dict):
        raise CliError("not connected; run ccfleet login with a code from your slot page")
    return device


def frame(payload: bytes, opcode: int = 2) -> bytes:
    mask = os.urandom(4)
    body = bytearray(payload)
    for index in range(len(body)):
        body[index] ^= mask[index & 3]
    length = len(body)
    if length < 126:
        size = bytes((0x80 | length,))
    elif length <= 0xFFFF:
        size = bytes((0x80 | 126,)) + struct.pack(">H", length)
    else:
        size = bytes((0x80 | 127,)) + struct.pack(">Q", length)
    return bytes((0x80 | opcode,)) + size + mask + bytes(body)


class FrameReader:
    def __init__(self, sock: socket.socket, initial: bytes = b"") -> None:
        self.sock, self.buffer = sock, bytearray(initial)

    def take(self, size: int) -> bytes:
        while len(self.buffer) < size:
            data = self.sock.recv(max(64 * 1024, size - len(self.buffer)))
            if not data:
                raise EOFError
            self.buffer.extend(data)
        answer = bytes(self.buffer[:size])
        del self.buffer[:size]
        return answer

    def read(self) -> tuple[int, bytes]:
        first, second = self.take(2)
        if not first & 0x80 or first & 0x70 or second & 0x80:
            raise CliError("broker sent an invalid WebSocket frame")
        opcode, length = first & 0x0F, second & 0x7F
        if length == 126:
            length = struct.unpack(">H", self.take(2))[0]
        elif length == 127:
            length = struct.unpack(">Q", self.take(8))[0]
        if length > MAX_FRAME or (opcode >= 8 and length > 125):
            raise CliError("broker sent an oversized WebSocket frame")
        return opcode, self.take(length)


def open_websocket(endpoint: str, token: str) -> tuple[socket.socket, bytes]:
    parsed = urllib.parse.urlsplit(endpoint)
    local_ws = (parsed.scheme == "ws"
                and parsed.hostname in ("127.0.0.1", "::1", "localhost"))
    if (parsed.scheme != "wss" and not local_ws) or not parsed.hostname:
        raise CliError("saved broker endpoint is invalid")
    sock: Optional[socket.socket] = None
    try:
        port = parsed.port or (443 if parsed.scheme == "wss" else 80)
        raw = socket.create_connection((parsed.hostname, port), timeout=15)
        sock = raw
        if parsed.scheme == "wss":
            sock = ssl.create_default_context().wrap_socket(raw, server_hostname=parsed.hostname)
        # Keep the connect/TLS timeout through HTTP Upgrade. A healthy TCP peer
        # that never sends headers must not strand the local proxy indefinitely.
        key = base64.b64encode(os.urandom(16)).decode()
        path = urllib.parse.urlunsplit(("", "", parsed.path or "/", parsed.query, ""))
        host_name = f"[{parsed.hostname}]" if ":" in parsed.hostname else parsed.hostname
        host = host_name if parsed.port is None else f"{host_name}:{parsed.port}"
        request = (f"GET {path} HTTP/1.1\r\nHost: {host}\r\nUpgrade: websocket\r\n"
                   f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                   f"Sec-WebSocket-Version: 13\r\nAuthorization: Bearer {token}\r\n\r\n")
        sock.sendall(request.encode("ascii"))
        response = bytearray()
        while b"\r\n\r\n" not in response:
            chunk = sock.recv(4096)
            if not chunk:
                raise CliError("broker closed during WebSocket handshake")
            response.extend(chunk)
            if len(response) > 64 * 1024:
                raise CliError("broker sent an oversized WebSocket handshake")
        header, initial = bytes(response).split(b"\r\n\r\n", 1)
        lines = header.decode("iso-8859-1").split("\r\n")
        if not lines[0].startswith("HTTP/1.1 101 "):
            raise CliError("broker refused this device (" + lines[0] + ")")
        headers = {line.split(":", 1)[0].strip().lower(): line.split(":", 1)[1].strip()
                   for line in lines[1:] if ":" in line}
        expected = base64.b64encode(hashlib.sha1(key.encode() + WS_GUID).digest()).decode()
        if headers.get("sec-websocket-accept") != expected:
            raise CliError("broker WebSocket identity check failed")
        sock.settimeout(None)
        return sock, initial
    except CliError:
        if sock is not None:
            sock.close()
        raise
    except (OSError, UnicodeError, ValueError) as exc:
        if sock is not None:
            sock.close()
        raise CliError(f"could not open the broker connection: {exc}") from exc


def proxy(device: dict[str, Any]) -> int:
    sock, initial = open_websocket(device["endpoint"], device["device_token"])
    lock, stopped = threading.Lock(), threading.Event()

    def send(payload: bytes, opcode: int = 2) -> None:
        with lock:
            sock.sendall(frame(payload, opcode))

    def input_loop() -> None:
        try:
            while not stopped.is_set():
                data = os.read(0, 64 * 1024)
                if not data:
                    send(b"", 8)
                    return
                send(data)
        except OSError:
            pass
        finally:
            stopped.set()

    worker = threading.Thread(target=input_loop, name="ccfleet-proxy-input", daemon=True)
    worker.start()
    reader = FrameReader(sock, initial)
    try:
        while not stopped.is_set():
            opcode, payload = reader.read()
            if opcode == 2:
                os.write(1, payload)
            elif opcode == 8:
                break
            elif opcode == 9:
                send(payload, 10)
            elif opcode != 10:
                raise CliError("broker sent non-binary data")
    except EOFError:
        pass
    finally:
        stopped.set()
        try:
            sock.close()
        except OSError:
            pass
    return 0


def ssh_transport_command(device: dict[str, Any], *, tty: bool) -> list[str]:
    if shutil.which("ssh") is None:
        raise CliError("OpenSSH is required (missing ssh)")
    executable = str(Path(__file__).resolve())
    proxy_command = (f"{shlex.quote(sys.executable)} -I {shlex.quote(executable)} "
                     f"proxy --device {shlex.quote(device['device_id'])}")
    return [
        "ssh", "-tt" if tty else "-T", "-F", "/dev/null",
        "-o", f"ProxyCommand={proxy_command}",
        "-o", f"HostKeyAlias={device['host_alias']}",
        "-o", f"UserKnownHostsFile={device['known_hosts']}",
        "-o", "GlobalKnownHostsFile=/dev/null",
        "-o", "StrictHostKeyChecking=yes",
        "-o", "UpdateHostKeys=no",
        "-o", "IdentitiesOnly=yes",
        "-o", f"IdentityFile={device['key']}",
        "-o", "PasswordAuthentication=no",
        "-o", "KbdInteractiveAuthentication=no",
        "-o", "BatchMode=yes",
        "-o", "ClearAllForwardings=yes",
        "-o", "ForwardAgent=no",
        "-o", "ForwardX11=no",
        "-o", "PermitLocalCommand=no",
        "-o", "ServerAliveInterval=15",
        "-o", "ServerAliveCountMax=2",
        "-o", "ConnectTimeout=10",
        f"{device['user']}@{device['host_alias']}",
    ]


def ssh_command(device: dict[str, Any], session: str = "ccfleet",
                mode: str = "bypassPermissions", action: str = "open",
                model: str = "opus", effort: str = "max") -> list[str]:
    return [*ssh_transport_command(device, tty=True),
            "ccfleet-session", action, session, mode, model, effort]


def cmd_attach(args: argparse.Namespace) -> int:
    device = choose_device(load_config(), args.slot)
    failed_since: Optional[float] = None
    attempt = 0
    while True:
        run_started = time.monotonic()
        try:
            code = subprocess.call(ssh_command(
                device, args.session, args.mode, args.action, args.model, args.effort))
        except KeyboardInterrupt:
            return 130
        if code == 0 or args.no_reconnect or code != 255:
            return code
        now = time.monotonic()
        # A connection that stayed up for a minute starts a fresh retry window
        # when it is later lost. Measuring from the original `ccfleet` launch
        # made every session older than ten minutes skip reconnection entirely.
        if failed_since is None or now - run_started >= 60:
            failed_since = now
            attempt = 0
        if args.reconnect_for <= 0 or now - failed_since >= args.reconnect_for:
            return code
        delay = min(10, 1 + attempt * 2,
                    max(0, args.reconnect_for - (now - failed_since)))
        attempt += 1
        print(f"\nConnection lost; reconnecting to {device['slot_name']} in {delay}s "
              "(Ctrl-C to stop)…", file=sys.stderr)
        try:
            time.sleep(delay)
        except KeyboardInterrupt:
            return 130


def packaged_helper(name: str, digest: str) -> Any:
    """Load the exact helper shipped with this client, never from the project."""
    executable = Path(__file__).resolve()
    candidates = [
        executable.parent / f"ccfleet-{name.replace('_', '-')}-{digest}.py",
        executable.parent.parent / "ccfleet_agent" / f"{name}.py",
    ]
    for candidate in candidates:
        if not candidate.is_file() or candidate.is_symlink():
            continue
        raw = candidate.read_bytes()
        if hashlib.sha256(raw).hexdigest() != digest:
            continue
        spec = importlib.util.spec_from_file_location("_ccfleet_" + name, candidate)
        if spec is not None and spec.loader is not None:
            module = importlib.util.module_from_spec(spec)
            sys.modules[spec.name] = module
            # Execute exactly the verified bytes. SourceFileLoader may reopen
            # a changed file or use an unchecked bytecode cache.
            exec(compile(raw, str(candidate), "exec"), module.__dict__)
            return module
    raise CliError("project helper is missing or mismatched; rerun the CC Fleet installer")


def project_files() -> Any:
    return packaged_helper("project_files", PROJECT_FILES_SHA256)


def live_files() -> Any:
    return packaged_helper("live_files", LIVE_FILES_SHA256)


def live_client() -> Any:
    return packaged_helper("live_client", LIVE_CLIENT_SHA256)


def inference_client() -> Any:
    return packaged_helper("inference_client", INFERENCE_CLIENT_SHA256)


def project_environment() -> dict[str, str]:
    # Needed only for locating this computer's pairing. None of these are sent
    # via SSH SendEnv: -F /dev/null excludes all user/system SSH configuration.
    env = {"PATH": os.defpath, "HOME": str(Path.home()), "TERM": "xterm-256color",
           "LANG": "C", "LC_ALL": "C", "TZ": "UTC",
           "CCFLEET_HOME": str(home())}
    return env


def project_rpc(device: dict[str, Any], operation: str, *, _timeout: float = 90,
                **fields: Any) -> dict[str, Any]:
    if not 0 < _timeout <= 90:
        raise CliError("invalid project connection timeout")
    payload = json.dumps({"version": 1, "operation": operation, **fields},
                         ensure_ascii=False, separators=(",", ":")).encode()
    if len(payload) > PROJECT_MAX_FRAME:
        raise CliError("project transfer exceeds the 32 MiB protocol limit")
    command = [*ssh_transport_command(device, tty=False), "ccfleet-project-v1"]
    process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, env=project_environment())
    expired = threading.Event()

    def timeout() -> None:
        expired.set()
        if process.poll() is None:
            process.kill()

    timer = threading.Timer(_timeout, timeout)
    timer.daemon = True
    timer.start()

    def send() -> None:
        try:
            process.stdin.write(struct.pack("!I", len(payload)) + payload)
            process.stdin.flush()
        except (OSError, ValueError):
            pass
        finally:
            try:
                process.stdin.close()
            except OSError:
                pass

    writer = threading.Thread(target=send, daemon=True)
    writer.start()

    def read_exact(size: int) -> bytes:
        data = bytearray()
        while len(data) < size:
            chunk = process.stdout.read(size - len(data))
            if not chunk:
                raise CliError("project connection ended; check your network, pairing, "
                               "and that the node has been upgraded", code="connection")
            data.extend(chunk)
        return bytes(data)

    try:
        size = struct.unpack("!I", read_exact(4))[0]
        if not 0 < size <= PROJECT_MAX_FRAME:
            raise CliError("invalid project response size")
        raw = read_exact(size)
        if process.stdout.read(1):
            raise CliError("unexpected trailing project response")
        code = process.wait(timeout=5)
        def unique_fields(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
            result: dict[str, Any] = {}
            for name, value in pairs:
                if name in result:
                    raise ValueError("duplicate project response field")
                result[name] = value
            return result

        answer = json.loads(raw, object_pairs_hook=unique_fields)
        if (not isinstance(answer, dict) or type(answer.get("version")) is not int
                or answer["version"] != 1 or type(answer.get("ok")) is not bool):
            raise CliError("invalid project response")
        if not answer["ok"]:
            messages = {
                "disabled": "project access is not enabled for this slot; contact your operator",
                "account_unavailable": "your slot needs its original Claude sign-in; "
                                       "open your slot page",
                "conflict": "the project changed since the last transfer; review and pull "
                            "before retrying",
                "busy": "finish the project's Claude sessions with /exit before pushing; "
                        "detaching leaves them running",
                "invalid": "the slot rejected the project request or a protected file",
            }
            error = answer.get("error")
            raise CliError(messages.get(error, "project operation failed safely")
                           if isinstance(error, str) else "project operation failed safely",
                           code=error if isinstance(error, str) else "invalid")
        if code != 0:
            raise CliError("project connection ended without a confirmed result", code="connection")
        allowed = {"status": {"ready", "protocol"}, "list": {"projects"},
                   "read": {"files", "manifest"}, "write": {"files", "manifest", "backup"}}
        if set(answer) - {"version", "ok"} - allowed[operation]:
            raise CliError("unrecognized project response fields; update CC Fleet")
        return answer
    except (ValueError, RecursionError, subprocess.SubprocessError) as exc:
        raise CliError("invalid or incomplete project response") from exc
    finally:
        timer.cancel()
        if process.poll() is None:
            process.kill()
        process.wait(timeout=5)
        writer.join(timeout=2)
        process.stdout.close()
        if expired.is_set():
            raise CliError("project connection timed out; retry after checking your network",
                           code="connection")


def require_project_readiness(answer: dict[str, Any]) -> None:
    if (answer.get("ready") is not True or type(answer.get("protocol")) is not int
            or answer["protocol"] != 1):
        raise CliError("slot project access is not ready or uses an unsupported protocol")


def wait_for_setup(device: dict[str, Any], *, newly_paired: bool) -> None:
    deadline = time.monotonic() + (SETUP_WAIT_SECONDS if newly_paired else 25)
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise CliError("paired, but slot readiness is not yet confirmed; your pairing is "
                           "saved. Rerun the same setup command; do not pair again")
        try:
            check_inference(device, timeout=min(25, remaining))
            return
        except CliError as exc:
            if not newly_paired or exc.code != "connection":
                raise CliError(f"pairing kept; readiness check failed: {exc}. "
                               "The old setup has not been removed") from exc
        remaining = deadline - time.monotonic()
        if remaining > 0:
            print("Paired. Waiting for the slot to accept this computer's key...",
                  file=sys.stderr, flush=True)
            time.sleep(min(5, remaining))


def cmd_setup(args: argparse.Namespace) -> int:
    for executable in ("ssh", "ssh-keygen"):
        if shutil.which(executable) is None:
            raise CliError(f"OpenSSH is required (missing {executable})")
    project_files()  # Verify the installed helper; never scan a project here.
    live_files()
    live_client()
    inference_client()
    find_local_claude()
    config = load_config()
    newly_paired = not config["devices"]
    if newly_paired:
        if args.slot:
            raise CliError("--slot selects an already paired slot; omit it for first setup. "
                           "Your pairing code determines the new slot")
        print("Open your CC Fleet slot page and choose Connect this computer.\n"
              f"{args.server.rstrip('/')}/account\n"
              "Paste the fresh pairing code below; it will not be displayed.", flush=True)
        # Register once only. A lost response can consume a single-use code;
        # never retry registration or silently replace a paired computer.
        cmd_login(argparse.Namespace(server=args.server, code="", name=args.name))
        config = load_config()
    device = choose_device(config, args.slot)
    required = ("device_id", "device_token", "endpoint", "slot_id", "slot_name", "user",
                "key", "known_hosts", "host_alias", "server")
    if any(not isinstance(device.get(name), str) or not device[name] for name in required):
        raise CliError("saved pairing is incomplete; configuration was left unchanged. "
                       "Check Connected devices on your slot page before pairing again")
    if any(not Path(device[name]).is_file() for name in ("key", "known_hosts")):
        raise CliError("a saved pairing key or host pin is missing; configuration was left "
                       "unchanged. Check Connected devices before pairing again")
    if not newly_paired:
        print(f"Already paired with {device['slot_name']}; keeping this device and its history.")
    print("Checking the slot without uploading files or making a model request...", flush=True)
    wait_for_setup(device, newly_paired=newly_paired)
    retire_live_grants(device, yes=getattr(args, "yes", False))
    if args.slot and config.get("active") != device["device_id"]:
        # Persist an explicitly selected default only after it has passed checks.
        config = load_config()
        if device["device_id"] not in config["devices"]:
            raise CliError("pairing changed during setup; rerun setup")
        config["active"] = device["device_id"]
        save_config(config)
    print(f"Ready: {device['slot_name']}. Pairing and local Claude relay verified.\n"
          "No project was uploaded and no Claude session was started.")
    return 0


@contextlib.contextmanager
def project_lock():
    ensure_home()
    path = home() / "projects.lock"
    fd = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise CliError("another project operation is running on this computer") from exc
        yield
    finally:
        os.close(fd)


def selected_project(raw: str) -> Path:
    path = Path(raw).expanduser().resolve(strict=True)
    personal = Path.home().resolve()
    if not path.is_dir():
        raise CliError("--project must be an existing directory")
    if path == Path(path.anchor) or personal == path or personal.is_relative_to(path):
        raise CliError("select a project directory, not your home or a filesystem root")
    sensitive = (".ssh", ".aws", ".azure", ".config", ".claude", ".codex", ".agents",
                 ".gnupg", ".kube", "Library", ".local/share", ".password-store")
    if any(path.is_relative_to((personal / name).resolve()) for name in sensitive):
        raise CliError("select source code, not a personal credential or application directory")
    if home().resolve().is_relative_to(path):
        raise CliError("the selected project contains your CC Fleet configuration")
    return path


def project_record(device: dict[str, Any], root: Path,
                   remote_project: str = "") -> tuple[str, dict[str, Any]]:
    key = hashlib.sha256((device["slot_id"] + "\0" + str(root)).encode()).hexdigest()
    config = load_config()
    projects = config.get("projects", {})
    if not isinstance(projects, dict):
        raise CliError("invalid local project configuration")
    record = projects.get(key)
    if record is not None:
        if (not isinstance(record, dict)
                or not PROJECT_RE.fullmatch(str(record.get("id", "")))):
            raise CliError("invalid local project tracking record")
        if remote_project and record["id"] != remote_project:
            raise CliError("this directory already tracks another remote project; "
                           "use a separate local directory")
    else:
        record = {"id": remote_project or secrets.token_hex(16), "base": {},
                  "shared": False, "last_session": "main"}
    return key, dict(record)


def save_project_record(key: str, record: dict[str, Any]) -> None:
    config = load_config()
    config.setdefault("projects", {})[key] = record
    save_config(config)


def safe_display(value: str) -> str:
    return "".join(c if c in "\n\t" or not unicodedata.category(c).startswith("C")
                   else ascii(c)[1:-1] for c in value)


def confirm_project(message: str, yes: bool) -> None:
    if yes:
        return
    if not sys.stdin.isatty():
        raise CliError("review the project interactively, or explicitly pass --yes")
    if input(message + " [y/N] ").strip().lower() not in ("y", "yes"):
        raise CliError("cancelled; no project files were changed")


def print_project_changes(helper: Any, before: dict[str, Any], after: dict[str, Any],
                          *, contents: bool = False) -> None:
    delta = helper.changes(helper.manifest(before), helper.manifest(after))
    if not delta:
        print("No file changes.")
        return
    for change in delta:
        path = change["path"]
        print(f"{change['status']:8} {json.dumps(path, ensure_ascii=True)}")
        if not contents:
            continue
        old = base64.b64decode(before[path]["data"]) if path in before else b""
        new = base64.b64decode(after[path]["data"]) if path in after else b""
        if max(len(old), len(new)) > 128 * 1024:
            print(f"  large file: {len(old)} -> {len(new)} bytes; textual diff omitted")
            continue
        try:
            old_text, new_text = old.decode("utf-8"), new.decode("utf-8")
            if "\0" in old_text or "\0" in new_text:
                raise UnicodeError()
        except UnicodeError:
            print(f"  binary: {len(old)} -> {len(new)} bytes")
            continue
        if max(old_text.count("\n"), new_text.count("\n")) > 2000:
            print("  long text: textual diff omitted; review the slot file before applying")
            continue
        lines = list(difflib.unified_diff(old_text.splitlines(), new_text.splitlines(),
                                         fromfile="local", tofile="slot", lineterm=""))
        for line in lines[:200]:
            print(safe_display(line))
        if len(lines) > 200:
            print("  ... diff truncated; --yes explicitly accepts all listed changes")


def remote_snapshot(helper: Any, answer: dict[str, Any]) -> dict[str, Any]:
    files = helper.validate_snapshot(answer.get("files"))
    if helper.manifest(files) != helper.validate_manifest(answer.get("manifest")):
        raise CliError("slot returned an inconsistent project snapshot")
    return files


def merge_project(helper: Any, base: dict[str, Any], local: dict[str, Any],
                  remote: dict[str, Any]) -> dict[str, Any]:
    baseline = helper.validate_manifest(base)
    ours, theirs = helper.manifest(local), helper.manifest(remote)
    merged = dict(local)
    conflicts = []
    for change in helper.changes(baseline, theirs):
        path = change["path"]
        if ours.get(path) not in (baseline.get(path), theirs.get(path)):
            conflicts.append(path)
        elif path in remote:
            merged[path] = remote[path]
        else:
            merged.pop(path, None)
    if conflicts:
        names = ", ".join(json.dumps(p, ensure_ascii=True) for p in conflicts[:10])
        raise CliError("local and slot edits conflict; nothing was applied: " + names)
    return merged


def validate_project_args(args: argparse.Namespace) -> None:
    if args.remote_project and not PROJECT_RE.fullmatch(args.remote_project):
        raise CliError("--remote-project must be the 32-character ID from ccfleet project list")
    if getattr(args, "print_prompt", None) is not None or getattr(args, "fork_session", False):
        raise CliError("the local-agent relay has been retired; use named slot sessions "
                       "with --new --name NAME, then use Claude's own conversation controls")
    if getattr(args, "model", None) is not None and not MODEL_RE.fullmatch(args.model):
        raise CliError("invalid model name")
    for value in (getattr(args, "name", ""), getattr(args, "resume", "")):
        if value and not SESSION_RE.fullmatch(value):
            raise CliError("remote session names use 1-32 letters, digits, underscores or hyphens")
    if getattr(args, "reconnect_for", 0) < 0:
        raise CliError("--reconnect-for cannot be negative")


def validate_project_listing(answer: dict[str, Any]) -> list[dict[str, Any]]:
    projects = answer.get("projects")
    if not isinstance(projects, list) or len(projects) > 1000:
        raise CliError("invalid project listing")
    seen = set()
    for project in projects:
        if (not isinstance(project, dict) or set(project) != {"project", "sessions"}
                or not isinstance(project["project"], str)
                or not PROJECT_RE.fullmatch(project["project"]) or project["project"] in seen):
            raise CliError("invalid project listing")
        seen.add(project["project"])
        sessions = project["sessions"]
        if not isinstance(sessions, list) or len(sessions) > 1000 or any(
                not isinstance(name, str) or not SESSION_RE.fullmatch(name) for name in sessions):
            raise CliError("invalid project session listing")
    return projects


def cmd_project(args: argparse.Namespace) -> int:
    validate_project_args(args)
    helper = project_files()
    device = choose_device(load_config(), args.slot)
    if args.project_action == "list":
        answer = project_rpc(device, "list")
        for project in validate_project_listing(answer):
            identifier = project.get("project", "")
            if not isinstance(identifier, str) or not PROJECT_RE.fullmatch(identifier):
                raise CliError("invalid project listing")
            sessions = project.get("sessions", [])
            if not isinstance(sessions, list) or any(
                    not isinstance(name, str) or not SESSION_RE.fullmatch(name)
                    for name in sessions):
                raise CliError("invalid project session listing")
            print(f"{identifier}  sessions: {', '.join(sessions) or '(none)'}")
        return 0
    root = selected_project(args.project)
    with project_lock():
        key, record = project_record(device, root, args.remote_project)
        local = helper.snapshot(root)
        if args.project_action == "status":
            label = record["id"] if record["shared"] else "not yet shared"
            print(f"Project ID: {label}\nSelected files: {len(local)}")
            print("Hard exclusions include credentials, VCS metadata, symlinks and build outputs.")
            for change in helper.changes(helper.validate_manifest(record["base"]),
                                         helper.manifest(local)):
                print(f"{change['status']:8} {json.dumps(change['path'], ensure_ascii=True)}")
            return 0
        if args.project_action == "push":
            if not local and not record["shared"]:
                raise CliError("no shareable project files were found")
            print(f"Share {len(local)} selected files with slot {device['slot_name']}.")
            for change in helper.changes(helper.validate_manifest(record["base"]),
                                         helper.manifest(local)):
                print(f"{change['status']:8} {json.dumps(change['path'], ensure_ascii=True)}")
            print("Selected file contents may reach Anthropic. No laptop environment is uploaded.")
            confirm_project("Upload this snapshot?", args.yes)
            # Save the opaque destination before sending so a lost response
            # cannot leave an undiscoverable remote project.
            save_project_record(key, record)
            reply = project_rpc(device, "write", project=record["id"],
                                files=local, expected=record["base"])
            remote = remote_snapshot(helper, reply)
            if helper.manifest(remote) != helper.manifest(local):
                raise CliError("slot did not confirm the uploaded snapshot")
            record.update(base=helper.manifest(remote), shared=True)
            save_project_record(key, record)
            print("Uploaded. Claude and all project tools run on the slot.")
            return 0
        remote = remote_snapshot(helper, project_rpc(device, "read", project=record["id"]))
        merged = merge_project(helper, record["base"], local, remote)
        print_project_changes(helper, local, merged, contents=True)
        if args.project_action == "diff":
            return 0
        if helper.manifest(local) != helper.manifest(merged):
            confirm_project("Apply these slot changes to this local project?", args.yes)
            backup = home() / "project-backups" / record["id"] / secrets.token_hex(8)
            helper.apply_snapshot(root, merged, helper.manifest(local), backup)
            print(f"Applied with recoverable backups in {backup}.")
        record.update(base=helper.manifest(remote), shared=True)
        save_project_record(key, record)
    return 0


def project_sessions(device: dict[str, Any], identifier: str) -> list[str]:
    answer = project_rpc(device, "list")
    for project in validate_project_listing(answer):
        if project.get("project") == identifier:
            sessions = project.get("sessions")
            if not isinstance(sessions, list) or any(
                    not isinstance(name, str) or not SESSION_RE.fullmatch(name)
                    for name in sessions):
                raise CliError("invalid project session listing")
            return sessions
    return []


def attach_project(device: dict[str, Any], identifier: str, session: str,
                   args: argparse.Namespace) -> int:
    action = "new" if args.new_session else "open"
    failed_since: Optional[float] = None
    attempt = 0
    while True:
        command = [*ssh_transport_command(device, tty=True), "ccfleet-project-session-v1",
                   identifier, action, session, args.mode, args.model or "opus",
                   args.effort or "max"]
        started = time.monotonic()
        try:
            code = subprocess.call(command, env=project_environment())
        except KeyboardInterrupt:
            return 130
        if code != 255 or args.no_reconnect:
            return code
        now = time.monotonic()
        if failed_since is None or now - started >= 60:
            failed_since, attempt = now, 0
        if now - failed_since >= args.reconnect_for:
            return code
        delay = min(10, 1 + attempt * 2, args.reconnect_for - (now - failed_since))
        print(f"Connection lost; reattaching to the same slot session in {delay}s...",
              file=sys.stderr)
        time.sleep(delay)
        action, attempt = "open", attempt + 1


def cmd_snapshot(args: argparse.Namespace) -> int:
    args.mode = args.mode or "manual"
    validate_project_args(args)
    helper = project_files()
    device = choose_device(load_config(), args.slot)
    root = selected_project(args.project)
    answer = project_rpc(device, "status")
    require_project_readiness(answer)
    if args.check:
        print("Ready: project connector and slot-native Claude access.\n"
              "No project files, laptop environment, or model request were sent.")
        return 0
    with project_lock():
        key, record = project_record(device, root, args.remote_project)
        local = helper.snapshot(root)
        if not record["shared"]:
            if args.remote_project:
                raise CliError("first review and pull this existing project with "
                               "ccfleet project pull --remote-project ID --project PATH")
            if not local:
                raise CliError("no shareable project files were found")
            print(f"First-time sharing: {len(local)} files with slot {device['slot_name']}.")
            for path in sorted(local):
                print("  " + json.dumps(path, ensure_ascii=True))
            print("Credential/VCS/build files are excluded. "
                  "Selected contents may reach Anthropic.\n"
                  "Claude runs only on the slot. Local files are not automatically overwritten.")
            confirm_project("Share this selected project?", args.yes)
            save_project_record(key, record)
            reply = project_rpc(device, "write", project=record["id"],
                                files=local, expected=record["base"])
            remote = remote_snapshot(helper, reply)
            if helper.manifest(remote) != helper.manifest(local):
                raise CliError("slot did not confirm the uploaded snapshot")
            record.update(base=helper.manifest(remote), shared=True)
            save_project_record(key, record)
        elif helper.manifest(local) != helper.validate_manifest(record["base"]):
            if args.resume is None and not args.continue_session:
                raise CliError("local files changed; run ccfleet project push first, "
                               "or use --resume to continue the existing slot workspace")
            print("Local changes are not uploaded; continuing the existing slot workspace.",
                  file=sys.stderr)
        session = args.name or record.get("last_session", "main")
        if args.resume is not None:
            available = project_sessions(device, record["id"])
            if args.resume:
                if args.resume not in available:
                    raise CliError("that project session is not running; use --new --name NAME")
                session = args.resume
            else:
                if not available:
                    raise CliError("no running project sessions; use --new --name NAME")
                for number, name in enumerate(available, 1):
                    print(f"{number}. {name}")
                if not sys.stdin.isatty():
                    raise CliError("choose a session explicitly with --resume NAME")
                selection = input("Session number: ").strip()
                if not selection.isdigit() or not 1 <= int(selection) <= len(available):
                    raise CliError("invalid session selection")
                session = available[int(selection) - 1]
        elif args.new_session and not args.name:
            session = "s-" + secrets.token_hex(4)
        if not isinstance(session, str) or not SESSION_RE.fullmatch(session):
            raise CliError("invalid saved project session")
        record["last_session"] = session
        save_project_record(key, record)
    print(f"Slot project: {record['id']} / session {session}\n"
          "Claude, shell commands and model connections run on the slot.\n"
          "After work: ccfleet project diff, then ccfleet project pull to review/apply changes.",
          file=sys.stderr)
    return attach_project(device, record["id"], session, args)


def live_control(device: dict[str, Any], project: str, action: str = "status", *,
                 _timeout: float = 30) -> dict[str, Any]:
    if not PROJECT_RE.fullmatch(project) or action not in {"status", "stop"}:
        raise CliError("invalid live-folder control")
    command = [*ssh_transport_command(device, tty=False), f"ccfleet-live-{action}-v1", project]
    try:
        result = subprocess.run(command, input=b"", capture_output=True,
                                env=project_environment(), timeout=_timeout)
        import io
        answer = live_client().read_frame(io.BytesIO(result.stdout))
    except (OSError, EOFError, ValueError, subprocess.SubprocessError) as exc:
        raise CliError("live folder connection is unavailable; check pairing and the node upgrade",
                       code="connection") from exc
    if result.returncode != 0 or answer.get("ok") is not True or answer.get("version") != 1:
        error = answer.get("error")
        messages = {"disabled": "live folder access is not enabled on this slot",
                    "account_unavailable": "slot sign-in is unavailable; use your slot page",
                    "stale": "an old folder link needs --reset-link before it can restart",
                    "busy": "the folder link is busy; retry after it stops"}
        raise CliError(messages.get(error, "live folder operation failed safely"),
                       code=error if isinstance(error, str) else "invalid")
    return answer


def live_directory(identifier: str) -> Path:
    if not PROJECT_RE.fullmatch(identifier):
        raise CliError("invalid local live-folder identifier")
    return home() / "live" / identifier


def live_protected(root: Path, *modules: Any) -> list[Path]:
    """Control credentials/code stay outside the remote filesystem authority."""
    result = [home(), Path(__file__), Path(sys.executable),
              Path(sys.prefix), Path(sys.base_prefix)]
    for module in modules:
        result.append(Path(module.__file__))
    for device in load_config()["devices"].values():
        if not isinstance(device, dict):
            raise CliError("invalid saved pairing")
        for field in ("key", "known_hosts"):
            value = device.get(field)
            if not isinstance(value, str) or not value:
                raise CliError("invalid saved pairing paths")
            result.append(Path(value))
    protected = []
    for path in result:
        for candidate in (Path(os.path.abspath(path)), path.resolve()):
            if candidate == root or root.is_relative_to(candidate):
                raise CliError("CC Fleet's own control directory cannot be shared")
            if candidate.is_relative_to(root):
                protected.append(candidate)
    return protected


def live_record(device: dict[str, Any], root: Path) -> tuple[str, dict[str, Any]]:
    key = hashlib.sha256((device["device_id"] + "\0" + str(root)).encode()).hexdigest()
    records = load_config().get("live_folders", {})
    if not isinstance(records, dict):
        raise CliError("invalid live-folder configuration")
    record = records.get(key)
    if record is None:
        record = {"id": secrets.token_hex(16), "root": str(root),
                  "device": device["device_id"], "trusted": False, "last_session": "main"}
    if (not isinstance(record, dict) or not PROJECT_RE.fullmatch(str(record.get("id", "")))
            or record.get("root") != str(root) or record.get("device") != device["device_id"]):
        raise CliError("invalid live-folder record")
    return key, dict(record)


def save_live_record(key: str, record: dict[str, Any]) -> None:
    config = load_config()
    config.setdefault("live_folders", {})[key] = record
    save_config(config)


def stop_local_connector(identifier: str) -> None:
    helper = live_client()
    directory = live_directory(identifier)
    try:
        helper.control(directory, "stop")
    except helper.ControlError:
        # The controller can close while the resident is still tearing down.
        # Neither EOF nor a timeout proves that filesystem access has ended.
        pass
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        if helper.stopped(directory):
            return
        time.sleep(0.2)
    raise CliError("could not confirm the old local folder connector stopped; "
                   "migration is incomplete. Wait a moment and rerun setup")


def cmd_live_serve(args: argparse.Namespace) -> int:
    records = load_config().get("live_folders", {})
    record = next((value for value in records.values()
                   if isinstance(value, dict) and value.get("id") == args.project_id), None)
    if not record or record.get("trusted") is not True:
        raise CliError("folder sharing has not been approved")
    device = choose_device(load_config(), record["device"])
    root = Path(record["root"]).resolve(strict=True)
    if not root.is_dir():
        raise CliError("shared folder is unavailable")
    files, connector = live_files(), live_client()
    instance = secrets.token_hex(16)
    server = files.SFTPServer(root, protected=live_protected(root, files, connector))
    command = [*ssh_transport_command(device, tty=False), "ccfleet-live-v1",
               record["id"], instance]

    def paired() -> bool:
        try:
            return load_config()["devices"].get(device["device_id"]) == device
        except (CliError, OSError):
            return False

    return connector.run(live_directory(record["id"]), instance, server,
                         lambda: subprocess.Popen(command, stdin=subprocess.PIPE,
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             env=project_environment()), check_pairing=paired)


def start_local_connector(identifier: str) -> None:
    helper = live_client()
    directory = live_directory(identifier)
    existing = helper.control(directory, "status")
    child = None
    if not existing:
        child = subprocess.Popen([sys.executable, "-I", str(Path(__file__).resolve()),
                                  "live-serve", "--project-id", identifier],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True,
                                 env=project_environment())
    deadline = time.monotonic() + 60
    while time.monotonic() < deadline:
        state = helper.control(directory, "status")
        if state.get("connected") is True:
            return
        if state.get("error") in {
                "stale", "protocol", "disabled", "account_unavailable", "unavailable"}:
            break
        if child is not None and child.poll() is not None:
            break
        time.sleep(0.25)
    raise CliError("the live folder is not connected. Check your slot/network; "
                   "after a connector crash use --reset-link to end its old slot sessions "
                   "and reconnect. No snapshot fallback was used")


def cmd_live(args: argparse.Namespace) -> int:
    args.mode = args.mode or "bypassPermissions"
    validate_project_args(args)
    if args.remote_project:
        raise CliError("live folders belong to the computer serving them; use snapshot/project "
                       "commands to recover an older remote snapshot")
    device = choose_device(load_config(), args.slot)
    if args.check:
        answer = live_control(device, "0" * 32)
        if answer.get("ready") is not True:
            raise CliError("slot live-filesystem dependencies are not ready")
        print("Ready: live folder access with Claude running on the slot.\n"
              "No local folder was scanned, shared, or mounted; no model request was made.")
        return 0
    root = Path(args.project).expanduser().resolve(strict=not args.disconnect)
    if not args.disconnect and not root.is_dir():
        raise CliError("--project must be an existing directory")
    files, connector = live_files(), live_client()
    live_protected(root, files, connector)
    with project_lock():
        key, record = live_record(device, root)
        identifier = record["id"]
        if args.disconnect or args.reset_link:
            if args.reset_link:
                print("Reset ends this folder's running slot sessions and invalidates open files.")
                confirm_project("Reset this folder link?", args.yes)
            stop_local_connector(identifier)
            live_control(device, identifier, "stop")
            if args.disconnect:
                print("Folder access stopped; its slot sessions ended. "
                      "Local files were not deleted.")
                return 0
        ready = live_control(device, identifier)
        if ready.get("ready") is not True:
            raise CliError("live folder access is not ready on the slot")
        if record.get("trusted") is not True:
            print("Live folder: " + json.dumps(str(root), ensure_ascii=True))
            print("This grants the slot read/write access to files in this folder on demand.\n"
                  "Edits and deletions take effect locally immediately; there is no push/pull.\n"
                  "Hidden files and Git-ignored files are available too. Shared files may contain\n"
                  "credentials or identifying information; relevant content may reach Anthropic.\n"
                  "Slot administrators can inspect this access. CC Fleet's own keys and code\n"
                  "remain protected. Claude runs on the slot, using its Linux tools.\n"
                  "Access stays active after this terminal closes. Stop it with:\n"
                  "  ccfleet local --disconnect --project " + shlex.quote(str(root)))
            if args.mode == "bypassPermissions":
                print("Bypass-permissions mode lets tools change/delete files without prompts.")
            confirm_project("Trust this folder for live read/write access?", args.yes)
            record["trusted"] = True
            save_live_record(key, record)
        start_local_connector(identifier)
        deadline = time.monotonic() + 15
        while True:
            state = live_control(device, identifier)
            if state.get("mounted") is True and state.get("connected") is True:
                break
            if time.monotonic() >= deadline:
                raise CliError("folder mount did not become ready; no Claude session was started")
            time.sleep(0.25)
        session = args.name or record.get("last_session", "main")
        if args.resume is not None:
            available = state.get("sessions", [])
            if not isinstance(available, list) or any(
                    not isinstance(name, str) or not SESSION_RE.fullmatch(name)
                    for name in available):
                raise CliError("invalid live session listing")
            if args.resume:
                if args.resume not in available:
                    raise CliError("that live session is not running; use --new --name NAME")
                session = args.resume
            else:
                if not available:
                    raise CliError("no running live sessions; use --new --name NAME")
                for number, name in enumerate(available, 1):
                    print(f"{number}. {name}")
                if not sys.stdin.isatty():
                    raise CliError("choose a session explicitly with --resume NAME")
                choice = input("Session number: ").strip()
                if not choice.isdigit() or not 1 <= int(choice) <= len(available):
                    raise CliError("invalid session selection")
                session = available[int(choice) - 1]
        elif args.new_session and not args.name:
            session = "s-" + secrets.token_hex(4)
        if not isinstance(session, str) or not SESSION_RE.fullmatch(session):
            raise CliError("invalid saved live session")
        record["last_session"] = session
        save_live_record(key, record)
    print("Live folder connected. Files stay on this computer; Claude and tools run on the slot.\n"
          "Local edits are visible remotely and slot edits write through immediately.\n"
          "Closing this terminal leaves access active; use ccfleet local --disconnect to stop.",
          file=sys.stderr)
    action = "new" if args.new_session else "open"
    failed_since: Optional[float] = None
    attempt = 0
    while True:
        command = [*ssh_transport_command(device, tty=True), "ccfleet-live-session-v1",
                   identifier, action, session, args.mode,
                   args.model or "opus", args.effort or "max"]
        started = time.monotonic()
        code = subprocess.call(command, env=project_environment())
        if code != 255 or args.no_reconnect:
            return code
        now = time.monotonic()
        if failed_since is None or now - started >= 60:
            failed_since, attempt = now, 0
        if now - failed_since >= args.reconnect_for:
            return code
        print("Connection interrupted; reattaching to the same live session...", file=sys.stderr)
        time.sleep(min(10, 1 + attempt * 2, args.reconnect_for - (now - failed_since)))
        action, attempt = "open", attempt + 1


def find_local_claude() -> str:
    candidate = shutil.which("claude")
    if candidate is None:
        fallback = Path.home() / ".local/bin/claude"
        if fallback.is_file() and os.access(fallback, os.X_OK):
            candidate = str(fallback)
    if candidate is None:
        raise CliError("original local Claude Code is missing; rerun the --setup installer")
    return candidate


def inference_command(device: dict[str, Any]) -> list[str]:
    return [*ssh_transport_command(device, tty=False), "ccfleet-inference-v1"]


def check_inference(device: dict[str, Any], *, timeout: float = 25) -> None:
    helper = inference_client()
    try:
        answer = helper.check_status(lambda: inference_command(device), project_environment,
                                     timeout=timeout)
    except helper.RelayError as exc:
        messages = {401: "your slot's Claude sign-in needs renewal; use your slot page",
                    403: "the local Claude relay is not enabled on your slot",
                    409: "slot account transition is pending; retry after it completes"}
        raise CliError(messages.get(exc.status, "could not reach the slot relay; "
                                    "check your connection and pairing"), exc.status,
                       code="connection" if exc.status is None else "relay") from exc
    if (answer.get("ready") is not True or type(answer.get("protocol")) is not int
            or answer["protocol"] != 2):
        raise CliError("the slot relay uses an unsupported protocol")


def confirm_legacy_retirement(yes: bool) -> None:
    if yes:
        return
    message = ("Switching to local Claude ends this computer's old live-folder connections "
               "and their remote Claude sessions. Files and conversation history are kept; "
               "ordinary remote-terminal sessions are not stopped. Continue? [y/N] ")
    try:
        # curl|bash occupies stdin. Read only an actual controlling terminal.
        # Buffered r+ text files require seek(), which a terminal does not
        # support. Use the raw read/write TTY without consuming installer stdin.
        with open("/dev/tty", "r+b", buffering=0) as terminal:
            if not terminal.isatty():
                raise OSError("not a terminal")
            terminal.write(message.encode("utf-8"))
            answer = terminal.readline(64).strip().lower()
    except OSError as exc:
        raise CliError("old live-folder access is still active; finish it and run "
                       "ccfleet local --disconnect, or explicitly pass --yes to migrate") from exc
    if answer not in (b"y", b"yes"):
        raise CliError("migration cancelled; existing sessions and files were left unchanged")


def retire_live_grants(device: dict[str, Any], *, yes: bool) -> None:
    with project_lock():
        records = load_config().get("live_folders", {})
        if not isinstance(records, dict):
            raise CliError("invalid saved legacy folder configuration")
        matching = [(key, item) for key, item in records.items() if isinstance(item, dict)
                    and item.get("device") == device["device_id"]
                    and item.get("retired") is not True]
        if not matching:
            return
        print("Checking previous live-folder connections before migration...",
              file=sys.stderr, flush=True)
        active = False
        for _key, record in matching:
            identifier = record.get("id")
            if not isinstance(identifier, str) or not PROJECT_RE.fullmatch(identifier):
                raise CliError("invalid saved legacy workspace; no new Claude session was started")
            local = live_client().control(live_directory(identifier), "status")
            remote = live_control(device, identifier)
            if local or remote.get("mounted") or remote.get("connected") or remote.get("sessions"):
                active = True
        if active:
            confirm_legacy_retirement(yes)
        # Do not silently leave a second, broader filesystem access path running.
        for key, record in matching:
            identifier = record["id"]
            stop_local_connector(identifier)
            answer = live_control(device, identifier, "stop")
            if answer.get("stopped") is not True:
                raise CliError("legacy folder cleanup is incomplete; no local Claude was started")
            after = live_control(device, identifier)
            if (live_client().control(live_directory(identifier), "status")
                    or after.get("mounted") or after.get("connected") or after.get("sessions")):
                raise CliError("legacy folder access is still active; migration stopped safely")
            config = load_config()
            saved = config.get("live_folders", {}).get(key)
            if not isinstance(saved, dict) or saved.get("id") != identifier:
                raise CliError("legacy folder configuration changed during migration")
            saved["retired"] = True
            save_config(config)
    print("Old live-folder access stopped. Local files and histories were preserved.",
          file=sys.stderr, flush=True)


def native_extra_args(args: argparse.Namespace) -> list[str]:
    extra = list(getattr(args, "claude_args", []))
    if extra[:1] == ["--"]:
        extra.pop(0)
    forbidden = {"--cloud", "--teleport", "--remote-control", "--environment",
                 "--client-data-url", "--settings"}
    for value in extra:
        if value == "--":
            break
        if value.split("=", 1)[0] in {"--bg", "--background"}:
            raise CliError("native background agents outlive this command's relay; "
                           "use a foreground session or a separate local terminal")
        if value.split("=", 1)[0] in forbidden:
            raise CliError("this native option replaces CC Fleet's selected-slot route; "
                           "use ordinary Claude directly for a separate service/configuration")
    return extra


def native_settings(env: dict[str, str], base_url: str, secret: str, *,
                    bare: bool) -> dict[str, Any]:
    # Process environment alone loses to saved settings.env in native Claude.
    # The last explicit settings file pins only routing/privacy, leaving tools,
    # permissions, project customizations and native history under user control.
    pinned = {"ANTHROPIC_BASE_URL": base_url,
              "ANTHROPIC_AUTH_TOKEN": "" if bare else secret,
              "ANTHROPIC_API_KEY": secret if bare else "",
              "CLAUDE_CODE_OAUTH_TOKEN": "", "ANTHROPIC_CUSTOM_HEADERS": "",
              "CLAUDE_CODE_USE_BEDROCK": "0", "CLAUDE_CODE_USE_VERTEX": "0",
              "CLAUDE_CODE_USE_FOUNDRY": "0", "CLAUDE_CODE_USE_ANTHROPIC_AWS": "0",
              "CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD": "0", "CLAUDE_CODE_USE_MANTLE": "0",
              "CLAUDE_CODE_USE_GATEWAY": "0", "CLAUDE_CODE_CLIENT_DATA_URL": "",
              "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
              "DISABLE_TELEMETRY": "1", "DISABLE_ERROR_REPORTING": "1",
              "DISABLE_BUG_COMMAND": "1", "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
              "DISABLE_AUTOUPDATER": "1"}
    env.update(pinned)
    for key in ("ANTHROPIC_MODEL", "CLAUDE_CODE_EFFORT_LEVEL"):
        env.pop(key, None)
    fallback = env.get("no_proxy") or env.get("NO_PROXY", "")
    for name in ("NO_PROXY", "no_proxy"):
        items = [part.strip() for part in (env.get(name) or fallback).split(",") if part.strip()]
        env[name] = ",".join(dict.fromkeys([*items, "127.0.0.1", "localhost"]))
        pinned[name] = env[name]
    return {"env": pinned, "apiKeyHelper": ""}


def native_proxy_exclusions(env: dict[str, str], project: Path, extra: list[str]) -> None:
    """Retain native settings.env proxy exclusions before pinning loopback bypass."""
    sources = {"user", "project", "local"}
    extra = extra[:extra.index("--")] if "--" in extra else extra
    if "--bare" in extra:
        sources = set()
    for index, value in enumerate(extra):
        if value == "--":
            break
        if value == "--setting-sources" and index + 1 < len(extra):
            sources = set(extra[index + 1].split(","))
        elif value.startswith("--setting-sources="):
            sources = set(value.split("=", 1)[1].split(","))
    config = Path(env.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser()
    if not config.is_absolute():
        config = project / config
    files = (("user", config / "settings.json"),
             ("project", project / ".claude/settings.json"),
             ("local", project / ".claude/settings.local.json"))
    for source, path in files:
        if source not in sources:
            continue
        try:
            descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except FileNotFoundError:
            continue
        try:
            with os.fdopen(descriptor, "rb") as stream:
                if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                    raise ValueError("nonregular settings")
                raw = stream.read(1024 * 1024 + 1)
            if len(raw) > 1024 * 1024:
                raise ValueError("oversized settings")
            value = json.loads(raw)
            overrides = value.get("env", {})
            if not isinstance(overrides, dict):
                raise ValueError("invalid settings")
            for name in ("NO_PROXY", "no_proxy"):
                if name in overrides:
                    if not isinstance(overrides[name], str) or "\0" in overrides[name]:
                        raise ValueError("invalid proxy exclusion")
                    env[name] = overrides[name]
        except (OSError, ValueError, AttributeError) as exc:
            raise CliError("could not safely preserve native proxy exclusions; "
                           "check your Claude settings files") from exc


def check_managed_route(paths: Optional[list[Path]] = None) -> None:
    if os.environ.get("CLAUDE_CODE_CLIENT_DATA_URL"):
        raise CliError("a managed client configuration selects another route; "
                       "ask its administrator before using CC Fleet")
    if paths is None:
        paths = ([Path("/Library/Application Support/ClaudeCode/managed-settings.json")]
                 if sys.platform == "darwin" else [Path("/etc/claude-code/managed-settings.json")])
        dropins = paths[0].parent / "managed-settings.d"
        if dropins.exists():
            if dropins.is_symlink() or not dropins.is_dir():
                raise CliError("managed Claude settings cannot be safely verified")
            entries = list(dropins.iterdir())
            if len(entries) > 100:
                raise CliError("too many managed policy files to safely verify")
            paths.extend(sorted(path for path in entries if path.suffix == ".json"))
        if sys.platform == "darwin":
            import pwd
            preferences = Path("/Library/Managed Preferences")
            user = pwd.getpwuid(os.getuid()).pw_name
            for folder in (preferences, preferences / user):
                if (folder / "com.anthropic.claudecode.plist").exists():
                    raise CliError("managed macOS Claude preferences need administrator "
                                   "routing review before using CC Fleet")
    reserved = {"ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_API_KEY",
                "CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_CODE_CLIENT_DATA_URL",
                "ANTHROPIC_CUSTOM_HEADERS",
                "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "http_proxy", "https_proxy",
                "all_proxy", "NO_PROXY", "no_proxy"}
    for path in paths:
        if not path.exists():
            continue
        try:
            descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(descriptor, "rb") as stream:
                if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                    raise ValueError("nonregular policy")
                raw = stream.read(1024 * 1024 + 1)
            if len(raw) > 1024 * 1024:
                raise ValueError("oversized policy")
            value = json.loads(raw)
            settings_env = value.get("env", {})
            if not isinstance(settings_env, dict):
                raise ValueError("invalid policy")
            if (value.get("apiKeyHelper") or reserved.intersection(settings_env)
                    or any(key.startswith("CLAUDE_CODE_USE_") and value not in ("0", "", False)
                           for key, value in settings_env.items())):
                raise CliError("managed Claude settings select authentication/routing; "
                               "CC Fleet will not override that policy")
        except (OSError, ValueError, AttributeError) as exc:
            raise CliError("could not safely verify managed Claude routing settings") from exc


def local_claude_command(claude: str, args: argparse.Namespace,
                         settings_path: Path, extra: list[str]) -> list[str]:
    options = extra[:extra.index("--")] if "--" in extra else extra
    supplied = {value.split("=", 1)[0] for value in options}
    resuming = (args.resume is not None or args.continue_session
                or bool(supplied.intersection({"--resume", "-r", "--continue", "-c"})))
    command = [claude]
    for flag, value, default in (("--model", args.model, "opus"),
                                 ("--effort", args.effort, "max")):
        if flag not in supplied and (value is not None or not resuming):
            command.extend([flag, value if value is not None else default])
    if not supplied.intersection({"--permission-mode", "--dangerously-skip-permissions"}):
        mode = args.mode or "bypassPermissions"
        command.extend(["--dangerously-skip-permissions"] if mode == "bypassPermissions"
                       else ["--permission-mode", mode])
    if args.resume is not None:
        command.append("--resume=" + args.resume if args.resume else "--resume")
    elif args.continue_session:
        command.append("--continue")
    if args.fork_session:
        command.append("--fork-session")
    if args.name:
        command.append("--name=" + args.name)
    split = extra.index("--") if "--" in extra else len(extra)
    command += extra[:split] + ["--settings", str(settings_path)] + extra[split:]
    if args.print_prompt is not None:
        command.extend(["--print", "--", args.print_prompt])
    return command


def cmd_local(args: argparse.Namespace) -> int:
    if args.disconnect:
        return cmd_live(args)
    if args.reset_link or args.remote_project:
        raise CliError("live mounts are retired; use --disconnect to close old access, "
                       "then run ccfleet local for the local Claude CLI")
    if args.fork_session and args.resume is None and not args.continue_session:
        raise CliError("--fork-session needs --resume or --continue")
    for label, value in (("session name", args.name), ("resume value", args.resume)):
        if value is not None and (len(value) > 256 or any(
                ord(c) < 32 or ord(c) == 127 for c in value)):
            raise CliError(f"{label} must be at most 256 characters without control characters")
    if args.model is not None and not MODEL_RE.fullmatch(args.model):
        raise CliError("invalid model name")
    extra = native_extra_args(args)
    options = extra[:extra.index("--")] if "--" in extra else extra
    if args.print_prompt is not None and "--" in extra:
        raise CliError("use --print or a native positional prompt, not both")
    claude = find_local_claude()
    check_managed_route()
    device = choose_device(load_config(), args.slot)
    print("Checking the assigned slot's model relay...", file=sys.stderr, flush=True)
    check_inference(device)
    if args.check:
        print("Ready: original local Claude Code and assigned-slot inference relay.\n"
              "No project was scanned and no model request or Claude session was started.")
        return 0
    project = Path(args.project).expanduser().resolve(strict=True)
    if not project.is_dir():
        raise CliError("--project must be an existing local directory")
    retire_live_grants(device, yes=args.yes)
    helper = inference_client()
    bridge = helper.Bridge(lambda: inference_command(device), project_environment)
    descriptor = -1
    settings_path = None
    try:
        ensure_home()
        descriptor, filename = tempfile.mkstemp(
            prefix=".inference-settings-", suffix=".json", dir=home())
        settings_path = Path(filename)
        env = dict(os.environ)
        if args.legacy_history:
            profile = home() / "local" / hashlib.sha256(device["slot_id"].encode()).hexdigest()[:16]
            if not profile.is_dir():
                raise CliError("no earlier local-preview history exists for this slot")
            env["CLAUDE_CONFIG_DIR"] = str(profile)
        native_proxy_exclusions(env, project, extra)
        settings = native_settings(env, bridge.base_url, bridge.secret, bare="--bare" in options)
        with os.fdopen(descriptor, "w") as stream:
            descriptor = -1
            os.fchmod(stream.fileno(), 0o600)
            json.dump(settings, stream)
        bridge.start()
        print("Starting original local Claude Code. Files, tools and history stay here.\n"
              "Model requests use your assigned slot. Native prompts/tool results can still\n"
              "contain local context; this is not an anonymity guarantee.",
              file=sys.stderr, flush=True)
        return subprocess.call(local_claude_command(claude, args, settings_path, extra),
                               cwd=project, env=env)
    finally:
        bridge.close()
        if descriptor != -1:
            os.close(descriptor)
        if settings_path is not None:
            settings_path.unlink(missing_ok=True)


def cmd_list(_args: argparse.Namespace) -> int:
    config = load_config()
    if not config["devices"]:
        print("No slots connected. Run ccfleet login.")
        return 0
    for device_id, device in config["devices"].items():
        active = "*" if device_id == config.get("active") else " "
        print(f"{active} {device['slot_name']} ({device['slot_id']})")
    return 0


def cmd_use(args: argparse.Namespace) -> int:
    config = load_config()
    device = choose_device(config, args.slot)
    config["active"] = device["device_id"]
    save_config(config)
    print(f"Using {device['slot_name']}.")
    return 0


def cmd_logout(args: argparse.Namespace) -> int:
    config = load_config()
    device = choose_device(config, args.slot)
    for record in config.get("live_folders", {}).values():
        if isinstance(record, dict) and record.get("device") == device["device_id"]:
            try:
                stop_local_connector(record["id"])
                live_control(device, record["id"], "stop")
            except (CliError, OSError, ValueError):
                print("Warning: a folder cleanup is pending; device revocation will still proceed.",
                      file=sys.stderr)
    try:
        api_json(device["server"] + "/api/cli/revoke", device["device_token"], {})
    except CliError as exc:
        if exc.status != 401 and not args.local_only:
            raise
        if exc.status != 401:
            print(f"Warning: server revocation failed: {exc}", file=sys.stderr)
    for key in ("key", "known_hosts"):
        try:
            Path(device[key]).unlink()
        except FileNotFoundError:
            pass
        except OSError as exc:
            raise CliError(f"could not remove local {key}: {exc}") from exc
    config["devices"].pop(device["device_id"], None)
    config["active"] = next(iter(config["devices"]), "")
    save_config(config)
    print(f"Disconnected {device['slot_name']} from this computer.")
    return 0


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="ccfleet",
                                   description="Open Claude Code on your ccfleet slot.")
    sub = root.add_subparsers(dest="command")
    login = sub.add_parser("login", help="pair this computer with a slot")
    login.add_argument("code", nargs="?", help=argparse.SUPPRESS)
    login.add_argument("--server", default=os.environ.get("CCFLEET_SERVER", DEFAULT_SERVER))
    login.add_argument("--name", default="", help="name shown in Connected devices")
    setup = sub.add_parser("setup", help="pair only if needed and verify slot readiness")
    setup.add_argument("--name", default="computer", help="label for a newly paired computer")
    setup.add_argument("--slot", default="", help="paired slot to check and use by default")
    setup.add_argument("--yes", action="store_true",
                       help="explicitly approve ending this computer's old live-folder sessions")
    setup.add_argument("--server", default=os.environ.get("CCFLEET_SERVER", DEFAULT_SERVER),
                       help="server used only when pairing a new computer")
    attach = sub.add_parser("attach", help="open the persistent Claude Code session")
    attach.add_argument("--slot", default="", help="slot id or name")
    attach.add_argument("--session", default="ccfleet", help="remote session name")
    attach.add_argument("--mode", choices=PERMISSION_MODES, default="bypassPermissions",
                        help="mode used only if the session must be created")
    attach.add_argument("--model", default="opus",
                        help="model used only if the session must be created (default: opus)")
    attach.add_argument("--effort", choices=EFFORT_LEVELS, default="max",
                        help="effort used only if the session must be created (default: max)")
    attach.add_argument("--no-reconnect", action="store_true")
    attach.add_argument("--reconnect-for", type=int, default=600, metavar="SECONDS")
    attach.set_defaults(action="open")
    new = sub.add_parser("new", help="start a new named Claude Code session")
    new.add_argument("session", help="letters, digits, underscore or hyphen; max 32")
    new.add_argument("--slot", default="", help="slot id or name")
    new.add_argument("--mode", choices=PERMISSION_MODES, default="bypassPermissions")
    new.add_argument("--model", default="opus", help="fable, opus, sonnet, or a model id")
    new.add_argument("--effort", choices=EFFORT_LEVELS, default="max")
    new.set_defaults(action="new", no_reconnect=True, reconnect_for=0)
    restart = sub.add_parser("restart", help="replace a session with chosen launch settings")
    restart.add_argument("--session", default="ccfleet", help="remote session name")
    restart.add_argument("--slot", default="", help="slot id or name")
    restart.add_argument("--mode", choices=PERMISSION_MODES, default="bypassPermissions")
    restart.add_argument("--model", default="opus", help="fable, opus, sonnet, or a model id")
    restart.add_argument("--effort", choices=EFFORT_LEVELS, default="max")
    restart.set_defaults(action="restart", no_reconnect=True, reconnect_for=0)
    local = sub.add_parser("local", aliases=["snapshot"],
                           help="run original local Claude Code through your assigned slot",
                           epilog="New: ccfleet local --new --name work | "
                           "Resume picker: ccfleet local --resume | "
                           "Check setup: ccfleet local --check")
    local.add_argument("--slot", default="", help="paired slot id or name")
    local.add_argument("--project", default=".", help="local project directory (default: current)")
    local.add_argument("--remote-project", default="", metavar="ID",
                       help="join an existing project ID after reviewing and pulling it")
    local.add_argument("--yes", action="store_true",
                       help="explicitly approve retiring old live-folder connections")
    local.add_argument("--disconnect", action="store_true",
                       help="stop retired live-folder access and its old remote sessions")
    local.add_argument("--reset-link", action="store_true", help=argparse.SUPPRESS)
    local.add_argument("--model", help="model for a new local conversation (default: opus)")
    local.add_argument("--effort", choices=EFFORT_LEVELS,
                       help="effort for a new local conversation (default: max)")
    local.add_argument("--mode", choices=PERMISSION_MODES,
                       help="native permissions (default: bypassPermissions; "
                            "legacy snapshot: manual)")
    local.add_argument("-p", "--print", dest="print_prompt", help="native print-mode prompt")
    local.add_argument("--name", default="", help="native local conversation name")
    local.add_argument("--fork-session", action="store_true",
                       help="fork a resumed local conversation")
    local.add_argument("--legacy-history", action="store_true",
                       help="use the earlier per-slot local-preview conversation history")
    local.add_argument("claude_args", nargs=argparse.REMAINDER,
                       help="additional native Claude options after --")
    local.add_argument("--check", action="store_true",
                       help="check readiness without sharing files or using a model")
    local.add_argument("--no-reconnect", action="store_true", help=argparse.SUPPRESS)
    local.add_argument("--reconnect-for", type=int, default=600, metavar="SECONDS",
                       help=argparse.SUPPRESS)
    history = local.add_mutually_exclusive_group()
    history.add_argument("--resume", nargs="?", const="", metavar="NAME",
                         help="resume a native local conversation, or show its picker")
    history.add_argument("--continue", dest="continue_session", action="store_true",
                         help="continue the latest native conversation in this folder")
    history.add_argument("--new", dest="new_session", action="store_true",
                         help="start a fresh native local conversation")
    project = sub.add_parser("project", help="review, upload, or apply selected project files")
    project.add_argument("project_action", choices=("status", "push", "diff", "pull", "list"))
    project.add_argument("--slot", default="", help="paired slot id or name")
    project.add_argument("--project", default=".", help="selected local project directory")
    project.add_argument("--remote-project", default="", metavar="ID",
                         help="existing project ID from ccfleet project list")
    project.add_argument("--yes", action="store_true", help="explicitly approve upload/apply")
    sub.add_parser("list", help="list slots connected on this computer")
    use = sub.add_parser("use", help="choose the default slot")
    use.add_argument("slot")
    logout = sub.add_parser("logout", help="revoke this computer and remove its local key")
    logout.add_argument("--slot", default="", help="slot id or name")
    logout.add_argument("--local-only", action="store_true", help=argparse.SUPPRESS)
    hidden = sub.add_parser("proxy", help=argparse.SUPPRESS)
    hidden.add_argument("--device", required=True)
    resident = sub.add_parser("live-serve", help=argparse.SUPPRESS)
    resident.add_argument("--project-id", required=True)
    return root


def main(argv: Optional[list[str]] = None) -> int:
    args = parser().parse_args(argv)
    try:
        if args.command in (None, "attach"):
            if args.command is None:
                args.slot, args.session, args.mode = "", "ccfleet", "bypassPermissions"
                args.model, args.effort = "opus", "max"
                args.action, args.no_reconnect, args.reconnect_for = "open", False, 600
            if not SESSION_RE.fullmatch(args.session):
                raise CliError("session names use 1-32 letters, digits, underscores or hyphens")
            if not MODEL_RE.fullmatch(args.model):
                raise CliError("model names use 1-64 letters, digits, dots, underscores or hyphens")
            return cmd_attach(args)
        if args.command in ("new", "restart"):
            if not SESSION_RE.fullmatch(args.session):
                raise CliError("session names use 1-32 letters, digits, underscores or hyphens")
            if not MODEL_RE.fullmatch(args.model):
                raise CliError("model names use 1-64 letters, digits, dots, underscores or hyphens")
            return cmd_attach(args)
        if args.command == "login":
            return cmd_login(args)
        if args.command == "setup":
            return cmd_setup(args)
        if args.command == "local":
            return cmd_local(args)
        if args.command == "snapshot":
            if args.disconnect or args.reset_link:
                raise CliError("live link controls are not snapshot operations")
            return cmd_snapshot(args)
        if args.command == "project":
            return cmd_project(args)
        if args.command == "list":
            return cmd_list(args)
        if args.command == "use":
            return cmd_use(args)
        if args.command == "logout":
            return cmd_logout(args)
        if args.command == "proxy":
            return proxy(choose_device(load_config(), args.device))
        if args.command == "live-serve":
            return cmd_live_serve(args)
        raise CliError("unknown command")
    except KeyboardInterrupt:
        return 130
    except (CliError, OSError, ValueError) as exc:
        print(f"ccfleet: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
