# Optional pass-through gateway: one per owner, one per account.
#
# Claude Code on the laptop keeps its own /login. Only ANTHROPIC_BASE_URL points
# here, so the saved claude.ai login stays the active credential and the gateway
# passes the owner's own request through: body and Anthropic's required headers
# unchanged, including their OAuth bearer. Being a reverse proxy it does set Host
# and Caddy adds the usual X-Forwarded-*, so "untouched" would be too strong; what
# it never does is substitute a credential or alter who the client says it is. The
# gateway is authenticated with a private header (never with ANTHROPIC_AUTH_TOKEN,
# which would replace the subscription as the credential).
#
# Laptop side:
#   export ANTHROPIC_BASE_URL=https://gw-a.example.com
#   export ANTHROPIC_CUSTOM_HEADERS="X-Gw-Key: <the same secret as GW_KEY_A>"
#
# Validated against a live Claude Code session on 2026-09-19: a real session
# completed through this handler, stopping the gateway made the same command fail
# with ECONNRESET and restarting it made it succeed again (so the gateway really
# was in the path), and neither ANTHROPIC_API_KEY nor ANTHROPIC_AUTH_TOKEN was
# set, so nothing overrode the subscription and the saved OAuth login is what
# authenticated. See gateway/README.md.

gw-a.example.com {
    @keyed header X-Gw-Key {env.GW_KEY_A}
    handle @keyed {
        reverse_proxy https://api.anthropic.com {
            header_up Host api.anthropic.com
            header_up -X-Gw-Key
            flush_interval -1
            transport http {
                tls_server_name api.anthropic.com
            }
        }
    }
    respond 401
    log {
        output file /var/log/caddy/gw-a.log
        format filter {
            wrap json
            fields {
                request>headers>Authorization delete
                request>headers>X-Gw-Key delete
                request>headers>Cookie delete
            }
        }
    }
}
