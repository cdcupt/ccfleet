# ccfleet tunnel settings. Keep this file 0600.
# Only needed when the fleet server has no public HTTPS endpoint; see docs/tunnel.md.

# SSH destination of the fleet server, using the restricted account you created there.
CCFLEET_TUNNEL_SSH=ccfleet-tunnel@fleet.example.com

# Port opened on THIS node's loopback. The agent's CCFLEET_URL points here.
CCFLEET_TUNNEL_LOCAL_PORT=8110

# Port ccfleetd listens on, on the server's loopback.
CCFLEET_TUNNEL_REMOTE_PORT=8110

# Private key for the restricted account. Keep it 0600 and use it for nothing else.
CCFLEET_TUNNEL_KEY=/home/CHANGEME/.ssh/ccfleet_tunnel

# Pinned host key of the fleet server. The tunnel refuses to connect to a server
# that does not match, so fill this from a fingerprint you verified out of band.
CCFLEET_TUNNEL_KNOWN_HOSTS=/home/CHANGEME/.config/ccfleet/tunnel_known_hosts
