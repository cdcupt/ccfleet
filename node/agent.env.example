# ccfleet agent configuration. Keep this file 0600; the token identifies this node.
# Values come from `ccfleetd node add <id> --owner <name>` on the fleet server.
CCFLEET_URL=https://fleet.example.com
CCFLEET_NODE_ID=node-a
CCFLEET_NODE_TOKEN=replace-with-the-64-hex-token-printed-by-ccfleetd

# Optional overrides
#CCFLEET_CLAUDE_CONFIG_DIR=~/.claude
#CCFLEET_RC_SERVICE=claude-remote-control.service
#CCFLEET_EGRESS_TARGETS=https://api.ipify.org,https://ifconfig.me/ip
#CCFLEET_TIMEOUT_S=10
