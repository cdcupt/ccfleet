[Unit]
Description=ccfleet heartbeat agent (one run)
After=network-online.target

[Service]
Type=oneshot
# This service runs `claude --version`, which is the very call that can trigger an
# auto-update. An update replaces ~/.local/bin/claude, and a probe landing in that
# window finds nothing and reports the node as broken. Every other unit already
# sets this; the one that actually invokes claude was the one missing it, and the
# project's whole upgrade policy is that the operator stages them.
Environment=DISABLE_AUTOUPDATER=1
# The quota read opens a Claude Code session and answers its folder-trust
# prompt. The agent pins that session's directory itself, and this makes the
# service agree rather than leaving it to whatever systemd happened to hand us.
WorkingDirectory=%h
EnvironmentFile=%h/.config/ccfleet/agent.env
ExecStart=%h/.local/bin/ccfleet-agent
NoNewPrivileges=yes
