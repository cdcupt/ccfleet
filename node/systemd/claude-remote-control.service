[Unit]
Description=Claude Code Remote Control (drive this node from claude.ai/code or the Claude app)
Documentation=https://code.claude.com/docs/en/remote-control
After=network-online.target

# Runs from the WORKSPACE, never the home directory. Claude Code refuses to serve
# Remote Control out of a home directory ("Workspace not trusted … home-directory
# trust is never saved"), so pointing this at %h fails on every start.
#
# The workspace must be trusted once, interactively, before this unit can work:
#   mkdir -p ~/workspace && cd ~/workspace && claude      -> accept the trust prompt
#   claude remote-control                                 -> accept the one-time y/n
# After those two answers this unit runs unattended forever.
[Service]
Type=forking
Environment=DISABLE_AUTOUPDATER=1
WorkingDirectory=%h/workspace
ExecStartPre=/bin/mkdir -p %h/workspace
ExecStart=/usr/bin/tmux new-session -d -s remote-control -c %h/workspace "%h/.local/bin/claude remote-control --name %H"
ExecStop=/usr/bin/tmux kill-session -t remote-control
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=default.target
