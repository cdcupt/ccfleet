[Unit]
Description=Claude Code Remote Control (drive this node from claude.ai/code or the Claude app)
Documentation=https://code.claude.com/docs/en/remote-control
After=network-online.target

# Runs from the WORKSPACE, never the home directory. Claude Code refuses to serve
# Remote Control out of a home directory ("Workspace not trusted … home-directory
# trust is never saved"), so pointing this at %h fails on every start.
#
# The workspace must be trusted once, interactively, before this unit can work:
#   mkdir -p ~/workspace && cd ~/workspace && claude      -> accept the trust prompt
#   claude remote-control                                 -> accept the one-time y/n
#
# To watch it, or read its URL and QR code, attach to its own server:
#   tmux -L ccfleet-rc attach -t remote-control
# After those two answers this unit runs unattended forever.
#
# Deliberately NOT --continue. The CLI's own help: "Exits with an error if nothing
# was recorded here within roughly the last 4 hours." A reboot after a quiet night
# is exactly that state, so with Restart=on-failure the unit would enter a restart
# loop and never serve. Starting a fresh session always works; the previous
# conversation is still reachable from claude.ai/code.
[Service]
Type=forking
Environment=DISABLE_AUTOUPDATER=1
# No WorkingDirectory=: systemd enters it before ExecStartPre runs, so a
# WorkingDirectory that does not exist yet fails the unit and the mkdir below
# could never repair it. tmux -c sets the session's directory instead, which is
# what actually matters here.
# -L ccfleet-rc puts this on its OWN tmux server, and that is load-bearing, not
# tidiness. tmux servers belong to whichever unit started them, and systemd's
# default KillMode=control-group kills every process in a unit's control group
# when it is stopped or restarted. Sharing the default server therefore meant a
# `systemctl restart claude-remote-control` destroyed the owner's work session
# too. Measured on a live node 2026-09-19: the server hosting the `cc` session
# was sitting in this unit's cgroup, and restarting this unit killed it.
#
# With a private socket this unit can only ever kill its own server.
#
# CCFLEET_RC_ARGS comes from the optional env file below and is normally empty.
# install.sh --bypass-permissions writes "--permission-mode bypassPermissions"
# into it. Passing it through a file avoids rewriting this command line, which is
# its own class of bug.
EnvironmentFile=-%h/.config/ccfleet/remote-control.env
ExecStartPre=/bin/mkdir -p %h/workspace
ExecStart=/usr/bin/tmux -L ccfleet-rc new-session -d -s remote-control -c %h/workspace "%h/.local/bin/claude remote-control ${CCFLEET_RC_ARGS} --name %H"
ExecStop=/usr/bin/tmux -L ccfleet-rc kill-server
# Restart=on-failure covers tmux itself failing to launch (missing binary, no
# server). It deliberately does NOT cover Claude failing to authenticate inside
# the session, and nothing here can: with Type=forking, ExecStart returns as soon
# as tmux detaches, so the inner exit status is never seen by systemd.
#
# Measured on a live node 2026-09-18 with a throwaway unit of this exact shape
# whose inner command was `exit 7`:
#     Result=success  ExecMainStatus=0  NRestarts=0  ActiveState=inactive
# The unit went inactive rather than failed, so Restart=on-failure did not fire.
#
# That is why node/install.sh enables this unit but does not start it: before the
# owner signs in there is no login for Remote Control to use, and the restart
# would not retry. The owner starts it once, by hand, after /login.
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=default.target
