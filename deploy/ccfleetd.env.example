# Copy to deploy/ccfleetd.env (0600). Required:
CCFLEET_ADMIN_TOKEN=replace-with-openssl-rand-hex-32
# Where the server listens. Loopback by default: put TLS in front of it rather
# than exposing this port. host:port.
#CCFLEET_BIND=127.0.0.1:8110
# SQLite file, relative to the working directory.
#CCFLEET_DB=data/ccfleet.db
# User name for the admin token over HTTP Basic. Any name works as the token is
# what is actually checked; this only changes what the browser prompt shows.
#CCFLEET_ADMIN_USER=admin
# Public URL shown in alerts (the address you put behind TLS):
CCFLEET_PUBLIC_URL=https://fleet.example.com
# Telegram alerts (optional): create a bot with @BotFather, get the chat id from @userinfobot
#CCFLEET_TELEGRAM_BOT_TOKEN=123456:abc
#CCFLEET_TELEGRAM_CHAT_ID=123456789
# Thresholds (optional, defaults shown)
#CCFLEET_HEARTBEAT_MAX_AGE_S=900
#CCFLEET_TOKEN_STALE_S=86400
#CCFLEET_TOKEN_EXPIRED_GRACE_S=3600
#CCFLEET_DISK_WARN_PCT=85
#CCFLEET_DISK_CRIT_PCT=95
# How full a Claude usage window may get before it is worth telling you.
# Applies to the 5-hour and the weekly window separately.
#CCFLEET_QUOTA_WARN_PCT=75
#CCFLEET_QUOTA_CRIT_PCT=90
#CCFLEET_CHECK_INTERVAL_S=60
#CCFLEET_RETENTION_DAYS=30
# Largest heartbeat body accepted, in bytes.
#CCFLEET_MAX_BODY_BYTES=65536
# Permission prompts on YOUR nodes (optional, default off).
# On: the install command the console prints carries --bypass-permissions, so new
# nodes run Claude Code with no permission prompts. The node owner also holds
# passwordless sudo, so with prompts off nothing stands between a tool call and
# root. Turn this on only for a fleet you own; leave it off otherwise.
#CCFLEET_BYPASS_BY_DEFAULT=0

# -- signing in with Google -------------------------------------------------
# Leave all three blank and the server runs as the operator-only console it has
# always been, offering no user sign-in. Setting some but not all is refused at
# startup: a sign-in button that fails on the callback reads as a broken product.
#
# Client id and secret come from a Google Cloud OAuth 2.0 Client (Web
# application). Register the callback below as an authorised redirect URI there
# — a mismatch fails with a message that says nothing useful.
CCFLEET_GOOGLE_CLIENT_ID=
CCFLEET_GOOGLE_CLIENT_SECRET=
# Defaults to CCFLEET_PUBLIC_URL + /auth/google/callback. Set it only if that
# is not the address Google should send people back to.
CCFLEET_GOOGLE_REDIRECT_URI=
# Signs the session cookie. Generate with: openssl rand -hex 32
# Changing it signs everybody out, which is the point if one ever leaks.
CCFLEET_COOKIE_SECRET=
# How long a session lasts without being renewed. Default 14 days.
CCFLEET_SESSION_TTL_S=1209600
# Only set this to false for local development over plain http, where a Secure
# cookie is dropped by the browser and sign-in appears to do nothing at all.
CCFLEET_COOKIE_SECURE=true

# -- two sites: the product, and the operator's console ------------------------
# Leave blank and one hostname serves both: the console at /admin, and the
# product everywhere else, where / takes each person to their own page (the
# console for an operator, their slots for a customer, /docs for anybody else).
# Set it to the operator's own hostname and the console and its API answer only
# there (and on loopback, the way in over the SSH tunnel), its / forwarding to
# /admin; every other hostname becomes only the product, where no console exists
# whatever credentials arrive.
#
# Operators then sign in with Google on this hostname too. Register its
# callback, https://<this host>/auth/google/callback, as a second authorised
# redirect URI on the same Google client, and make each operator's account an
# admin once they have signed in:  ccfleetd account role <email> admin
# The admin token keeps working beside that, as the way in when Google is down.
CCFLEET_ADMIN_HOST=

# Where people reach the operator, shown on the public /privacy page. Left
# blank, the page points to the support address on Google's sign-in screen
# instead, so no address is published unless you choose one here.
CCFLEET_CONTACT_EMAIL=
